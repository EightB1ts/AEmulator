# Don't run an implicit `pnpm install` before every `pnpm run <script>`. Tauri
# invokes `pnpm dev` / `pnpm build` as its before-dev/before-build hooks; the
# pre-run deps check treats esbuild's (already-satisfied) ignored build script as
# a fatal error and blocks the script. Deps are installed explicitly.
verify-deps-before-run=false
