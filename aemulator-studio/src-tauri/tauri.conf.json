{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "AEmulator Studio",
    "version": "0.1.0",
    "identifier": "com.avnir.aemulator-studio",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "pnpm build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "AEmulator Studio",
                "width": 1180,
                "height": 800,
                "minWidth": 900,
                "minHeight": 600,
                "titleBarStyle": "Overlay",
                "hiddenTitle": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": ["app", "dmg"],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "macOS": {
            "signingIdentity": "-",
            "minimumSystemVersion": "11.0"
        }
    }
}
