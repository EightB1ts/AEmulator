+# bytes a union occupies — counting sizes the buffer that reservedmarshal then writes into, so a
+# disagreement there is a heap overflow, not a mismatch.
+def iterateVulkanUnion(typeInfo: VulkanTypeInfo, cgen, structInfo, forEachType):
+    selector = typeInfo.getUnionSelector(structInfo.name)
+    arms = [m for m in structInfo.members if m.selections] if selector is not None else []
+
+    if not arms:
+        iterateVulkanType(typeInfo, structInfo.members[0], forEachType)
+        return
+
+    cgen.beginSwitch(selector[0])
+    for member in arms:
+        for value in member.selections:
+            cgen.line("case %s:" % value)
