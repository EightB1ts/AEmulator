+// exported symbol is checked by third_party/bootstrap.sh's nm assertion and by ci/hvf-doctor.sh's
+// imported-vs-exported symbol diff, so a mismatch fails at doctor time rather than at address 0
+// halfway through a guest boot.
+VG_EXPORT int stream_renderer_set_gpu_identity(
+    const struct stream_renderer_gpu_identity* identity) {
+    if (!identity) {
+        stream_renderer_error("stream_renderer_set_gpu_identity: NULL identity");
+        return -1;
+    }
+    if (identity->struct_size != sizeof(struct stream_renderer_gpu_identity)) {
+        // ABI drift, not a bad value: the caller was built against a different version of the
+        // header. Refuse rather than reinterpret a struct at the wrong offsets — the failure mode of
