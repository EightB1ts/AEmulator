+// Avnir in-Vulkan present (Apache-2.0). Release the surface/swapchain this renderer cached for
+// `ca_metal_layer` in stream_renderer_present_to_metal_layer(), without disturbing any other layer.
+//
+// stream_renderer_teardown() below already frees every presenter, but only at renderer shutdown. A
+// VMM window can close long before that, and the CAMetalLayer is owned by the window's NSView: once
+// the window is gone the cached VkSurfaceKHR names freed memory, and destroying it at teardown time
+// is a use-after-free. Call this while the layer is still alive and the renderer is still running.
+// Idempotent; safe with a layer that was never presented to, and safe from any thread.
+VG_EXPORT void stream_renderer_release_metal_layer(void* ca_metal_layer) {
+#if defined(__APPLE__)
+    gfxstream::vk::releaseMetalLayerPresenter(ca_metal_layer);
+#else
+    (void)ca_metal_layer;
+#endif
