+
+// Return codes for presentColorBufferToMetalLayer(). Mirrored verbatim by
+// stream_renderer_present_to_metal_layer() and by the VMM's Renderer3d::present_to_layer().
+enum : int {
+    kMetalPresentOk = 0,           // presented
+    kMetalPresentDropped = 1,      // no image available in time / swapchain being recreated
+    kMetalPresentNoLayer = -1,     // ca_metal_layer was null
+    kMetalPresentNoEmulation = -2, // no live VkEmulation
+    kMetalPresentNoColorBuffer = -3,  // unknown handle, or the ColorBuffer has no VkImage
+    kMetalPresentNoExtension = -4, // VK_EXT_metal_surface / VK_KHR_swapchain entrypoints missing
+    kMetalPresentNoSurface = -5,   // vkCreateMetalSurfaceEXT failed
+    kMetalPresentNoSwapchain = -6, // swapchain creation / negotiation failed
+    kMetalPresentNoPresentQueue = -7,  // the emulation queue family cannot present to this surface
+    kMetalPresentDeviceError = -8, // acquire/submit/present returned a hard Vulkan error
+    kMetalPresentUnblittable = -9, // the ColorBuffer format cannot be a vkCmdBlitImage source
+};
+
+// Present ColorBuffer `colorBufferHandle` into `caMetalLayer` (an unretained CAMetalLayer*).
+// See stream_renderer_present_to_metal_layer() for the full contract. Thread-safe.
+int presentColorBufferToMetalLayer(uint32_t colorBufferHandle, void* caMetalLayer);
+
+// Destroy every cached surface/swapchain. Must be called while the VkDevice is still alive.
+void teardownMetalLayerPresenters();
+
+// Destroy the cached surface/swapchain for `caMetalLayer` only, leaving other layers untouched.
+// No-op for a null pointer or a layer that was never presented to. Must be called while the
+// VkDevice is still alive, and before the CAMetalLayer itself is released. Thread-safe.
+// See stream_renderer_release_metal_layer() for the full contract.
+void releaseMetalLayerPresenter(void* caMetalLayer);
+
+}  // namespace vk
+}  // namespace gfxstream
