+    applied.vendorId = identity->vendor_id;
+    applied.deviceId = identity->device_id;
+    applied.flags = identity->flags;
+    applied.maxViewports = identity->max_viewports;
+    applied.subgroupSize = identity->subgroup_size;
+    static_assert(sizeof(applied.deviceName) == sizeof(identity->device_name),
+                  "stream_renderer_gpu_identity::device_name must be "
+                  "VK_MAX_PHYSICAL_DEVICE_NAME_SIZE");
+    static_assert(sizeof(applied.pipelineCacheUuid) == sizeof(identity->pipeline_cache_uuid),
+                  "stream_renderer_gpu_identity::pipeline_cache_uuid must be VK_UUID_SIZE");
+    memcpy(applied.deviceName, identity->device_name, sizeof(applied.deviceName));
+    applied.deviceName[sizeof(applied.deviceName) - 1] = '\0';
+    memcpy(applied.pipelineCacheUuid, identity->pipeline_cache_uuid,
+           sizeof(applied.pipelineCacheUuid));
+
+    static_assert(gfxstream::vk::VkDecoderGlobalState::kGpuIdentityClampMobileFeatures ==
+                      STREAM_RENDERER_GPU_IDENTITY_CLAMP_MOBILE_FEATURES,
+                  "flag bit0 must mean the same thing on both sides of this ABI");
+    static_assert(gfxstream::vk::VkDecoderGlobalState::kGpuIdentityStripPlatformExts ==
+                      STREAM_RENDERER_GPU_IDENTITY_STRIP_PLATFORM_EXTS,
+                  "flag bit1 must mean the same thing on both sides of this ABI");
+
+    gfxstream::vk::VkDecoderGlobalState::setGpuIdentity(applied);
+    return 0;
+}
