+// AEmulator: release ONE layer's cached surface/swapchain, leaving every other layer's presenter
+// live. teardownMetalLayerPresenters() above is all-or-nothing and is only correct at shutdown;
+// this is what a VMM window closing needs, because the CAMetalLayer dies with its NSView while the
+// renderer (and the VkDevice the VkSurfaceKHR/VkSwapchainKHR hang off) is still running. Destroying
+// the presenter here — under presentersMutex(), so never concurrently with a present into the same
+// layer — is the only point at which the surface can be destroyed both AFTER the last present and
+// BEFORE the CAMetalLayer is freed.
+void releaseMetalLayerPresenter(void* caMetalLayer) {
+    if (caMetalLayer == nullptr) return;
+    std::lock_guard<std::mutex> guard(presentersMutex());
+    presenters().erase(caMetalLayer);
