     VK_CHECK(vk.vkCreateWin32SurfaceKHR(instance, &surfaceCi, nullptr, &surface));
+#elif defined(__APPLE__)
+    // On macOS `window` is a CAMetalLayer* (FBNativeWindowType is void* here). In a non-Objective-C
+    // translation unit vulkan_metal.h typedefs CAMetalLayer to void, so pLayer is just const void*.
+    if (!vk.vkCreateMetalSurfaceEXT) {
+        ERR("VK_EXT_metal_surface is not available; cannot create a VkSurfaceKHR.");
+        return nullptr;
+    }
+    const VkMetalSurfaceCreateInfoEXT surfaceCi = {
+        .sType = VK_STRUCTURE_TYPE_METAL_SURFACE_CREATE_INFO_EXT,
+        .pNext = nullptr,
+        .flags = 0,
+        .pLayer = reinterpret_cast<const CAMetalLayer*>(window),
+    };
+    const VkResult res = vk.vkCreateMetalSurfaceEXT(instance, &surfaceCi, nullptr, &surface);
+    if (res != VK_SUCCESS) {
+        ERR("vkCreateMetalSurfaceEXT failed: %d", static_cast<int>(res));
+        return nullptr;
+    }
 #else
     GFXSTREAM_ABORT(FatalError(ABORT_REASON_OTHER))
         << "Unimplemented.";
 #endif
     if (surface == VK_NULL_HANDLE) {
+#if defined(__APPLE__)
+        ERR("No VkSurfaceKHR created for the CAMetalLayer.");
+        return nullptr;
+#else
         GFXSTREAM_ABORT(FatalError(ABORT_REASON_OTHER))
             << "No VkSurfaceKHR created?";
+#endif
     }
 
     return std::unique_ptr<DisplaySurfaceVk>(new DisplaySurfaceVk(vk, instance, surface));
