+// Device extensions that MUST NOT be advertised to the guest — DERIVED, not hand-curated.
+//
+// Each name in the generated list below owns at least one VkStructureType that this build's cereal
+// codegen lists in goldfish_vk_extension_struct_size (524 types) but does NOT handle in
+// reservedunmarshal_extension_struct (195 types). A guest that enables the extension and chains the
+// struct hits reservedunmarshal's default case and abort()s the whole VMM. Filtering the extension
+// out of vkEnumerateDeviceExtensionProperties means the guest never enables it, so the struct is
+// never put on the wire. No wire-format guessing is involved — see the .inc header for why
+// softening the abort() into a skip is strictly worse than aborting.
+//
+// POLARITY IS INVERTED ON PURPOSE. This used to be a hand-written nine-name array, which was a
+// subset of a 166-extension problem: the same analysis that predicted VK_EXT_memory_budget (the
+// empirically confirmed member — it was aborting the VMM) predicts 165 more, and
+// VK_EXT_extended_dynamic_state3 is one of them, on a host that advertises it and a guest ANGLE
+// that enables it when present. So the strip list is now GENERATED from the pinned tree's own
+// codegen and the exceptions are enumerated instead, each with a reason. Adding a host extension
+// can no longer silently add an abort; it can only add an entry to a list somebody has to justify.
+//
+// Regenerate with `aemu-cereal-gap generate`; ci/hvf-doctor.sh runs `aemu-cereal-gap verify` so a
+// gfxstream pin bump that moves the codegen fails at doctor time, not at abort() time mid-boot.
+//
+// This is deliberately NOT #if defined(__APPLE__): the codegen gap is a property of this host
+// build, not of macOS.
+#include "VkDecoderCerealGap.inc"
+
+// Extensions that are in the generated gap but are advertised to the guest ANYWAY.
+//
+// SEEDED TO EXACTLY THE PRE-EXISTING BEHAVIOUR: these are the ten names the hand-written list
+// deliberately omitted. MoltenVK exposed all ten and none of them was ever observed to abort, so
+// stripping them would delete real capability for a hazard that has not materialised. Every entry
+// is a bet that the guest never chains the struct — the same bet the old comment made implicitly,
+// now written down per name and revocable per name.
+//
+// SHRINKING THIS LIST IS A SEPARATE, PER-ENTRY, BOOT-VERIFIED EXERCISE. Do not bulk-delete: each
+// removal is a capability change, and the only evidence that matters is a boot with the entry gone.
+// Conversely, do not ADD to it without an equally concrete reason — an addition re-arms an abort().
+// The shared evidence for all ten, stated once so no entry has to pretend to a better reason than
+// it has: every one of them was advertised to the guest for the entire working MoltenVK-era boot and
+// none was ever observed to reach reservedunmarshal's default arm. The per-entry note below says
+// only WHAT would be lost, which is the part that differs.
+static constexpr const char* const kCerealGapExtensionsKeptAnyway[] = {
+    // GPU-visible buffer addresses. The largest capability of the ten and the likeliest to be
+    // requested by a modern guest driver, so it should be the LAST entry ever removed.
+    "VK_EXT_buffer_device_address",
+    // Depth-clip enable as pipeline state independent of depth clamp.
+    "VK_EXT_depth_clip_control",
+    // Creating a 2D image view of a single slice of a 3D image.
+    "VK_EXT_image_2d_view_of_3d",
+    // Opt-in robust-access levels chosen per pipeline instead of per device.
+    "VK_EXT_pipeline_robustness",
+    // Programmable multisample sample locations.
+    "VK_EXT_sample_locations",
+    // Atomic operations on floats in shaders.
+    "VK_EXT_shader_atomic_float",
+    // The frame-pacing pair: the guest tags a present with an id and later waits on that id.
+    // Keep or drop them TOGETHER — present_wait waits on a present_id, so half of this pair is a
+    // capability nothing can use.
+    "VK_KHR_present_id",
+    "VK_KHR_present_wait",
+    // Pushing descriptors inline instead of allocating a descriptor set.
+    "VK_KHR_push_descriptor",
+    // The subgroup-uniform-control-flow shader capability.
+    "VK_KHR_shader_subgroup_uniform_control_flow",
+};
+
+// True when `name` must be hidden from the guest: in the generated gap AND not in the allowlist.
+static bool cerealGapHidesExtension(const char* name) {
+    for (const char* kept : kCerealGapExtensionsKeptAnyway) {
+        if (strcmp(name, kept) == 0) return false;
+    }
+    for (const char* hidden : aemu_cereal_gap::kCerealGapExtensions) {
+        if (strcmp(name, hidden) == 0) return true;
+    }
+    return false;
+}
+
+// Escape hatch for A/B bisecting a graphics failure against the strip itself: with
+// AEMU_GFXSTREAM_NO_EXT_STRIP=1 the guest sees the host's device extension list unfiltered, which
+// re-arms every abort() in the gap. Debug only — never a supported configuration.
+static bool cerealGapStripDisabled() {
+    static const bool disabled =
+        android::base::getEnvironmentVariable("AEMU_GFXSTREAM_NO_EXT_STRIP") == "1";
+    return disabled;
+}
