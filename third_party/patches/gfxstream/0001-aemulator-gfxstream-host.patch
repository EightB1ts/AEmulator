+#if defined(__APPLE__)
+        // AEmulator: on macOS the "host GPU Vulkan" backend is Mesa KosmicKrisp (Metal); there is
+        // no native Vulkan ICD. Upstream blanks ANDROID_EMU_VK_ICD here, which would make
