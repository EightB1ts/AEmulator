+//    0  presented.
+//    1  frame intentionally dropped (no swapchain image became available in time, or the swapchain
+//       is being recreated). The present path is healthy; the caller should NOT fall back.
+//   <0  hard failure (no Vulkan emulation, unknown ColorBuffer, VK_EXT_metal_surface unavailable,
+//       surface/swapchain creation failed, format cannot be blitted). The caller should fall back
+//       to the CPU readback present path.
+VG_EXPORT int stream_renderer_present_to_metal_layer(uint32_t res_handle, void* ca_metal_layer);
+
 VG_EXPORT void stream_renderer_flush(uint32_t res_handle);
 
