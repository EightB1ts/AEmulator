+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+// Avnir in-Vulkan present (Apache-2.0).
+//
+// Presents a gfxstream scanout ColorBuffer straight into a host CAMetalLayer using nothing but core
+// Vulkan plus VK_EXT_metal_surface and VK_KHR_swapchain:
+//
+//     vkCreateMetalSurfaceEXT(CAMetalLayer*)         -> VkSurfaceKHR
+//     SwapChainStateVk                               -> VK_KHR_swapchain (B8G8R8A8_UNORM, FIFO)
+//     vkCmdBlitImage(ColorBuffer -> swapchain image)
+//     vkQueuePresentKHR
+//
+// This supersedes the MoltenVK-only VK_EXT_metal_objects export (getColorBufferMetalTexture +
+// the VMM's aemu_metal_present_texture). That path cannot exist on LunarG KosmicKrisp: it does not
+// implement VK_EXT_metal_objects at all, and its VK_EXT_external_memory_metal exports only
+// VK_EXTERNAL_MEMORY_HANDLE_TYPE_MTLHEAP_BIT_EXT, so there is no way to obtain an id<MTLTexture> for
+// a ColorBuffer. Nothing below is driver-specific, so it runs unchanged on MoltenVK.
+//
+// vkCmdBlitImage rather than vkCmdCopyImage is deliberate: the ColorBuffer is typically
+// R8G8B8A8_UNORM at the guest resolution while the swapchain is B8G8R8A8_UNORM at the window's
+// physical resolution. Blit performs the channel reorder AND the scale in one command; copy
+// requires identical formats and identical extents.
+
+#include "MetalLayerPresenterVk.h"
+
+#if defined(__APPLE__)
+
+#include <vulkan/vk_enum_string_helper.h>
+
+#include <memory>
+#include <mutex>
+#include <unordered_map>
+#include <vector>
+
+#include "DisplaySurfaceVk.h"
+#include "SwapChainStateVk.h"
+#include "VkCommonOperations.h"
+#include "aemu/base/synchronization/Lock.h"
+#include "host-common/logging.h"
+#include "vk_util.h"
+
+// logging.h has no once-only variant; DisplayVk.cpp defines its own the same way.
+#define PRESENTER_ERR_ONCE(fmt, ...)                    \
+    do {                                                \
+        static bool presenterVkInternalLogged = false;  \
+        if (!presenterVkInternalLogged) {               \
+            ERR(fmt, ##__VA_ARGS__);                    \
+            presenterVkInternalLogged = true;           \
+        }                                               \
+    } while (0)
+
+namespace gfxstream {
+namespace vk {
+namespace {
+
+// vkAcquireNextImageKHR budget. FIFO backpressure is desirable in principle (it throttles a guest
+// rendering faster than the display), but this runs on the vCPU thread inside
+// VIRTIO_GPU_CMD_RESOURCE_FLUSH, so an unbounded wait would stall the guest behind a stuck
+// compositor. On VK_TIMEOUT we drop the frame (kMetalPresentDropped) — the swapchain is healthy, so
+// falling back to a CPU readback would be strictly worse.
+constexpr uint64_t kAcquireTimeoutNs = 100ULL * 1000ULL * 1000ULL;        // 100 ms
+constexpr uint64_t kFenceTimeoutNs = 5ULL * 1000ULL * 1000ULL * 1000ULL;  // 5 s
+
+VkFormatFeatureFlags formatFeaturesOf(VkEmulation* emu, VkFormat format, VkImageTiling tiling) {
+    VkFormatProperties props = {};
+    emu->ivk->vkGetPhysicalDeviceFormatProperties(emu->physdev, format, &props);
+    return tiling == VK_IMAGE_TILING_LINEAR ? props.linearTilingFeatures
+                                            : props.optimalTilingFeatures;
+}
+
+// One CAMetalLayer's worth of presentation state. Never touched concurrently: the owning map's
+// mutex is held for the whole of present().
+class MetalLayerPresenter {
+   public:
+    static std::unique_ptr<MetalLayerPresenter> create(VkEmulation* emu, void* layer) {
+        auto surface = DisplaySurfaceVk::create(*emu->ivk, emu->instance,
+                                                static_cast<FBNativeWindowType>(layer));
+        if (!surface) {
+            ERR("MetalLayerPresenter: vkCreateMetalSurfaceEXT failed for layer %p", layer);
+            return nullptr;
+        }
+        if (!SwapChainStateVk::validateQueueFamilyProperties(
+                *emu->ivk, emu->physdev, surface->getSurface(), emu->queueFamilyIndex)) {
+            ERR("MetalLayerPresenter: queue family %u cannot present to this surface.",
+                emu->queueFamilyIndex);
+            return nullptr;
+        }
+
+        const VkCommandPoolCreateInfo poolCi = {
+            .sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+            .pNext = nullptr,
+            .flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT,
+            .queueFamilyIndex = emu->queueFamilyIndex,
+        };
+        VkCommandPool pool = VK_NULL_HANDLE;
+        if (emu->dvk->vkCreateCommandPool(emu->device, &poolCi, nullptr, &pool) != VK_SUCCESS) {
+            ERR("MetalLayerPresenter: vkCreateCommandPool failed.");
+            return nullptr;
+        }
+
+        return std::unique_ptr<MetalLayerPresenter>(
+            new MetalLayerPresenter(emu, layer, std::move(surface), pool));
+    }
+
+    ~MetalLayerPresenter() {
+        waitIdle();
+        destroySwapchainResources();
+        mEmu->dvk->vkDestroyCommandPool(mEmu->device, mCommandPool, nullptr);
+        mSurface.reset();
+    }
+
+    // Records + submits the blit and presents. Returns a kMetalPresent* code.
+    int present(const VkEmulation::ColorBufferInfo& cb, VkImageLayout cbLayout) {
+        auto* dvk = mEmu->dvk;
+
+        for (int attempt = 0; attempt < 2; ++attempt) {
+            if (mNeedsRecreate || !mSwapChain) {
+                if (!recreateSwapchain()) return kMetalPresentNoSwapchain;
+            }
+
+            Frame& frame = mFrames[mFrameIndex];
+            if (frame.submitted) {
+                VkResult wr =
+                    dvk->vkWaitForFences(mEmu->device, 1, &frame.fence, VK_TRUE, kFenceTimeoutNs);
+                if (wr != VK_SUCCESS) {
+                    ERR("MetalLayerPresenter: vkWaitForFences -> %s", string_VkResult(wr));
+                    return kMetalPresentDeviceError;
+                }
+            }
+
+            uint32_t imageIndex = 0;
+            VkResult ar = dvk->vkAcquireNextImageKHR(mEmu->device, mSwapChain->getSwapChain(),
+                                                     kAcquireTimeoutNs, frame.acquireSemaphore,
+                                                     VK_NULL_HANDLE, &imageIndex);
+            if (ar == VK_ERROR_OUT_OF_DATE_KHR || ar == VK_SUBOPTIMAL_KHR) {
+                mNeedsRecreate = true;
+                continue;  // retry once with a fresh swapchain
+            }
+            if (ar == VK_TIMEOUT || ar == VK_NOT_READY) {
+                // No image acquired, semaphore untouched (spec guarantee). Drop the frame.
+                return kMetalPresentDropped;
+            }
+            if (ar != VK_SUCCESS) {
+                ERR("MetalLayerPresenter: vkAcquireNextImageKHR -> %s", string_VkResult(ar));
+                return kMetalPresentDeviceError;
+            }
+
+            VK_CHECK(dvk->vkResetFences(mEmu->device, 1, &frame.fence));
+            frame.submitted = false;
+
+            recordBlit(frame.commandBuffer, cb, cbLayout, imageIndex);
+
+            const VkPipelineStageFlags waitStage = VK_PIPELINE_STAGE_TRANSFER_BIT;
+            const VkSubmitInfo submitInfo = {
+                .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+                .pNext = nullptr,
+                .waitSemaphoreCount = 1,
+                .pWaitSemaphores = &frame.acquireSemaphore,
+                .pWaitDstStageMask = &waitStage,
+                .commandBufferCount = 1,
+                .pCommandBuffers = &frame.commandBuffer,
+                .signalSemaphoreCount = 1,
+                .pSignalSemaphores = &mImageReleaseSemaphores[imageIndex],
+            };
+
+            VkSwapchainKHR swapchain = mSwapChain->getSwapChain();
+            const VkPresentInfoKHR presentInfo = {
+                .sType = VK_STRUCTURE_TYPE_PRESENT_INFO_KHR,
+                .pNext = nullptr,
+                .waitSemaphoreCount = 1,
+                .pWaitSemaphores = &mImageReleaseSemaphores[imageIndex],
+                .swapchainCount = 1,
+                .pSwapchains = &swapchain,
+                .pImageIndices = &imageIndex,
+                .pResults = nullptr,
+            };
+
+            VkResult pr;
+            {
+                android::base::AutoLock lock(*mEmu->queueLock);
+                VkResult sr = dvk->vkQueueSubmit(mEmu->queue, 1, &submitInfo, frame.fence);
+                if (sr != VK_SUCCESS) {
+                    ERR("MetalLayerPresenter: vkQueueSubmit -> %s", string_VkResult(sr));
+                    return kMetalPresentDeviceError;
+                }
+                pr = dvk->vkQueuePresentKHR(mEmu->queue, &presentInfo);
+            }
+            frame.submitted = true;
+            mFrameIndex = (mFrameIndex + 1) % mFrames.size();
+
+            if (pr == VK_ERROR_OUT_OF_DATE_KHR || pr == VK_SUBOPTIMAL_KHR) {
+                // The frame did reach the presentation engine; just rebuild before the next one.
+                mNeedsRecreate = true;
+                return kMetalPresentOk;
+            }
+            if (pr != VK_SUCCESS) {
+                ERR("MetalLayerPresenter: vkQueuePresentKHR -> %s", string_VkResult(pr));
+                return kMetalPresentDeviceError;
+            }
+            return kMetalPresentOk;
+        }
+        return kMetalPresentDropped;
+    }
+
+   private:
+    struct Frame {
+        VkCommandBuffer commandBuffer = VK_NULL_HANDLE;
+        VkFence fence = VK_NULL_HANDLE;
+        VkSemaphore acquireSemaphore = VK_NULL_HANDLE;
+        bool submitted = false;
+    };
+
+    MetalLayerPresenter(VkEmulation* emu, void* layer, std::unique_ptr<DisplaySurfaceVk> surface,
+                        VkCommandPool pool)
+        : mEmu(emu), mLayer(layer), mSurface(std::move(surface)), mCommandPool(pool) {}
+
+    void waitIdle() {
+        android::base::AutoLock lock(*mEmu->queueLock);
+        mEmu->dvk->vkDeviceWaitIdle(mEmu->device);
+    }
+
+    void destroySwapchainResources() {
+        auto* dvk = mEmu->dvk;
+        for (auto& frame : mFrames) {
+            if (frame.commandBuffer != VK_NULL_HANDLE) {
+                dvk->vkFreeCommandBuffers(mEmu->device, mCommandPool, 1, &frame.commandBuffer);
+            }
+            if (frame.fence != VK_NULL_HANDLE) {
+                dvk->vkDestroyFence(mEmu->device, frame.fence, nullptr);
+            }
+            if (frame.acquireSemaphore != VK_NULL_HANDLE) {
+                dvk->vkDestroySemaphore(mEmu->device, frame.acquireSemaphore, nullptr);
+            }
+        }
+        mFrames.clear();
+        for (VkSemaphore sem : mImageReleaseSemaphores) {
+            dvk->vkDestroySemaphore(mEmu->device, sem, nullptr);
+        }
+        mImageReleaseSemaphores.clear();
+        mSwapChain.reset();
+        mFrameIndex = 0;
+    }
+
+    bool recreateSwapchain() {
+        auto* dvk = mEmu->dvk;
+        waitIdle();
+        destroySwapchainResources();
+        mNeedsRecreate = false;
+
+        // The layer's current size is authoritative; the VMM re-sets drawableSize on window resize
+        // and the driver reports it back through currentExtent.
+        VkSurfaceCapabilitiesKHR caps = {};
+        VkResult cr = mEmu->ivk->vkGetPhysicalDeviceSurfaceCapabilitiesKHR(
+            mEmu->physdev, mSurface->getSurface(), &caps);
+        if (cr != VK_SUCCESS) {
+            ERR("MetalLayerPresenter: vkGetPhysicalDeviceSurfaceCapabilitiesKHR -> %s",
+                string_VkResult(cr));
+            return false;
+        }
+        uint32_t width = caps.currentExtent.width;
+        uint32_t height = caps.currentExtent.height;
+        if (width == UINT32_MAX || height == UINT32_MAX || width == 0 || height == 0) {
+            width = caps.minImageExtent.width;
+            height = caps.minImageExtent.height;
+        }
+        if (width == 0 || height == 0) {
+            // Minimized / zero-sized layer: nothing to present into.
+            return false;
+        }
+
+        auto ci = SwapChainStateVk::createSwapChainCi(*mEmu->ivk, mSurface->getSurface(),
+                                                      mEmu->physdev, width, height,
+                                                      {mEmu->queueFamilyIndex});
+        if (!ci) {
+            ERR("MetalLayerPresenter: createSwapChainCi failed (%ux%u).", width, height);
+            return false;
+        }
+        mSwapChain = SwapChainStateVk::createSwapChainVk(*dvk, mEmu->device, ci->mCreateInfo);
+        if (!mSwapChain) {
+            ERR("MetalLayerPresenter: createSwapChainVk failed.");
+            return false;
+        }
+
+        const size_t imageCount = mSwapChain->getVkImages().size();
+        const VkSemaphoreCreateInfo semCi = {VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO, nullptr, 0};
+
+        // One release semaphore per swapchain image: an image cannot be re-acquired until its
+        // previous presentation completed, so indexing by image index is the safe recycling rule.
+        mImageReleaseSemaphores.resize(imageCount, VK_NULL_HANDLE);
+        for (size_t i = 0; i < imageCount; ++i) {
+            VK_CHECK(
+                dvk->vkCreateSemaphore(mEmu->device, &semCi, nullptr, &mImageReleaseSemaphores[i]));
+        }
+
+        // One frame slot more than there are images, so the CPU can stay a frame ahead. The slot's
+        // fence gates reuse of both its command buffer and its acquire semaphore.
+        const size_t frameCount = imageCount + 1;
+        mFrames.resize(frameCount);
+        const VkFenceCreateInfo fenceCi = {VK_STRUCTURE_TYPE_FENCE_CREATE_INFO, nullptr, 0};
+        for (auto& frame : mFrames) {
+            const VkCommandBufferAllocateInfo cbAi = {
+                .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+                .pNext = nullptr,
+                .commandPool = mCommandPool,
+                .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY,
+                .commandBufferCount = 1,
+            };
+            VK_CHECK(dvk->vkAllocateCommandBuffers(mEmu->device, &cbAi, &frame.commandBuffer));
+            VK_CHECK(dvk->vkCreateFence(mEmu->device, &fenceCi, nullptr, &frame.fence));
+            VK_CHECK(dvk->vkCreateSemaphore(mEmu->device, &semCi, nullptr, &frame.acquireSemaphore));
+            frame.submitted = false;
+        }
+
+        INFO("MetalLayerPresenter: swapchain %ux%u, %zu images, layer %p", width, height, imageCount,
+             mLayer);
+        return true;
+    }
+
+    void recordBlit(VkCommandBuffer cb, const VkEmulation::ColorBufferInfo& cbInfo,
+                    VkImageLayout cbLayout, uint32_t imageIndex) {
+        auto* dvk = mEmu->dvk;
+        VkImage swapImage = mSwapChain->getVkImages()[imageIndex];
+
+        VK_CHECK(dvk->vkResetCommandBuffer(cb, 0));
+        const VkCommandBufferBeginInfo beginInfo = {
+            .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+            .pNext = nullptr,
+            .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT,
+            .pInheritanceInfo = nullptr,
+        };
+        VK_CHECK(dvk->vkBeginCommandBuffer(cb, &beginInfo));
+
+        const VkImageSubresourceRange colorRange = {
+            .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+            .baseMipLevel = 0,
+            .levelCount = 1,
+            .baseArrayLayer = 0,
+            .layerCount = 1,
+        };
+
+        // VK_QUEUE_FAMILY_IGNORED on both sides, matching every other host-side ColorBuffer
+        // operation in this tree (see readColorBufferToBytesLocked): the image is EXCLUSIVE and we
+        // submit on sVkEmulation->queue, the same family that owns it.
+        const VkImageMemoryBarrier preBarriers[2] = {
+            {
+                .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+                .pNext = nullptr,
+                .srcAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT,
+                .dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT,
+                .oldLayout = cbLayout,
+                .newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                .image = cbInfo.image,
+                .subresourceRange = colorRange,
+            },
+            {
+                .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+                .pNext = nullptr,
+                .srcAccessMask = 0,
+                .dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+                .oldLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+                .newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+                .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                .image = swapImage,
+                .subresourceRange = colorRange,
+            },
+        };
+        dvk->vkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                                  VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, 2,
+                                  preBarriers);
+
+        const VkExtent2D dstExtent = mSwapChain->getImageExtent();
+        const VkImageBlit region = {
+            .srcSubresource = {.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+                               .mipLevel = 0,
+                               .baseArrayLayer = 0,
+                               .layerCount = 1},
+            .srcOffsets = {{0, 0, 0},
+                           {static_cast<int32_t>(cbInfo.imageCreateInfoShallow.extent.width),
+                            static_cast<int32_t>(cbInfo.imageCreateInfoShallow.extent.height), 1}},
+            .dstSubresource = {.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+                               .mipLevel = 0,
+                               .baseArrayLayer = 0,
+                               .layerCount = 1},
+            .dstOffsets = {{0, 0, 0},
+                           {static_cast<int32_t>(dstExtent.width),
+                            static_cast<int32_t>(dstExtent.height), 1}},
+        };
+
+        // VUID-vkCmdBlitImage-filter-02001: LINEAR needs SAMPLED_IMAGE_FILTER_LINEAR on the source.
+        const VkFormatFeatureFlags srcFeatures = formatFeaturesOf(
+            mEmu, cbInfo.imageCreateInfoShallow.format, cbInfo.imageCreateInfoShallow.tiling);
+        const VkFilter filter = (srcFeatures & VK_FORMAT_FEATURE_SAMPLED_IMAGE_FILTER_LINEAR_BIT)
+                                    ? VK_FILTER_LINEAR
+                                    : VK_FILTER_NEAREST;
+
+        dvk->vkCmdBlitImage(cb, cbInfo.image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, swapImage,
+                            VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region, filter);
+
+        const VkImageMemoryBarrier postBarriers[2] = {
+            {
+                .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+                .pNext = nullptr,
+                .srcAccessMask = VK_ACCESS_TRANSFER_READ_BIT,
+                .dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT,
+                .oldLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                .newLayout = cbLayout,  // restore; never PRESENT_SRC_KHR, never UNDEFINED
+                .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                .image = cbInfo.image,
+                .subresourceRange = colorRange,
+            },
+            {
+                .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+                .pNext = nullptr,
+                .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+                .dstAccessMask = VK_ACCESS_MEMORY_READ_BIT,
+                .oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+                .newLayout = VK_IMAGE_LAYOUT_PRESENT_SRC_KHR,
+                .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                .image = swapImage,
+                .subresourceRange = colorRange,
+            },
+        };
+        dvk->vkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                                  VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 0, nullptr, 0, nullptr, 2,
+                                  postBarriers);
+
+        VK_CHECK(dvk->vkEndCommandBuffer(cb));
+    }
+
+    VkEmulation* const mEmu;
+    void* const mLayer;
+    std::unique_ptr<DisplaySurfaceVk> mSurface;
+    VkCommandPool mCommandPool = VK_NULL_HANDLE;
+    std::unique_ptr<SwapChainStateVk> mSwapChain;
+    std::vector<VkSemaphore> mImageReleaseSemaphores;  // indexed by swapchain image index
+    std::vector<Frame> mFrames;
+    size_t mFrameIndex = 0;
+    bool mNeedsRecreate = true;
+};
+
+std::mutex sPresentersMutex;
+std::unordered_map<void*, std::unique_ptr<MetalLayerPresenter>> sPresenters;
+
+}  // namespace
+
+int presentColorBufferToMetalLayer(uint32_t colorBufferHandle, void* caMetalLayer) {
+    if (caMetalLayer == nullptr) return kMetalPresentNoLayer;
+
+    VkEmulation* emu = getGlobalVkEmulation();
+    if (!emu || emu->device == VK_NULL_HANDLE || !emu->dvk || !emu->ivk || !emu->queueLock) {
+        return kMetalPresentNoEmulation;
+    }
+    if (!emu->instanceSupportsMetalSurface || !emu->ivk->vkCreateMetalSurfaceEXT ||
+        !emu->dvk->vkCreateSwapchainKHR || !emu->dvk->vkAcquireNextImageKHR ||
+        !emu->dvk->vkQueuePresentKHR) {
+        PRESENTER_ERR_ONCE(
+            "In-Vulkan present unavailable: VK_EXT_metal_surface / VK_KHR_swapchain "
+            "entrypoints missing.");
+        return kMetalPresentNoExtension;
+    }
+
+    // Settle any host GPU work still outstanding on this ColorBuffer. Done BEFORE taking
+    // sPresentersMutex: waitSyncVkColorBuffer holds sVkEmulationLock while it polls.
+    (void)waitSyncVkColorBuffer(colorBufferHandle);
+
+    VkEmulation::ColorBufferInfo cbInfo = getColorBufferInfo(colorBufferHandle);
+    if (cbInfo.image == VK_NULL_HANDLE) {
+        return kMetalPresentNoColorBuffer;
+    }
+    if (!(formatFeaturesOf(emu, cbInfo.imageCreateInfoShallow.format,
+                           cbInfo.imageCreateInfoShallow.tiling) &
+          VK_FORMAT_FEATURE_BLIT_SRC_BIT)) {
+        PRESENTER_ERR_ONCE(
+            "In-Vulkan present: ColorBuffer format %s (%s) lacks "
+            "VK_FORMAT_FEATURE_BLIT_SRC_BIT (VUID-vkCmdBlitImage-srcImage-01999).",
+            string_VkFormat(cbInfo.imageCreateInfoShallow.format),
+            string_VkImageTiling(cbInfo.imageCreateInfoShallow.tiling));
+        return kMetalPresentUnblittable;
+    }
+
+    // Never transition FROM VK_IMAGE_LAYOUT_UNDEFINED: some drivers really do discard the contents
+    // (see the go/ahb-vkimagelayout note in readColorBufferToBytesLocked). Mirror that function:
+    // treat UNDEFINED as already-TRANSFER_SRC_OPTIMAL and publish that as the tracked layout.
+    VkImageLayout cbLayout = cbInfo.currentLayout;
+    if (cbLayout == VK_IMAGE_LAYOUT_UNDEFINED) {
+        cbLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+        setColorBufferCurrentLayout(colorBufferHandle, cbLayout);
+    }
+
+    std::lock_guard<std::mutex> guard(sPresentersMutex);
+    auto it = sPresenters.find(caMetalLayer);
+    if (it == sPresenters.end()) {
+        auto presenter = MetalLayerPresenter::create(emu, caMetalLayer);
+        if (!presenter) return kMetalPresentNoSurface;
+        it = sPresenters.emplace(caMetalLayer, std::move(presenter)).first;
+    }
+    return it->second->present(cbInfo, cbLayout);
+}
+
+void teardownMetalLayerPresenters() {
+    std::lock_guard<std::mutex> guard(sPresentersMutex);
+    sPresenters.clear();
+}
+
+}  // namespace vk
+}  // namespace gfxstream
+
+#else  // !__APPLE__
+
+namespace gfxstream {
+namespace vk {
+
+int presentColorBufferToMetalLayer(uint32_t, void*) { return kMetalPresentNoExtension; }
+void teardownMetalLayerPresenters() {}
+
+}  // namespace vk
+}  // namespace gfxstream
+
+#endif  // __APPLE__
