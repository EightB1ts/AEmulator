@@ -38,6 +38,12 @@
 #include "goldfish_vk_extension_structs.h"
 #include "goldfish_vk_private_defs.h"
 
+// AEmulator: the generated VkStructureType -> owning-extension table, so the abort() below can name
+// which extension put this struct on the wire instead of only which struct it was. Included by
+// relative path on purpose — a quoted include resolves against this file's own directory, so no
+// build system (cmake / meson / Android.bp / bazel) needs to learn about it.
+#include "../../VkDecoderCerealGap.inc"
+
 namespace gfxstream {
 namespace vk {
 
@@ -16314,9 +16320,31 @@ void reservedunmarshal_extension_struct(VulkanStream* vkStream, VkStructureType
         }
 #endif
         default: {
-            // fatal; the switch is only taken if the extension struct is known
-            fprintf(stderr, " %s, Unhandled Vulkan structure type %s [%d], aborting.\n", __func__,
-                    string_VkStructureType(VkStructureType(structType)), structType);
+            // FATAL, and deliberately kept that way. The wire carries a single pNext_size for the
+            // whole chain, not a per-struct body length, and the bodies are not fixed size — so a
+            // decoder that does not know this struct cannot know how many bytes to step over.
+            // Skipping it would desynchronise every later field in the stream, which is strictly
+            // worse than dying here. The fix is always upstream: keep the owning extension out of
+            // vkEnumerateDeviceExtensionProperties so the guest never enables it and the struct
+            // never reaches the wire at all.
+            const char* structName = string_VkStructureType(VkStructureType(structType));
+            const char* owner = aemu_cereal_gap::CerealGapExtensionForStructType(structName);
+            fprintf(stderr,
+                    " %s, Unhandled Vulkan structure type %s [%d], aborting.\n"
+                    "  owning extension: %s\n"
+                    "  It reached the wire, so that extension was advertised to the guest. Do NOT\n"
+                    "  fix this by skipping the struct (the stream would desync). Instead:\n"
+                    "    * not listed in host/vulkan/VkDecoderCerealGap.inc? the .inc is stale for\n"
+                    "      this gfxstream pin — regenerate it with `aemu-cereal-gap generate` and\n"
+                    "      re-export third_party/patches/gfxstream/ (ci/hvf-doctor.sh runs\n"
+                    "      `aemu-cereal-gap verify` to catch exactly this drift).\n"
+                    "    * listed, but still advertised? it is in kCerealGapExtensionsKeptAnyway in\n"
+                    "      VkDecoderGlobalState.cpp — drop it from that allowlist — or this process\n"
+                    "      is running with AEMU_GFXSTREAM_NO_EXT_STRIP=1, which disables the strip.\n",
+                    __func__, structName, structType,
+                    owner ? owner
+                          : "UNKNOWN — this struct is in neither cereal gap table, so it is not an "
+                            "extension struct this build can attribute (regenerate the .inc)");
             abort();
         }
     }
