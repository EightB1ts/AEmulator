--- a/host/vulkan/cereal/common/vk_struct_id.h
+++ b/host/vulkan/cereal/common/vk_struct_id.h
@@ -77,6 +77,19 @@ REGISTER_VK_STRUCT_ID(VkPhysicalDeviceIDProperties,
                       VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ID_PROPERTIES);
 REGISTER_VK_STRUCT_ID(VkPhysicalDeviceDriverProperties,
                       VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DRIVER_PROPERTIES);
+// AEmulator: the promoted-core property structs. Needed so on_vkGetPhysicalDeviceProperties2's
+// identity pass can reach subgroupSize and conformanceVersion through vk_find_struct<> in BOTH the
+// forms a guest can ask for them: the standalone VkPhysicalDeviceSubgroupProperties /
+// VkPhysicalDeviceDriverProperties, and the aggregate VkPhysicalDeviceVulkan1{1,2,3}Properties. A
+// guest that asks only via the aggregate would otherwise see the host's real values.
+REGISTER_VK_STRUCT_ID(VkPhysicalDeviceSubgroupProperties,
+                      VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SUBGROUP_PROPERTIES);
+REGISTER_VK_STRUCT_ID(VkPhysicalDeviceVulkan11Properties,
