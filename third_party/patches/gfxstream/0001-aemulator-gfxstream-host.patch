+// Avnir in-Vulkan present (Apache-2.0). Present the scanout ColorBuffer `res_handle` (the virtio-gpu
+// COLOR_BUFFER resource id, which equals the gfxstream ColorBuffer handle) directly into the host
+// CAMetalLayer `ca_metal_layer`, entirely inside Vulkan: vkCreateMetalSurfaceEXT + VK_KHR_swapchain +
+// vkCmdBlitImage + vkQueuePresentKHR. No pixels and no Metal objects cross this boundary.
+//
+// `ca_metal_layer` is an unretained `CAMetalLayer*` owned by the caller; it must stay alive until
+// stream_renderer_teardown(). The surface and swapchain are created lazily on the first call for a
+// given layer, cached, and recreated automatically on resize / VK_ERROR_OUT_OF_DATE_KHR /
+// VK_SUBOPTIMAL_KHR. Safe to call from any thread; calls are serialized internally.
+//
+// Returns:
+//    0  presented.
+//    1  frame intentionally dropped (no swapchain image became available in time, or the swapchain
+//       is being recreated). The present path is healthy; the caller should NOT fall back.
+//   <0  hard failure (no Vulkan emulation, unknown ColorBuffer, VK_EXT_metal_surface unavailable,
+//       surface/swapchain creation failed, format cannot be blitted). The caller should fall back
+//       to the CPU readback present path.
+VG_EXPORT int stream_renderer_present_to_metal_layer(uint32_t res_handle, void* ca_metal_layer);
+
+// Avnir in-Vulkan present (Apache-2.0). Release the VkSurfaceKHR + VK_KHR_swapchain this renderer
+// cached for `ca_metal_layer` on its first stream_renderer_present_to_metal_layer() call. Other
+// layers' presenters are untouched.
+//
+// stream_renderer_teardown() frees every cached presenter, but only at renderer shutdown — and the
+// CAMetalLayer belongs to the caller's window, which can close first. Once it has, the cached
+// surface names a freed CALayer and destroying it at teardown time is a use-after-free. So the
+// caller must call this while the layer is STILL ALIVE and the renderer is STILL RUNNING (the
+// VkDevice must be live to destroy the swapchain), i.e. immediately before it stops publishing the
+// pointer and drops the window.
+//
+// No-op for NULL, and for a layer never presented to. Idempotent. Safe from any thread; serialized
+// against stream_renderer_present_to_metal_layer() internally, though the caller is still
+// responsible for not racing a present into the same layer it is releasing.
+VG_EXPORT void stream_renderer_release_metal_layer(void* ca_metal_layer);
+
+// Avnir guest-facing GPU identity (Apache-2.0). What the renderer tells the GUEST its GPU is.
+//
+// The renderer is a Vulkan-to-Vulkan proxy, so by default every identity field the guest reads is
+// the host driver's own — on macOS that is Mesa KosmicKrisp on Apple silicon, i.e. a `vendorID` of
+// 0x106b and a `pipelineCacheUUID` that is a permanent, unpermissioned, cross-app hardware
+// identifier. This entry point lets the caller replace a chosen subset of those answers.
+//
+// SENTINEL CONVENTION, and it is the whole contract: a zero integer, an empty `device_name`, and an
+// all-zero `pipeline_cache_uuid` each mean KEEP THE HOST VALUE. A zero-filled struct (other than
+// `struct_size`) is therefore an explicit request for exact passthrough, and NOT calling this at
+// all is byte-identical to that. The renderer applies; it never invents a value, never derives one
+// field from another, and holds no notion of which GPU is being described — all of that policy
+// lives in the caller (AEmulator's `aemulator-identity` crate, whose tests are the record of why
+// each value is what it is).
+//
+// What is affected, all of it guest-facing only: vkGetPhysicalDeviceProperties{,2} (base struct
+// plus a pNext walk), vkGetPhysicalDeviceFeatures{,2}, vkEnumerateDeviceExtensionProperties, and
+// the 32-byte VkPipelineCacheHeaderVersionOne that vkGetPipelineCacheData returns. The renderer's
+// own cached physical-device properties are deliberately NOT touched, because its internal
+// 1.0-vs-1.1 branch decisions and host-feature probes read them.
+//
+// MUST BE CALLED BEFORE stream_renderer_init(). The values are read from the first
+// vkEnumeratePhysicalDevices onwards, on renderer threads that do not exist yet at that point,
+// which is what makes an unsynchronized write safe. Calling it afterwards is undefined: a guest
+// that has already read one answer would start seeing another.
+struct stream_renderer_gpu_identity {
+    // sizeof(struct stream_renderer_gpu_identity). ABI drift guard: the renderer rejects the call
+    // rather than reading a struct laid out by a differently-versioned header. Set it from sizeof,
+    // never from a literal.
+    uint32_t struct_size;
+    // PCI-style vendor / device id. 0 = keep host.
+    uint32_t vendor_id;
+    uint32_t device_id;
+    // STREAM_RENDERER_GPU_IDENTITY_* bits below. 0 = apply nothing beyond the value fields.
+    uint32_t flags;
+    // VkPhysicalDeviceLimits::maxViewports. 0 = keep host. Must be 1 whenever the caller also asks
+    // for CLAMP_MOBILE_FEATURES, which reports multiViewport as unsupported: the Vulkan spec
+    // requires maxViewports == 1 in that case, and the renderer will refuse to clear the feature
+    // bit on its own if this field says otherwise rather than emit an internally invalid device.
+    uint32_t max_viewports;
+    // VkPhysicalDeviceSubgroupProperties::subgroupSize, and the Vulkan11/13 aliases of it.
+    // 0 = keep host.
+    uint32_t subgroup_size;
+    // VkPhysicalDeviceProperties::deviceName, VK_MAX_PHYSICAL_DEVICE_NAME_SIZE bytes.
+    // "" = keep host. Truncated to fit and always NUL-terminated by the renderer.
+    char device_name[256];
+    // VkPhysicalDeviceProperties::pipelineCacheUUID, VK_UUID_SIZE bytes. All-zero = keep host.
+    //
+    // This is the single highest-value field here. It is a stable device identifier that no Android
+    // permission gates, that survives a factory reset, and that any two apps can join on — and it
+    // leaks through the pipeline-cache blob as well as through the properties call, so the renderer
+    // rewrites both directions of that blob to keep the two answers consistent.
+    uint8_t pipeline_cache_uuid[16];
+};
+
+// Report the mobile-plausible subset of the host's feature set: textureCompressionBC = FALSE (no
+// mobile GPU implements BC/DXT) and multiViewport = FALSE (paired with max_viewports == 1). Only
+// ever CLEARS bits. Reporting a feature the host lacks would make the guest enable it and
+// vkCreateDevice fail outright, so there is no bit here that can add one.
+#define STREAM_RENDERER_GPU_IDENTITY_CLAMP_MOBILE_FEATURES 0x00000001u
+// Hide the host-platform-specific device extensions that no Android GPU driver would ever
+// advertise. See on_vkEnumerateDeviceExtensionProperties for the exact list and for why
+// VK_EXT_external_memory_metal is only dropped when VK_EXT_external_memory_host survives it.
+#define STREAM_RENDERER_GPU_IDENTITY_STRIP_PLATFORM_EXTS 0x00000002u
+
+// Install `identity` (a copy is taken; the caller may free it immediately).
+//
+// Returns:
+//    0  installed.
+//   -1  `identity` is NULL.
+//   -2  `identity->struct_size` does not match this renderer's sizeof — the caller was built
+//       against a different version of this header. Nothing is installed, so the renderer keeps
+//       exact passthrough rather than applying a misread struct.
+VG_EXPORT int stream_renderer_set_gpu_identity(const struct stream_renderer_gpu_identity* identity);
+
