index fd3048888..9126c8281 100644
--- a/host/vulkan/VulkanDispatch.cpp
+++ b/host/vulkan/VulkanDispatch.cpp
@@ -79,46 +79,50 @@ static void initIcdPaths(bool forTesting) {
         setIcdPaths("vk_swiftshader_icd.json");
     } else {
 #ifdef __APPLE__
-        // Mac: Use MoltenVK by default unless GPU mode is set to swiftshader
-        if (androidIcd != "moltenvk") {
-            WARN("%s: Unknown ICD, resetting to MoltenVK", __func__);
-            android::base::setEnvironmentVariable("ANDROID_EMU_VK_ICD", "moltenvk");
+        // macOS: the host-GPU Vulkan driver is Mesa KosmicKrisp (Khronos-conformant, Metal
+        // backend). MoltenVK has been removed entirely; macOS 26+ is a hard requirement.
+        if (androidIcd != "kosmickrisp") {
+            WARN("%s: Unknown ICD '%s', resetting to KosmicKrisp", __func__, androidIcd.c_str());
+            android::base::setEnvironmentVariable("ANDROID_EMU_VK_ICD", "kosmickrisp");
         }
-        setIcdPaths("MoltenVK_icd.json");
-
-        // Configure MoltenVK library with environment variables
-        // 0: No logging.
-        // 1: Log errors only.
-        // 2: Log errors and warning messages.
-        // 3: Log errors, warnings and informational messages.
-        // 4: Log errors, warnings, infos and debug messages.
-        const bool verboseLogs =
-            (android::base::getEnvironmentVariable("ANDROID_EMUGL_VERBOSE") == "1");
-        const char* logLevelValue = verboseLogs ? "4" : "1";
-        android::base::setEnvironmentVariable("MVK_CONFIG_LOG_LEVEL", logLevelValue);
-
-        //  Limit MoltenVK to use single queue, as some older ANGLE versions
-        //  expect this for -guest-angle to work.
-        //  0: Limit Vulkan to a single queue, with no explicit semaphore
-        //  synchronization, and use Metal's implicit guarantees that all operations
-        //  submitted to a queue will give the same result as if they had been run in
-        //  submission order.
-        android::base::setEnvironmentVariable("MVK_CONFIG_VK_SEMAPHORE_SUPPORT_STYLE", "0");
-
-        // TODO(b/364055067)
-        // MVK_CONFIG_USE_METAL_ARGUMENT_BUFFERS is not working correctly
-        android::base::setEnvironmentVariable("MVK_CONFIG_USE_METAL_ARGUMENT_BUFFERS", "0");
-
-        // MVK_CONFIG_USE_MTLHEAP is required for VK_EXT_external_memory_metal
-        android::base::setEnvironmentVariable("MVK_CONFIG_USE_MTLHEAP", "1");
-
-        // TODO(b/351765838): VVL won't work with MoltenVK due to the current
-        //  way of external memory handling, add it into disable list to
-        //  avoid users enabling it implicitly (i.e. via vkconfig).
-        //  It can be enabled with VK_LOADER_LAYERS_ALLOW=VK_LAYER_KHRONOS_validation
-        INFO("Vulkan Validation Layers won't be enabled with MoltenVK");
-        android::base::setEnvironmentVariable("VK_LOADER_LAYERS_DISABLE",
-                                              "VK_LAYER_KHRONOS_validation");
+
+        // Prefer a caller-supplied driver manifest over our staged copy.
+        // The Vulkan loader gives VK_DRIVER_FILES strict precedence over VK_ICD_FILENAMES, so
+        // setIcdPaths()'s write to VK_ICD_FILENAMES is a silent no-op whenever the caller
+        // exported VK_DRIVER_FILES. Make that explicit rather than relying on loader precedence
+        // that is invisible from this file: it is what lets the emulator and
+        // crates/aemulator-hvf/kosmickrisp/run-gate.sh provably load the same driver binary.
+        const std::string callerDriverFiles =
+            android::base::getEnvironmentVariable("VK_DRIVER_FILES");
+        const std::string callerIcdFilenames =
+            android::base::getEnvironmentVariable("VK_ICD_FILENAMES");
+        if (!callerDriverFiles.empty()) {
+            INFO("%s: honoring caller-supplied VK_DRIVER_FILES=%s", __func__,
+                 callerDriverFiles.c_str());
+        } else if (!callerIcdFilenames.empty()) {
+            INFO("%s: honoring caller-supplied VK_ICD_FILENAMES=%s", __func__,
+                 callerIcdFilenames.c_str());
+        } else {
+            // Bundle-relative fallback: <programDir>/lib64/vulkan/ and <launcherDir>/lib64/vulkan/.
+            setIcdPaths("kosmickrisp_mesa_icd.aarch64.json");
+        }
+
+        // NOTE: no driver tuning env vars are set. The four MVK_CONFIG_* vars this block used to
+        // set have no KosmicKrisp analogue and none is needed:
+        //   MVK_CONFIG_USE_MTLHEAP=1                  -> KosmicKrisp always backs exportable
+        //                                                allocations with an MTLHeap; MTLHEAP is
+        //                                                its only external handle type.
+        //   MVK_CONFIG_VK_SEMAPHORE_SUPPORT_STYLE=0   -> the "single queue" property older ANGLE
+        //                                                needs is structural: KosmicKrisp exposes
+        //                                                exactly one queue family, queueCount=1.
+        //                                                Its VkSemaphores are real (MTLEvent-
+        //                                                backed), which is strictly stronger than
+        //                                                MoltenVK's implicit ordering.
+        //   MVK_CONFIG_USE_METAL_ARGUMENT_BUFFERS=0   -> no discrete-binding fallback exists.
+        //   MVK_CONFIG_LOG_LEVEL                      -> no log-level knob (mesa logs to stderr).
+        // VK_LOADER_LAYERS_DISABLE is likewise NOT set any more: the Khronos validation layers
+        // work against a conformant driver and are the primary bring-up tool. If VVL ever emits
+        // false positives on the MTLHEAP path, re-add it as an opt-OUT, never a force-disable.
 #else
         // By default, on other platforms, just use whatever the system
         // is packing.
