--- a/host/gl/gl-host-common/opengl/emugl_config.cpp
+++ b/host/gl/gl-host-common/opengl/emugl_config.cpp
@@ -393,7 +393,26 @@ bool emuglConfig_init(EmuglConfig* config,
 
 void emuglConfig_setupEnv(const EmuglConfig* config) {
     if (config->use_host_vulkan) {
+#if defined(__APPLE__)
+        // AEmulator: on macOS the "host GPU Vulkan" backend is Mesa KosmicKrisp (Metal); there is
+        // no native Vulkan ICD. Upstream blanks ANDROID_EMU_VK_ICD here, which would make
+        // VulkanDispatch::getPossibleLoaderPaths() fall back to a bare dyld search for
+        // libvulkan.dylib instead of the staged <programDir>/lib64/vulkan/ loader. Force the
+        // kosmickrisp token instead, unless the caller explicitly asked for swiftshader.
+        //
+        // ORDERING NOTE: this runs AFTER vkDispatch() — virtio-gpu-gfxstream-renderer.cpp calls
+        // vkDispatch(false) at stream_renderer_opengles_init before emuglConfig_setupEnv, and
+        // VulkanDispatchImpl::initialize is one-shot. So this does NOT choose the ICD file;
+        // initIcdPaths already did that from the process environment. It only preserves the
+        // selection for later readers.
+        const std::string existingIcd =
+            android::base::getEnvironmentVariable("ANDROID_EMU_VK_ICD");
+        if (existingIcd != "swiftshader") {
+            android::base::setEnvironmentVariable("ANDROID_EMU_VK_ICD", "kosmickrisp");
+        }
+#else
         android::base::setEnvironmentVariable("ANDROID_EMU_VK_ICD", "");
+#endif
     } else if (sCurrentRenderer == SELECTED_RENDERER_SWIFTSHADER_INDIRECT) {
         // Use Swiftshader vk icd if using swiftshader_indirect
         android::base::setEnvironmentVariable("ANDROID_EMU_VK_ICD", "swiftshader");
