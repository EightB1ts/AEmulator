diff --git a/src/kosmickrisp/vulkan/kk_cmd_copy.c b/src/kosmickrisp/vulkan/kk_cmd_copy.c
index 2e76d14cc6122402f60e21c797b1aaf20e8baacd..16dae878267d412c56cde5e0eb0257b40263fbfc 100644
--- a/src/kosmickrisp/vulkan/kk_cmd_copy.c
+++ b/src/kosmickrisp/vulkan/kk_cmd_copy.c
@@ -18,6 +18,30 @@
 
 #include "util/format/u_format.h"
 
+/*
+ * The depth aspect of VK_FORMAT_D24_UNORM_S8_UINT / VK_FORMAT_X8_D24_UNORM_PACK32
+ * is exchanged with buffers as one 32-bit word per texel holding a 24-bit unorm
+ * value in the LSBs.  Apple GPUs have no 24-bit depth format, so kk_format.c
+ * backs both with MTLPixelFormatDepth32Float{,_Stencil8} and Metal's
+ * MTLBlitOptionDepthFromDepthStencil produces/consumes IEEE binary32 instead.
+ * The stride is identical (4 B/texel) so only the value needs re-encoding; see
+ * libkk/kk_copy.cl.
+ */
+static bool
+kk_copy_needs_d24_fixup(enum pipe_format plane_format,
+                        VkImageAspectFlags aspect_mask)
+{
+   if (aspect_mask != VK_IMAGE_ASPECT_DEPTH_BIT)
+      return false;
+
+   return plane_format == PIPE_FORMAT_Z24_UNORM_S8_UINT ||
+          plane_format == PIPE_FORMAT_Z24X8_UNORM;
+}
+
+/* Metal wants the source offset of a buffer->texture copy aligned; 256 is the
+ * largest minimumLinearTextureAlignmentForPixelFormat on any Apple GPU. */
+#define KK_D24_SCRATCH_ALIGN_B 256u
+
 VKAPI_ATTR void VKAPI_CALL
 kk_CmdCopyBuffer2(VkCommandBuffer commandBuffer,
                   const VkCopyBufferInfo2 *pCopyBufferInfo)
@@ -102,6 +126,48 @@ kk_CmdCopyBufferToImage2(VkCommandBuffer commandBuffer,
       info.mtl_data.image = plane->mtl_handle;
       size_t buffer_offset = region->bufferOffset;
 
+      /* The application buffer holds 24-bit unorm depth and must not be
+       * modified, so decode it into scratch and have Metal copy from there. */
+      if (kk_copy_needs_d24_fixup(plane->layout.format.pipe,
+                                  region->imageSubresource.aspectMask)) {
+         const uint32_t layers = vk_image_subresource_layer_count(
+            &image->vk, &region->imageSubresource);
+         const uint64_t total_B = (uint64_t)info.buffer_slice_size_B *
+                                  (uint64_t)layers *
+                                  (uint64_t)region->imageExtent.depth;
+         if (total_B > UINT32_MAX) {
+            vk_command_buffer_set_error(&cmd->vk,
+                                        VK_ERROR_OUT_OF_DEVICE_MEMORY);
+            return;
+         }
+
+         struct kk_ptr scratch =
+            kk_pool_alloc(cmd, total_B, KK_D24_SCRATCH_ALIGN_B);
+         if (unlikely(!scratch.gpu))
+            return;
+
+         const uint32_t texels = region->imageExtent.width *
+                                 region->imageExtent.height *
+                                 region->imageExtent.depth;
+         uint64_t src = buffer->vk.device_address + region->bufferOffset;
+         uint64_t dst = scratch.gpu;
+         for (uint32_t i = 0u; i < layers; ++i) {
+            libkk_depth_unorm24_to_f32(
+               cmd, kk_grid_1d(texels), true, dst, src,
+               region->imageExtent.width, region->imageExtent.height,
+               region->imageExtent.depth, info.mtl_data.buffer_stride_B,
+               info.mtl_data.buffer_2d_image_size_B);
+            src += info.buffer_slice_size_B;
+            dst += info.buffer_slice_size_B;
+         }
+
+         mtl_barrier_after_encoder_stages(encoder, MTL_STAGE_DISPATCH,
+                                          MTL_STAGE_BLIT);
+
+         info.mtl_data.buffer = scratch.buffer;
+         buffer_offset = scratch.offset;
+      }
+
       kk_foreach_slice(slice, image, imageSubresource)
       {
          info.mtl_data.image_slice = slice;
@@ -139,6 +205,33 @@ kk_CmdCopyImageToBuffer2(VkCommandBuffer commandBuffer,
          mtl_copy_from_texture_to_buffer(encoder, &info.mtl_data);
          buffer_offset += info.buffer_slice_size_B;
       }
+
+      /* Metal just wrote float32 depth where Vulkan requires 24-bit unorm.
+       * Both are 4 B/texel, so re-encode the words the copy landed on, in
+       * place, without touching row padding. */
+      if (kk_copy_needs_d24_fixup(plane->layout.format.pipe,
+                                  region->imageSubresource.aspectMask)) {
+         const uint32_t texels = region->imageExtent.width *
+                                 region->imageExtent.height *
+                                 region->imageExtent.depth;
+
+         mtl_barrier_after_encoder_stages(encoder, MTL_STAGE_BLIT,
+                                          MTL_STAGE_DISPATCH);
+
+         uint64_t addr = buffer->vk.device_address + region->bufferOffset;
+         kk_foreach_slice(slice, image, imageSubresource)
+         {
+            libkk_depth_f32_to_unorm24(
+               cmd, kk_grid_1d(texels), true, addr, region->imageExtent.width,
+               region->imageExtent.height, region->imageExtent.depth,
+               info.mtl_data.buffer_stride_B,
+               info.mtl_data.buffer_2d_image_size_B);
+            addr += info.buffer_slice_size_B;
+         }
+
+         mtl_barrier_after_encoder_stages(encoder, MTL_STAGE_DISPATCH,
+                                          MTL_STAGE_BLIT);
+      }
    }
 }
 
diff --git a/src/kosmickrisp/vulkan/kk_format.c b/src/kosmickrisp/vulkan/kk_format.c
index 6512a40d8ada6748b16bd2d2096b23b3b6ea2537..4033039eb16d2f6839a0b0a9ccb6e16f001ef555 100644
--- a/src/kosmickrisp/vulkan/kk_format.c
+++ b/src/kosmickrisp/vulkan/kk_format.c
@@ -334,6 +334,32 @@ static const struct kk_va_format kk_vf_formats[] = {
    MTL_FMT_NATIVE(S8_UINT, MTL_FMT_M(8), MTL_FMT_TB_NONE),
    MTL_FMT_NATIVE(Z32_FLOAT_S8X24_UINT, MTL_FMT_FMR(64), MTL_FMT_TB_NONE),
    MTL_FMT_NATIVE(X32_S8X24_UINT, MTL_FMT_MR(64), MTL_FMT_TB_NONE),
+
+   /* Apple GPUs have no 24-bit depth: -[MTLDevice
+    * isDepth24Stencil8PixelFormatSupported] is NO, and MTLTextureDescriptor
+    * validation hard-aborts on MTLPixelFormatDepth24Unorm_Stencil8 (255).
+    * Substitute the 32-bit float depth formats, as MoltenVK does on the same
+    * silicon.  This is legal because a VK_IMAGE_TILING_OPTIMAL image has an
+    * implementation-defined layout -- Vulkan constrains the D24 encoding only
+    * at the copy interfaces, which kk_cmd_copy.c / kk_image.c convert
+    * explicitly.  Precision is strictly greater than a real D24 buffer, which
+    * the spec permits.
+    *
+    * is_native stays 1: it only suppresses the fragment *colour* output
+    * unswizzle in kk_shader.c, which never runs for a depth format, and the
+    * swizzle is the identity regardless.
+    */
+   MTL_FMT(Z24_UNORM_S8_UINT, Z32_FLOAT_S8X24_UINT, MTL_SWIZZLE_IDENTITY,
+           MTL_FMT_FMR(64), MTL_FMT_TB_NONE, true),
+   /* VK_FORMAT_X8_D24_UNORM_PACK32 */
+   MTL_FMT(Z24X8_UNORM, Z32_FLOAT, MTL_SWIZZLE_IDENTITY, MTL_FMT_FMR(32),
+           MTL_FMT_TB_NONE, true),
+   /* Stencil aspect of the above, via util_format_stencil_only() in
+    * kk_image_view.c.  MTLPixelFormatX24_Stencil8 (262) is
+    * API_DEPRECATED(macos(10.12, 27.0)) and unusable on Apple GPUs, so the
+    * stencil view of the substituted texture is X32_Stencil8 (261). */
+   MTL_FMT(X24S8_UINT, X32_S8X24_UINT, MTL_SWIZZLE_IDENTITY, MTL_FMT_MR(64),
+           MTL_FMT_TB_NONE, true),
 };
 
 #undef MTL_FMT_NATIVE
diff --git a/src/kosmickrisp/vulkan/kk_image.c b/src/kosmickrisp/vulkan/kk_image.c
index be224207300ba0f382cae186d9fda7531a55fcaa..64409333f04dd30283f8b947c4daa619eac80229 100644
--- a/src/kosmickrisp/vulkan/kk_image.c
+++ b/src/kosmickrisp/vulkan/kk_image.c
@@ -16,6 +16,8 @@
 #include "kosmickrisp/bridge/mtl_bridge.h"
 #include "kosmickrisp/bridge/vk_to_mtl_map.h"
 
+#include "util/u_math.h"
+
 #include "vk_enum_defines.h"
 #include "vk_enum_to_str.h"
 #include "vk_format.h"
@@ -977,6 +979,88 @@ struct kk_host_copy_info {
    size_t buffer_slice_size_B;
 };
 
+/*
+ * VK_FORMAT_X8_D24_UNORM_PACK32 is backed by MTLPixelFormatDepth32Float (see
+ * kk_format.c), so -[MTLTexture getBytes:]/-[MTLTexture replaceRegion:] speak
+ * IEEE binary32 while VK_EXT_host_image_copy, like every other Vulkan copy
+ * interface, requires a 24-bit unorm value in the LSBs of a 32-bit word.  Both
+ * are 4 B/texel, so this only rewrites values, never moves anything.
+ *
+ * VK_FORMAT_D24_UNORM_S8_UINT never reaches here: Metal refuses CPU access to
+ * a combined depth/stencil texture, so kk_get_image_plane_format_features()
+ * withholds VK_FORMAT_FEATURE_2_HOST_IMAGE_TRANSFER_BIT from it.  The check
+ * below still names it so this stays correct if that ever changes.
+ */
+#define KK_D24_MAX_U 16777215u
+
+/* Same conversions as libkk/kk_copy.cl; see the derivation there.  Encode is
+ * exact for every float in [0, 1] and decode is exact to 2^-47 relative, so
+ * unorm24 -> float32 -> unorm24 is the identity for all 2^24 values. */
+static inline float
+kk_unorm24_to_float(uint32_t v)
+{
+   uint64_t n = ((uint64_t)v << 24) + (uint64_t)v;
+   return (float)n * 0x1p-48f;
+}
+
+static inline uint32_t
+kk_float_to_unorm24(float d)
+{
+   float a = d * 0x1p24f;
+   uint32_t ai = (uint32_t)a;
+   float af = a - (float)ai;
+   float r = af - d;
+
+   return ai + (r >= 0.5f ? 1u : 0u) - (r < -0.5f ? 1u : 0u);
+}
+
+static bool
+kk_host_copy_needs_d24_fixup(enum pipe_format plane_format,
+                             VkImageAspectFlags aspect_mask)
+{
+   if (aspect_mask != VK_IMAGE_ASPECT_DEPTH_BIT)
+      return false;
+
+   return plane_format == PIPE_FORMAT_Z24_UNORM_S8_UINT ||
+          plane_format == PIPE_FORMAT_Z24X8_UNORM;
+}
+
+/* In place over what mtl_texture_get_bytes() just wrote. */
+static void
+kk_host_copy_f32_to_unorm24(uint8_t *base,
+                            const struct mtl_texture_memory_copy *c)
+{
+   for (uint64_t z = 0u; z < c->image_size.z; ++z) {
+      for (uint64_t y = 0u; y < c->image_size.y; ++y) {
+         uint32_t *row = (uint32_t *)(base + z * c->buffer_2d_image_size_B +
+                                      y * c->buffer_stride_B);
+         for (uint64_t x = 0u; x < c->image_size.x; ++x) {
+            row[x] = kk_float_to_unorm24(CLAMP(uif(row[x]), 0.0f, 1.0f));
+         }
+      }
+   }
+}
+
+/* Out of place: the application's memory is const, so decode into the staging
+ * slice that mtl_texture_replace_region() will read. */
+static void
+kk_host_copy_unorm24_to_f32(uint8_t *dst, const uint8_t *src,
+                            const struct mtl_texture_memory_copy *c)
+{
+   for (uint64_t z = 0u; z < c->image_size.z; ++z) {
+      for (uint64_t y = 0u; y < c->image_size.y; ++y) {
+         const uint64_t off =
+            z * c->buffer_2d_image_size_B + y * c->buffer_stride_B;
+         uint32_t *drow = (uint32_t *)(dst + off);
+         const uint32_t *srow = (const uint32_t *)(src + off);
+         for (uint64_t x = 0u; x < c->image_size.x; ++x) {
+            /* The eight MSBs are undefined on the Vulkan side. */
+            drow[x] = fui(kk_unorm24_to_float(srow[x] & KK_D24_MAX_U));
+         }
+      }
+   }
+}
+
 static struct kk_host_copy_info
 vk_image_to_memory_copy_to_mtl_texture_memory_copy(
    const VkImageToMemoryCopy *region, const struct kk_image_plane *plane)
@@ -1030,11 +1114,16 @@ kk_CopyImageToMemory(UNUSED VkDevice device,
       struct kk_host_copy_info info =
          vk_image_to_memory_copy_to_mtl_texture_memory_copy(region, plane);
 
+      const bool d24 = kk_host_copy_needs_d24_fixup(
+         plane->layout.format.pipe, region->imageSubresource.aspectMask);
+
       uint8_t *host_ptr = region->pHostPointer;
       kk_foreach_slice(slice, image, imageSubresource)
       {
          info.mtl_data.image_slice = slice;
          mtl_texture_get_bytes(plane->mtl_handle, host_ptr, &info.mtl_data);
+         if (d24)
+            kk_host_copy_f32_to_unorm24(host_ptr, &info.mtl_data);
          host_ptr += info.buffer_slice_size_B;
       }
    }
@@ -1073,14 +1162,30 @@ kk_CopyMemoryToImage(UNUSED VkDevice device,
       struct kk_host_copy_info info =
          vk_memory_to_image_copy_to_mtl_texture_memory_copy(region, plane);
 
+      uint8_t *staging = NULL;
+      if (kk_host_copy_needs_d24_fixup(plane->layout.format.pipe,
+                                       region->imageSubresource.aspectMask)) {
+         staging = calloc(1, info.buffer_slice_size_B);
+         if (staging == NULL)
+            return vk_error(image, VK_ERROR_OUT_OF_HOST_MEMORY);
+      }
+
       const uint8_t *host_ptr = region->pHostPointer;
       kk_foreach_slice(slice, image, imageSubresource)
       {
          info.mtl_data.image_slice = slice;
-         mtl_texture_replace_region(plane->mtl_handle, host_ptr,
-                                    &info.mtl_data);
+         if (staging != NULL) {
+            kk_host_copy_unorm24_to_f32(staging, host_ptr, &info.mtl_data);
+            mtl_texture_replace_region(plane->mtl_handle, staging,
+                                       &info.mtl_data);
+         } else {
+            mtl_texture_replace_region(plane->mtl_handle, host_ptr,
+                                       &info.mtl_data);
+         }
          host_ptr += info.buffer_slice_size_B;
       }
+
+      free(staging);
    }
 
    return VK_SUCCESS;
