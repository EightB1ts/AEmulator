new file mode 100644
index 0000000000000000000000000000000000000000..c56e1893d1b9a2aabc8d82ebbb7be9c49c0fdbca
--- /dev/null
+++ b/src/kosmickrisp/libkk/kk_copy.cl
@@ -0,0 +1,123 @@
+/*
+ * Copyright 2026 LunarG, Inc.
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+#include "compiler/libcl/libcl_vk.h"
+
+/*
+ * Depth-aspect re-encoding for the emulated 24-bit depth formats.
+ *
+ * Apple GPUs have no 24-bit depth pixel format, so KosmicKrisp backs
+ * VK_FORMAT_D24_UNORM_S8_UINT with MTLPixelFormatDepth32Float_Stencil8 and
+ * VK_FORMAT_X8_D24_UNORM_PACK32 with MTLPixelFormatDepth32Float.  That is
+ * invisible for a VK_IMAGE_TILING_OPTIMAL image, whose layout is
+ * implementation-defined, but it is *not* invisible at the copy interfaces:
+ *
+ *   "Copying to or from the depth aspect of a VK_FORMAT_X8_D24_UNORM_PACK32
+ *    or VK_FORMAT_D24_UNORM_S8_UINT format is packed with one 32-bit word per
+ *    texel with the D24 value in the LSBs of the word, and undefined values
+ *    in the eight MSBs."
+ *
+ * MTLBlitOptionDepthFromDepthStencil hands us IEEE binary32 instead.  Both
+ * encodings are 4 bytes per texel, so these kernels only have to rewrite the
+ * value, not move anything: the buffer stride, the 2D image stride and the
+ * region extent are exactly what the Metal copy used.
+ */
+
+/*
+ * The two conversions, spelled out so that MTLMathModeFast (kk_device_lib.c
+ * compiles the precompiled library with fast math) cannot rewrite them into
+ * something lossy.
+ *
+ * Decode is pure integer arithmetic:
+ *     v / (2^24 - 1) = v * 2^-24 * (1 + 2^-24 + 2^-48 + ...)
+ *                    = ((v << 24) + v) * 2^-48 + O(2^-47 relative)
+ * The shift and add are exact in 64 bits, (float) rounds once, and the 2^-48
+ * scale is an exact power of two.  Written as floats instead, an optimiser is
+ * free to fold `lo + lo * 0x1p-24f` into `lo * (1.0f + 0x1p-24f)` == `lo`,
+ * which is v/2^24 -- a whole ULP wrong, and it breaks the round trip for half
+ * of all values.  (Measured: scratch exhaust.c under -ffast-math.)
+ *
+ * Encode is exact for every float in [0, 1]:
+ *     d * (2^24 - 1) = (d * 2^24) - d
+ * d * 2^24 is an exact power-of-two scaling; splitting it into integer part ai
+ * and fraction af is exact (Sterbenz), so the product is exactly ai + (af - d)
+ * with |af - d| < 1 and the rounding decision is a single comparison.
+ */
+#define KK_D24_MAX_U 16777215u
+
+static inline float
+kk_unorm24_to_float(uint v)
+{
+   ulong n = ((ulong)v << 24) + (ulong)v;
+   return (float)n * 0x1p-48f;
+}
+
+static inline uint
+kk_float_to_unorm24(float d)
+{
+   float a = d * 0x1p24f;
+   uint ai = (uint)a;
+   float af = a - (float)ai;
+   float r = af - d;
+
+   return ai + (r >= 0.5f ? 1u : 0u) - (r < -0.5f ? 1u : 0u);
+}
+
+/* Address of texel i of a width x height x depth region laid out in a buffer
+ * with the row and 2D-image strides the Metal copy was given. */
+static inline ulong
+kk_d24_texel_offset_B(uint i, uint width, uint height, uint row_stride_B,
+                      uint z_stride_B)
+{
+   uint x = i % width;
+   uint t = i / width;
+   uint y = t % height;
+   uint z = t / height;
+
+   return ((ulong)z * (ulong)z_stride_B) + ((ulong)y * (ulong)row_stride_B) +
+          ((ulong)x * 4ul);
+}
+
+/* In place over the destination of a vkCmdCopyImageToBuffer: float32 depth as
+ * Metal wrote it -> 24-bit unorm in the LSBs as Vulkan requires. */
+KERNEL(64)
+libkk_depth_f32_to_unorm24(global uchar *base, uint width, uint height,
+                           uint depth, uint row_stride_B, uint z_stride_B)
+{
+   uint i = cl_global_id.x;
+   if (i >= width * height * depth)
+      return;
+
+   global uint *p = (global uint *)(base + kk_d24_texel_offset_B(
+                                              i, width, height, row_stride_B,
+                                              z_stride_B));
+
+   /* Metal can only have produced [0, 1] here, but be explicit rather than
+    * relying on it -- kk_float_to_unorm24() is only exact on that domain. */
+   float d = fmin(fmax(as_float(*p), 0.0f), 1.0f);
+
+   *p = kk_float_to_unorm24(d);
+}
+
+/* Out of place, source is the application's buffer for vkCmdCopyBufferToImage
+ * (which must not be modified) and destination is driver scratch that the
+ * Metal copy then reads. */
+KERNEL(64)
+libkk_depth_unorm24_to_f32(global uchar *dst, global uchar *src, uint width,
+                           uint height, uint depth, uint row_stride_B,
+                           uint z_stride_B)
+{
+   uint i = cl_global_id.x;
+   if (i >= width * height * depth)
+      return;
+
+   ulong off =
+      kk_d24_texel_offset_B(i, width, height, row_stride_B, z_stride_B);
+
+   /* The eight MSBs are undefined on the Vulkan side; mask them off. */
+   uint v = *(global uint *)(src + off) & KK_D24_MAX_U;
+
+   *(global float *)(dst + off) = kk_unorm24_to_float(v);
+}
