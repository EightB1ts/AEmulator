diff --git a/src/kosmickrisp/bridge/mtl_device.h b/src/kosmickrisp/bridge/mtl_device.h
--- a/src/kosmickrisp/bridge/mtl_device.h
+++ b/src/kosmickrisp/bridge/mtl_device.h
@@ -37,6 +37,36 @@
 uint64_t mtl_device_current_allocated_size(mtl_device *dev);
 uint32_t mtl_device_max_argument_buffer_sampler_count(mtl_device *dev);
 
+/* Ray-tracing capability query.
+ *
+ * Metal answers the question that actually matters — "can a structure built
+ * through the Metal 4 encoder be intersected?" — only privately, so these are
+ * tri-state: UNKNOWN means the selector is not on this macOS, which is not the
+ * same as NO. Nothing hard-links a private selector; every one of them is
+ * reached through -respondsToSelector: and NSSelectorFromString.
+ */
+enum mtl_tristate {
+   MTL_TRISTATE_UNKNOWN = 0,
+   MTL_TRISTATE_NO,
+   MTL_TRISTATE_YES,
+};
+
+/* -[MTLDevice supportsRaytracing]. Public, and YES on hardware that merely
+ * EMULATES ray tracing, so it is necessary but nowhere near sufficient. */
+bool mtl_device_supports_ray_tracing(mtl_device *dev);
+
+/* Private -[MTLDevice requiresRaytracingEmulation]. YES below GPU family
+ * Apple9, where Metal emulates ray tracing in software and the emulated
+ * acceleration-structure BUILDER is reachable only from the legacy
+ * -[MTLCommandBuffer accelerationStructureCommandEncoder] — never from
+ * MTL4ComputeCommandEncoder. See kk_ray_tracing.c for what that costs. */
+enum mtl_tristate mtl_device_requires_ray_tracing_emulation(mtl_device *dev);
+
+/* Private -[MTLDevice supportsRayTracingMatrixLayout]. Diagnostic only —
+ * measured NOT to predict whether MTLMatrixLayoutRowMajor is honoured. Again,
+ * see kk_ray_tracing.c. */
+enum mtl_tristate mtl_device_supports_ray_tracing_matrix_layout(mtl_device *dev);
+
 /* Timestamp query */
 uint64_t mtl_device_get_gpu_timestamp(mtl_device *dev);
 /* Frequency of the GPU timestamp counter in ticks per second. */
diff --git a/src/kosmickrisp/bridge/mtl_device.m b/src/kosmickrisp/bridge/mtl_device.m
--- a/src/kosmickrisp/bridge/mtl_device.m
+++ b/src/kosmickrisp/bridge/mtl_device.m
@@ -14,6 +14,8 @@
 #include <Metal/MTLCaptureManager.h>
 #include <Metal/MTLDevice.h>
 
+#include <objc/message.h>
+
 /* Device creation */
 mtl_device *
 mtl_device_create()
@@ -179,6 +181,53 @@
    }
 }
 
+bool
+mtl_device_supports_ray_tracing(mtl_device *dev)
+{
+   @autoreleasepool {
+      id<MTLDevice> device = (id<MTLDevice>)dev;
+      return device.supportsRaytracing;
+   }
+}
+
+/* Read a private BOOL property by name.
+ *
+ * NSSelectorFromString plus -respondsToSelector: rather than a declared
+ * category: nothing here is linked against, so a macOS that drops the selector
+ * answers UNKNOWN instead of failing to launch. The objc_msgSend cast is the
+ * documented way to call through a SEL whose signature the compiler cannot see;
+ * it is correct only because the signature really is BOOL(id, SEL), which is
+ * what a BOOL @property getter always is.
+ */
+static enum mtl_tristate
+mtl_device_private_bool(id<MTLDevice> device, NSString *name)
+{
+   SEL sel = NSSelectorFromString(name);
+   if (sel == NULL || ![device respondsToSelector:sel])
+      return MTL_TRISTATE_UNKNOWN;
+
+   BOOL value = ((BOOL (*)(id, SEL))objc_msgSend)(device, sel);
+   return value ? MTL_TRISTATE_YES : MTL_TRISTATE_NO;
+}
+
+enum mtl_tristate
+mtl_device_requires_ray_tracing_emulation(mtl_device *dev)
+{
+   @autoreleasepool {
+      return mtl_device_private_bool((id<MTLDevice>)dev,
+                                     @"requiresRaytracingEmulation");
+   }
+}
+
+enum mtl_tristate
+mtl_device_supports_ray_tracing_matrix_layout(mtl_device *dev)
+{
+   @autoreleasepool {
+      return mtl_device_private_bool((id<MTLDevice>)dev,
+                                     @"supportsRayTracingMatrixLayout");
+   }
+}
+
 /* Timestamp query */
 uint64_t
 mtl_device_get_gpu_timestamp(mtl_device *dev)
