diff --git a/src/kosmickrisp/bridge/mtl_command_queue.h b/src/kosmickrisp/bridge/mtl_command_queue.h
--- a/src/kosmickrisp/bridge/mtl_command_queue.h
+++ b/src/kosmickrisp/bridge/mtl_command_queue.h
@@ -42,4 +42,47 @@ void mtl_command_queue_wait_for_drawable(mtl_command_queue *queue,
 void mtl_command_queue_signal_drawable(mtl_command_queue *queue,
                                        void *drawable);
 
+/* ---------------------------------------------------------------------------
+ * MTLCommandQueue, the pre-Metal-4 one.
+ *
+ * This exists for exactly one reason: the acceleration-structure builder that
+ * works on a GPU where Metal emulates ray tracing is reachable only from
+ * -[MTLCommandBuffer accelerationStructureCommandEncoder], and that command
+ * buffer has to come from a legacy queue. Nothing else in KosmicKrisp uses it.
+ *
+ * Ordering against the MTL4CommandQueue is by MTLEvent, and it is real:
+ * MEASURED in crates/aemulator-hvf/kosmickrisp/mtl-legacy-as-probe.m, an MTL4
+ * dispatch still in flight, a legacy build that reads what it wrote, and a
+ * correct intersection, with no CPU wait anywhere between the two queues. The
+ * one subtlety is that -encodeWaitForEvent: and -encodeSignalEvent: are ordered
+ * against the command buffer's ENCODERS by call order, so the wait has to be
+ * encoded before the first encoder is created and the signal after the last one
+ * ends.
+ * ------------------------------------------------------------------------- */
+mtl_legacy_command_queue *mtl_new_legacy_command_queue(mtl_device *device);
+
+void mtl_legacy_command_queue_add_residency_set(mtl_legacy_command_queue *queue,
+                                                mtl_residency_set *set);
+
+void mtl_legacy_command_queue_remove_residency_set(
+   mtl_legacy_command_queue *queue, mtl_residency_set *set);
+
+/* Retained; release with mtl_release() once it has been committed. */
+mtl_legacy_command_buffer *
+mtl_legacy_command_queue_new_command_buffer(mtl_legacy_command_queue *queue);
+
+/* Additive on top of whatever the queue already declares resident. kk relies on
+ * both: the queue-level set for the lifetime and this for the command buffer. */
+void mtl_legacy_command_buffer_use_residency_set(
+   mtl_legacy_command_buffer *command_buffer, mtl_residency_set *set);
+
+void mtl_legacy_command_buffer_encode_wait_for_event(
+   mtl_legacy_command_buffer *command_buffer, mtl_event *event, uint64_t value);
+
+void mtl_legacy_command_buffer_encode_signal_event(
+   mtl_legacy_command_buffer *command_buffer, mtl_event *event, uint64_t value);
+
+void mtl_legacy_command_buffer_commit(
+   mtl_legacy_command_buffer *command_buffer);
+
 #endif /* MTL_COMMAND_QUEUE_H */
