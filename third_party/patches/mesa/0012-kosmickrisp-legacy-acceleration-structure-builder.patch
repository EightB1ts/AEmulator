+    * none. Both stay empty for every command buffer that does not build an
+    * acceleration structure through the legacy encoder, which is all of them on
+    * hardware where the Metal 4 builder works. */
+   struct util_dynarray as_passes;
+   struct kk_as_pass as_open;
+
    /* Owned large BOs */
    struct util_dynarray large_bos;
 
@@ -295,6 +342,20 @@ void cs_start_render(struct kk_cmd_buffer *cmd);
