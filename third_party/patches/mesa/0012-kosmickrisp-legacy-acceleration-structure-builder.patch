+/* The two values of a pass's ordering event. Fixed, because the event is created
+ * fresh for each pass. */
+#define KK_AS_PASS_EVENT_READY 1u
+#define KK_AS_PASS_EVENT_DONE  2u
+
+/* One legacy acceleration-structure pass: a pre-Metal-4 MTLCommandBuffer holding
+ * one MTLAccelerationStructureCommandEncoder per build, plus the MTLEvent that
+ * splices it into the Metal 4 stream.
+ *
+ * WHY A SEPARATE COMMAND BUFFER AT ALL. On a GPU where Metal emulates ray
+ * tracing — every Apple GPU below Apple9, including the M2 — the only
+ * acceleration-structure builder that produces a structure anything can
+ * intersect is the legacy -[MTLCommandBuffer accelerationStructureCommandEncoder]
+ * one. That encoder cannot be obtained from an MTL4CommandBuffer, so the build
+ * has to leave kk's Metal 4 stream and come back. See kk_ray_tracing.c.
+ *
+ * HOW IT IS ORDERED. ::mtl4_prefix is the number of MTL4 command buffers already
+ * closed into kk_cmd_buffer::submit_cmd_bufs when the pass opened, i.e. the ones
+ * that must retire before it runs. At submit time kk_queue_submit commits that
+ * many, signals ::event to KK_AS_PASS_EVENT_READY, commits the pass, waits for
+ * KK_AS_PASS_EVENT_DONE, and only then commits the rest. Correctness of the two
+ * dependencies that matter falls out of this: a TLAS build sees the compute
+ * dispatch that converted its instance array (that dispatch is in the prefix),
+ * and a ray query sees the TLAS (its dispatch is after the wait). BLAS-before-
+ * TLAS inside one pass comes from using one encoder per build, since encoders in
+ * a legacy command buffer are strictly ordered.
+ *
+ * WHY THE EVENT IS PER-PASS AND CREATED AT RECORD TIME. A legacy command buffer
+ * orders -encodeWaitForEvent: against its encoders by call order, so the wait has
+ * to be encoded before the first encoder exists — at record time, when no queue
+ * and therefore no shared counter is in sight. A fresh event per pass makes the
+ * values constant instead.
+ */
+struct kk_as_pass {
+   mtl_legacy_command_buffer *cmd_buf;
+   mtl_event *event;
+   uint32_t mtl4_prefix;
+};
