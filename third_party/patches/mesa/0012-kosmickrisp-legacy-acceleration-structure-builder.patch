+
+/* MTLCommandQueue, the pre-Metal-4 one. See the header for why it exists. */
+mtl_legacy_command_queue *
+mtl_new_legacy_command_queue(mtl_device *device)
+{
+   @autoreleasepool {
+      id<MTLDevice> dev = (id<MTLDevice>)device;
+      return [dev newCommandQueue];
+   }
+}
+
+void
+mtl_legacy_command_queue_add_residency_set(mtl_legacy_command_queue *queue,
+                                           mtl_residency_set *set)
+{
+   @autoreleasepool {
+      id<MTLCommandQueue> q = (id<MTLCommandQueue>)queue;
+      [q addResidencySet:(id<MTLResidencySet>)set];
+   }
+}
+
+void
+mtl_legacy_command_queue_remove_residency_set(mtl_legacy_command_queue *queue,
+                                              mtl_residency_set *set)
+{
+   @autoreleasepool {
+      id<MTLCommandQueue> q = (id<MTLCommandQueue>)queue;
+      [q removeResidencySet:(id<MTLResidencySet>)set];
+   }
+}
+
+mtl_legacy_command_buffer *
+mtl_legacy_command_queue_new_command_buffer(mtl_legacy_command_queue *queue)
+{
+   @autoreleasepool {
+      id<MTLCommandQueue> q = (id<MTLCommandQueue>)queue;
+      return [[q commandBuffer] retain];
+   }
+}
+
+void
+mtl_legacy_command_buffer_use_residency_set(
+   mtl_legacy_command_buffer *command_buffer, mtl_residency_set *set)
+{
+   @autoreleasepool {
+      id<MTLCommandBuffer> cmd_buf = (id<MTLCommandBuffer>)command_buffer;
+      [cmd_buf useResidencySet:(id<MTLResidencySet>)set];
+   }
+}
+
+void
+mtl_legacy_command_buffer_encode_wait_for_event(
+   mtl_legacy_command_buffer *command_buffer, mtl_event *event, uint64_t value)
+{
+   @autoreleasepool {
+      id<MTLCommandBuffer> cmd_buf = (id<MTLCommandBuffer>)command_buffer;
+      [cmd_buf encodeWaitForEvent:(id<MTLEvent>)event value:value];
+   }
+}
+
+void
+mtl_legacy_command_buffer_encode_signal_event(
+   mtl_legacy_command_buffer *command_buffer, mtl_event *event, uint64_t value)
+{
+   @autoreleasepool {
+      id<MTLCommandBuffer> cmd_buf = (id<MTLCommandBuffer>)command_buffer;
+      [cmd_buf encodeSignalEvent:(id<MTLEvent>)event value:value];
+   }
+}
+
+void
+mtl_legacy_command_buffer_commit(mtl_legacy_command_buffer *command_buffer)
+{
+   @autoreleasepool {
+      id<MTLCommandBuffer> cmd_buf = (id<MTLCommandBuffer>)command_buffer;
+      [cmd_buf commit];
+   }
+}
