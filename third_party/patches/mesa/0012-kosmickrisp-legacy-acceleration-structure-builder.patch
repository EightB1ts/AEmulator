+/* Number of MTL4 command buffers already closed and queued for submission. A
+ * legacy acceleration-structure pass records this at the moment it opens, and
+ * kk_queue_submit uses it to decide how much of the MTL4 stream must retire
+ * before the pass runs. */
+static uint32_t
+kk_mtl4_cmd_buf_count(struct kk_cmd_buffer *cmd)
+{
+   return util_dynarray_num_elements(&cmd->submit_cmd_bufs,
+                                     mtl_command_buffer *);
+}
+
+void
+cs_end_acceleration_structure_pass(struct kk_cmd_buffer *cmd)
+{
+   if (cmd->as_open.cmd_buf == NULL)
+      return;
+
+   /* After the last encoder has ended, so that the GPU signals once the whole
+    * pass has run rather than at some point inside it. */
+   mtl_legacy_command_buffer_encode_signal_event(
+      cmd->as_open.cmd_buf, cmd->as_open.event, KK_AS_PASS_EVENT_DONE);
+
+   util_dynarray_append_typed(&cmd->as_passes, struct kk_as_pass,
+                              cmd->as_open);
+   cmd->as_open = (struct kk_as_pass){0};
+}
+
+mtl_acceleration_structure_encoder *
+cs_get_acceleration_structure(struct kk_cmd_buffer *cmd)
+{
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+
+   /* Not an assert: a device that never enabled VK_KHR_acceleration_structure
+    * has no legacy queue, and reaching here means the application built an
+    * acceleration structure without the extension that defines them. */
+   if (dev->as_queue == NULL)
+      return NULL;
+
+   /* Acceleration-structure commands are outside-render-pass-only in Vulkan, and
+    * the pass accounting below depends on that: cs_end() would otherwise tear
+    * down a live render encoder. */
+   assert(cmd->gfx.encoder == NULL);
+
+   /* An open pass can only be extended while nothing else has been recorded
+    * since it opened. Its position in the stream is ::mtl4_prefix, fixed then, so
+    * any MTL4 encoder started or command buffer closed since would have to run
+    * before a pass that must actually run after it. */
+   if (cmd->as_open.cmd_buf != NULL &&
+       (cmd->pre_gfx->encoder != NULL || cmd->post_gfx->encoder != NULL ||
+        kk_mtl4_cmd_buf_count(cmd) != cmd->as_open.mtl4_prefix))
+      cs_end_acceleration_structure_pass(cmd);
+
+   if (cmd->as_open.cmd_buf == NULL) {
+      /* Close the open MTL4 encoder so its command buffer is counted into the
+       * prefix. Twice, for the same reason every other flush site does it. */
+      cs_end(cmd);
+      cs_end(cmd);
+
+      mtl_event *event = mtl_new_event(dev->mtl_handle);
+      mtl_legacy_command_buffer *cmd_buf =
+         event ? mtl_legacy_command_queue_new_command_buffer(dev->as_queue)
+               : NULL;
+
+      if (cmd_buf == NULL) {
+         mtl_release(event);
+         return NULL;
+      }
+
+      mtl_legacy_command_buffer_use_residency_set(cmd_buf,
+                                                  dev->residency_set.handle);
+
+      /* Before the first encoder exists: a legacy command buffer orders event
+       * operations against its encoders by call order, so a wait added later
+       * would wait after the work instead of before it. */
+      mtl_legacy_command_buffer_encode_wait_for_event(cmd_buf, event,
+                                                      KK_AS_PASS_EVENT_READY);
+
+      cmd->as_open = (struct kk_as_pass){
+         .cmd_buf = cmd_buf,
+         .event = event,
+         .mtl4_prefix = kk_mtl4_cmd_buf_count(cmd),
+      };
+   }
+
+   return mtl_new_acceleration_structure_command_encoder(cmd->as_open.cmd_buf);
+}
+
+void
+cs_end_acceleration_structure(mtl_acceleration_structure_encoder *encoder)
+{
+   mtl_end_acceleration_structure_encoding(encoder);
+   mtl_release(encoder);
+}
