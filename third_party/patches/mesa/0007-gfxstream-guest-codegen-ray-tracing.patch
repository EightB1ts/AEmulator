+        lenAccessLhs = self.lenAccessorLhs(vulkanType)
+        lenAccessGuardLhs = self.lenAccessorGuardLhs(vulkanType)
+        levels = self.pointerArrayLevels(vulkanType, parentVarName=self.inputVars[0])
