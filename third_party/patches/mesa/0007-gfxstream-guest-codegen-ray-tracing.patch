+    # The INNER length of a `T* const*` array — how many elements each pointer points at — resolved
+    # the same way a `len` is: the expression may name another member of the same struct, or another
+    # parameter of the same command, or be neither (a literal "1", or "pInfos[i].geometryCount",
+    # which is a subscript into a sibling parameter and is already valid C where it is emitted).
+    #
+    # `loopVar` names the generated outer loop variable, because an inner length is allowed to
+    # depend on the outer index. Returns None when the array is not a marshalable array of
+    # pointers, which is what makes iterateVulkanType refuse it.
+    def makeInnerLengthAccess(self, vulkanType, parentVarName="parent", loopVar=None):
+        if loopVar is None:
+            lenExpr = vulkanType.getInnerLengthExpression()
+        else:
+            lenExpr = vulkanType.getInnerLengthExpression(loopVar)
+
+        if lenExpr is None:
+            return None
+
+        if isinstance(vulkanType.parent, VulkanCompoundType):
+            if vulkanType.parent.getMember(lenExpr):
+                return "%s->%s" % (parentVarName, lenExpr)
+            return lenExpr
+
+        if isinstance(vulkanType.parent, VulkanAPI):
+            lenExprInfo = vulkanType.parent.getParameter(lenExpr)
+            if lenExprInfo is None:
+                return lenExpr
+            deref = "*" if lenExprInfo.pointerIndirectionLevels > 0 else ""
+            return "(%s(%s))" % (deref, lenExpr)
+
+        return lenExpr
+
+    def generalInnerLengthAccess(self, vulkanType, parentVarName="parent", loopVar=None):
+        return self.makeInnerLengthAccess(
+            vulkanType, parentVarName=parentVarName, loopVar=loopVar)
