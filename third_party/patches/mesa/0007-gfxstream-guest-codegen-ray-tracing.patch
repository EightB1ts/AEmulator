+            accessRhs, levels["elemPtrDeclNonConst"], self.poolVarName,
+            lenAccessLhs, levels["elemPtrDecl"]))
+
+        self.cgen.beginFor("uint32_t %s = 0" % outerVar,
+                           "%s < (uint32_t)%s" % (outerVar, lenAccessLhs),
+                           "++%s" % outerVar)
+
+        srcVar = self.cgen.var()
+        dstVar = self.cgen.var()
+        self.cgen.stmt("%s %s = %s[%s]" % (
+            levels["elemPtrDecl"], srcVar, accessLhs, outerVar))
+        self.cgen.stmt("%s %s = nullptr" % (levels["elemPtrDeclNonConst"], dstVar))
+
+        self.cgen.beginIf(srcVar)
+        self.cgen.stmt("%s = (%s)%s->alloc(%s * sizeof(%s))" % (
+            dstVar, levels["elemPtrDeclNonConst"], self.poolVarName,
