+ * Copyright 2025 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef KK_ACCELERATION_STRUCTURE_H
+#define KK_ACCELERATION_STRUCTURE_H 1
+
+#include "kk_private.h"
+
+#include "kosmickrisp/bridge/mtl_types.h"
+
+#include "vk_object.h"
+
+struct kk_buffer;
+struct kk_device;
+
+/* A VK_KHR_acceleration_structure object backed by an MTLAccelerationStructure.
+ *
+ * Vulkan hands us a VkBuffer range to store the structure in; Metal owns its
+ * own storage object. When the backing memory came from a heap we suballocate
+ * the Metal structure out of that same heap at the same offset, so the Vulkan
+ * aliasing rules hold. Otherwise we fall back to a standalone device
+ * allocation, which is still correct for rendering — nothing in Metal lets a
+ * shader reach an acceleration structure through a raw address anyway.
+ */
+struct kk_acceleration_structure {
+   struct vk_object_base base;
+
+   VkAccelerationStructureTypeKHR type;
+
+   /* Storage the application asked for. buffer may be NULL. */
+   struct kk_buffer *buffer;
+   uint64_t offset_B;
+   uint64_t size_B;
+
+   mtl_acceleration_structure *mtl_handle;
+
+   /* MTLResourceID of mtl_handle. This is what
+    * vkGetAccelerationStructureDeviceAddressKHR reports, which makes a Vulkan
+    * instance's accelerationStructureReference already be the handle Metal
+    * wants in MTLIndirectAccelerationStructureInstanceDescriptor. */
+   uint64_t gpu_resource_id;
+
+   /* Set when mtl_handle is a standalone allocation and therefore has to carry
+    * its own residency-set membership. Heap suballocations ride on the heap. */
+   bool standalone;
+};
+
+VK_DEFINE_NONDISP_HANDLE_CASTS(kk_acceleration_structure, base,
+                               VkAccelerationStructureKHR,
+                               VK_OBJECT_TYPE_ACCELERATION_STRUCTURE_KHR)
+
+#endif /* KK_ACCELERATION_STRUCTURE_H */
