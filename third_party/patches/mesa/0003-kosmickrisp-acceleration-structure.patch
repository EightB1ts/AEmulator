diff --git a/src/kosmickrisp/bridge/mtl_acceleration_structure.h b/src/kosmickrisp/bridge/mtl_acceleration_structure.h
new file mode 100644
index 0000000..e05793d
--- /dev/null
+++ b/src/kosmickrisp/bridge/mtl_acceleration_structure.h
@@ -0,0 +1,158 @@
+/*
+ * Copyright 2025 LunarG, Inc.
+ * Copyright 2025 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef MTL_ACCELERATION_STRUCTURE_H
+#define MTL_ACCELERATION_STRUCTURE_H 1
+
+#include "mtl_types.h"
+
+#include <stdbool.h>
+#include <stdint.h>
+
+/* Metal 4 acceleration structure descriptors take GPU addresses
+ * (MTL4BufferRange) rather than MTLBuffer objects, which lines up exactly with
+ * the VkDeviceOrHostAddressKHR the Vulkan builders hand us. A length of
+ * MTL_BUFFER_RANGE_WHOLE means "to the end of the owning buffer".
+ */
+#define MTL_BUFFER_RANGE_WHOLE ((uint64_t)-1)
+
+struct mtl_buffer_range {
+   uint64_t address;
+   uint64_t length_B;
+};
+
+enum mtl_acceleration_structure_geometry_type {
+   MTL_ACCELERATION_STRUCTURE_GEOMETRY_TYPE_TRIANGLES = 0,
+   MTL_ACCELERATION_STRUCTURE_GEOMETRY_TYPE_BOUNDING_BOXES = 1,
+};
+
+struct mtl_acceleration_structure_geometry {
+   enum mtl_acceleration_structure_geometry_type type;
+
+   bool opaque;
+   bool allow_duplicate_intersection_function_invocation;
+   uint32_t intersection_function_table_offset;
+
+   /* Optional per-primitive payload. This is how VK_KHR_ray_tracing_position_fetch
+    * gets its triangle positions back, since MSL cannot read them from the
+    * acceleration structure itself. Zero address disables it. */
+   struct mtl_buffer_range primitive_data;
+   uint32_t primitive_data_stride_B;
+   uint32_t primitive_data_element_size_B;
+
+   union {
+      struct {
+         struct mtl_buffer_range vertex;
+         enum mtl_attribute_format vertex_format;
+         uint64_t vertex_stride_B;
+
+         /* Zero address means "not indexed". */
+         struct mtl_buffer_range index;
+         enum mtl_index_type index_type;
+
+         /* Zero address means "no transform". */
+         struct mtl_buffer_range transform;
+         enum mtl_matrix_layout transform_layout;
+
+         uint32_t triangle_count;
+      } triangles;
+
+      struct {
+         struct mtl_buffer_range bounding_box;
+         uint64_t bounding_box_stride_B;
+         uint32_t bounding_box_count;
+      } bounding_boxes;
+   };
+};
+
+struct mtl_instance_acceleration_structure_geometry {
+   struct mtl_buffer_range instance_descriptors;
+   uint64_t instance_descriptor_stride_B;
+   uint32_t instance_count;
+   enum mtl_acceleration_structure_instance_descriptor_type descriptor_type;
+   enum mtl_matrix_layout transform_layout;
+};
+
+struct mtl_acceleration_structure_sizes {
+   uint64_t acceleration_structure_size_B;
+   uint64_t build_scratch_buffer_size_B;
+   uint64_t refit_scratch_buffer_size_B;
+};
+
+/* Descriptors. Both are retained; release them with mtl_release(). */
+mtl_acceleration_structure_descriptor *
+mtl_new_primitive_acceleration_structure_descriptor(
+   const struct mtl_acceleration_structure_geometry *geometries,
+   uint32_t geometry_count, enum mtl_acceleration_structure_usage usage);
+
+mtl_acceleration_structure_descriptor *
+mtl_new_instance_acceleration_structure_descriptor(
+   const struct mtl_instance_acceleration_structure_geometry *geometry,
+   enum mtl_acceleration_structure_usage usage);
+
+/* -[MTLDevice accelerationStructureSizesWithDescriptor:] is the pre-Metal-4
+ * query and it does not understand MTL4InstanceAccelerationStructureDescriptor
+ * — it sends -motionKeyframeCount, which that class does not implement, and
+ * throws. The legacy MTLIndirectInstanceAccelerationStructureDescriptor
+ * describes the same thing for sizing purposes, so use this for the size query
+ * and the MTL4 descriptor for the build itself. */
+mtl_acceleration_structure_descriptor *
+mtl_new_instance_acceleration_structure_sizing_descriptor(
+   const struct mtl_instance_acceleration_structure_geometry *geometry,
+   enum mtl_acceleration_structure_usage usage);
+
+/* Queries */
+struct mtl_acceleration_structure_sizes mtl_device_acceleration_structure_sizes(
+   mtl_device *device, mtl_acceleration_structure_descriptor *descriptor);
+
+void mtl_device_heap_acceleration_structure_size_and_align(
+   mtl_device *device, uint64_t size_B, uint64_t *size_out_B,
+   uint64_t *align_out_B);
+
+/* Creation. Retained; release with mtl_release(). */
+mtl_acceleration_structure *
+mtl_new_acceleration_structure_with_size(mtl_device *device, uint64_t size_B);
+
+mtl_acceleration_structure *
+mtl_heap_new_acceleration_structure_with_size(mtl_heap *heap, uint64_t size_B,
+                                              uint64_t offset_B);
+
+/* The 64-bit MTLResourceID handle. This is what a shader needs in order to bind
+ * the structure, and what KosmicKrisp reports as the Vulkan device address of
+ * an acceleration structure. */
+uint64_t mtl_acceleration_structure_get_gpu_resource_id(
+   mtl_acceleration_structure *acceleration_structure);
+
+uint64_t mtl_acceleration_structure_get_size(
+   mtl_acceleration_structure *acceleration_structure);
+
+/* Encoding. In Metal 4 the acceleration structure commands live on the compute
+ * encoder, so there is no separate encoder object to manage. */
+void mtl_build_acceleration_structure(
+   mtl_compute_encoder *encoder,
+   mtl_acceleration_structure *acceleration_structure,
+   mtl_acceleration_structure_descriptor *descriptor,
+   struct mtl_buffer_range scratch);
+
+void mtl_refit_acceleration_structure(
+   mtl_compute_encoder *encoder, mtl_acceleration_structure *source,
+   mtl_acceleration_structure_descriptor *descriptor,
+   mtl_acceleration_structure *destination, struct mtl_buffer_range scratch);
+
+void mtl_copy_acceleration_structure(mtl_compute_encoder *encoder,
+                                     mtl_acceleration_structure *source,
+                                     mtl_acceleration_structure *destination);
+
+void mtl_copy_and_compact_acceleration_structure(
+   mtl_compute_encoder *encoder, mtl_acceleration_structure *source,
+   mtl_acceleration_structure *destination);
+
+void mtl_write_compacted_acceleration_structure_size(
+   mtl_compute_encoder *encoder,
+   mtl_acceleration_structure *acceleration_structure,
+   struct mtl_buffer_range destination);
+
+#endif /* MTL_ACCELERATION_STRUCTURE_H */
diff --git a/src/kosmickrisp/bridge/mtl_acceleration_structure.m b/src/kosmickrisp/bridge/mtl_acceleration_structure.m
new file mode 100644
index 0000000..8f21ad9
--- /dev/null
+++ b/src/kosmickrisp/bridge/mtl_acceleration_structure.m
@@ -0,0 +1,288 @@
+/*
+ * Copyright 2025 LunarG, Inc.
+ * Copyright 2025 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "mtl_acceleration_structure.h"
+
+#include <Metal/MTL4AccelerationStructure.h>
+#include <Metal/MTL4ComputeCommandEncoder.h>
+#include <Metal/MTLAccelerationStructure.h>
+#include <Metal/MTLDevice.h>
+#include <Metal/MTLHeap.h>
+
+static MTL4BufferRange
+mtl_to_buffer_range(struct mtl_buffer_range range)
+{
+   return MTL4BufferRangeMake(range.address, range.length_B);
+}
+
+static MTL4AccelerationStructureGeometryDescriptor *
+mtl_new_geometry_descriptor(const struct mtl_acceleration_structure_geometry *geometry)
+{
+   MTL4AccelerationStructureGeometryDescriptor *descriptor = nil;
+
+   if (geometry->type == MTL_ACCELERATION_STRUCTURE_GEOMETRY_TYPE_TRIANGLES) {
+      MTL4AccelerationStructureTriangleGeometryDescriptor *triangles =
+         [MTL4AccelerationStructureTriangleGeometryDescriptor new];
+
+      triangles.vertexBuffer = mtl_to_buffer_range(geometry->triangles.vertex);
+      triangles.vertexFormat = (MTLAttributeFormat)geometry->triangles.vertex_format;
+      triangles.vertexStride = geometry->triangles.vertex_stride_B;
+      triangles.triangleCount = geometry->triangles.triangle_count;
+
+      if (geometry->triangles.index.address) {
+         triangles.indexBuffer = mtl_to_buffer_range(geometry->triangles.index);
+         triangles.indexType = (MTLIndexType)geometry->triangles.index_type;
+      }
+
+      if (geometry->triangles.transform.address) {
+         triangles.transformationMatrixBuffer =
+            mtl_to_buffer_range(geometry->triangles.transform);
+         triangles.transformationMatrixLayout =
+            (MTLMatrixLayout)geometry->triangles.transform_layout;
+      }
+
+      descriptor = triangles;
+   } else {
+      MTL4AccelerationStructureBoundingBoxGeometryDescriptor *boxes =
+         [MTL4AccelerationStructureBoundingBoxGeometryDescriptor new];
+
+      boxes.boundingBoxBuffer =
+         mtl_to_buffer_range(geometry->bounding_boxes.bounding_box);
+      boxes.boundingBoxStride = geometry->bounding_boxes.bounding_box_stride_B;
+      boxes.boundingBoxCount = geometry->bounding_boxes.bounding_box_count;
+
+      descriptor = boxes;
+   }
+
+   descriptor.opaque = geometry->opaque;
+   descriptor.allowDuplicateIntersectionFunctionInvocation =
+      geometry->allow_duplicate_intersection_function_invocation;
+   descriptor.intersectionFunctionTableOffset =
+      geometry->intersection_function_table_offset;
+
+   if (geometry->primitive_data.address) {
+      descriptor.primitiveDataBuffer = mtl_to_buffer_range(geometry->primitive_data);
+      descriptor.primitiveDataStride = geometry->primitive_data_stride_B;
+      descriptor.primitiveDataElementSize = geometry->primitive_data_element_size_B;
+   }
+
+   return descriptor;
+}
+
+mtl_acceleration_structure_descriptor *
+mtl_new_primitive_acceleration_structure_descriptor(
+   const struct mtl_acceleration_structure_geometry *geometries,
+   uint32_t geometry_count, enum mtl_acceleration_structure_usage usage)
+{
+   @autoreleasepool {
+      MTL4PrimitiveAccelerationStructureDescriptor *descriptor =
+         [MTL4PrimitiveAccelerationStructureDescriptor new];
+
+      NSMutableArray<MTL4AccelerationStructureGeometryDescriptor *> *array =
+         [[[NSMutableArray alloc] initWithCapacity:geometry_count] autorelease];
+
+      for (uint32_t i = 0u; i < geometry_count; ++i) {
+         MTL4AccelerationStructureGeometryDescriptor *geometry =
+            [mtl_new_geometry_descriptor(&geometries[i]) autorelease];
+         [array addObject:geometry];
+      }
+
+      descriptor.geometryDescriptors = array;
+      descriptor.usage = (MTLAccelerationStructureUsage)usage;
+
+      return descriptor;
+   }
+}
+
+mtl_acceleration_structure_descriptor *
+mtl_new_instance_acceleration_structure_descriptor(
+   const struct mtl_instance_acceleration_structure_geometry *geometry,
+   enum mtl_acceleration_structure_usage usage)
+{
+   @autoreleasepool {
+      MTL4InstanceAccelerationStructureDescriptor *descriptor =
+         [MTL4InstanceAccelerationStructureDescriptor new];
+
+      descriptor.instanceDescriptorBuffer =
+         mtl_to_buffer_range(geometry->instance_descriptors);
+      descriptor.instanceDescriptorStride = geometry->instance_descriptor_stride_B;
+      descriptor.instanceCount = geometry->instance_count;
+      descriptor.instanceDescriptorType =
+         (MTLAccelerationStructureInstanceDescriptorType)geometry->descriptor_type;
+      descriptor.instanceTransformationMatrixLayout =
+         (MTLMatrixLayout)geometry->transform_layout;
+      descriptor.usage = (MTLAccelerationStructureUsage)usage;
+
+      return descriptor;
+   }
+}
+
+mtl_acceleration_structure_descriptor *
+mtl_new_instance_acceleration_structure_sizing_descriptor(
+   const struct mtl_instance_acceleration_structure_geometry *geometry,
+   enum mtl_acceleration_structure_usage usage)
+{
+   @autoreleasepool {
+      MTLIndirectInstanceAccelerationStructureDescriptor *descriptor =
+         [MTLIndirectInstanceAccelerationStructureDescriptor new];
+
+      descriptor.instanceDescriptorStride = geometry->instance_descriptor_stride_B;
+      descriptor.maxInstanceCount = geometry->instance_count;
+      descriptor.instanceDescriptorType =
+         (MTLAccelerationStructureInstanceDescriptorType)geometry->descriptor_type;
+      descriptor.instanceTransformationMatrixLayout =
+         (MTLMatrixLayout)geometry->transform_layout;
+      descriptor.usage = (MTLAccelerationStructureUsage)usage;
+
+      return descriptor;
+   }
+}
+
+struct mtl_acceleration_structure_sizes
+mtl_device_acceleration_structure_sizes(
+   mtl_device *device, mtl_acceleration_structure_descriptor *descriptor)
+{
+   @autoreleasepool {
+      id<MTLDevice> dev = (id<MTLDevice>)device;
+      MTLAccelerationStructureDescriptor *desc =
+         (MTLAccelerationStructureDescriptor *)descriptor;
+
+      MTLAccelerationStructureSizes sizes =
+         [dev accelerationStructureSizesWithDescriptor:desc];
+
+      return (struct mtl_acceleration_structure_sizes){
+         .acceleration_structure_size_B = sizes.accelerationStructureSize,
+         .build_scratch_buffer_size_B = sizes.buildScratchBufferSize,
+         .refit_scratch_buffer_size_B = sizes.refitScratchBufferSize,
+      };
+   }
+}
+
+void
+mtl_device_heap_acceleration_structure_size_and_align(mtl_device *device,
+                                                      uint64_t size_B,
+                                                      uint64_t *size_out_B,
+                                                      uint64_t *align_out_B)
+{
+   @autoreleasepool {
+      id<MTLDevice> dev = (id<MTLDevice>)device;
+      MTLSizeAndAlign size_align =
+         [dev heapAccelerationStructureSizeAndAlignWithSize:size_B];
+
+      *size_out_B = size_align.size;
+      *align_out_B = size_align.align;
+   }
+}
+
+mtl_acceleration_structure *
+mtl_new_acceleration_structure_with_size(mtl_device *device, uint64_t size_B)
+{
+   @autoreleasepool {
+      id<MTLDevice> dev = (id<MTLDevice>)device;
+      return [dev newAccelerationStructureWithSize:size_B];
+   }
+}
+
+mtl_acceleration_structure *
+mtl_heap_new_acceleration_structure_with_size(mtl_heap *heap, uint64_t size_B,
+                                              uint64_t offset_B)
+{
+   @autoreleasepool {
+      id<MTLHeap> mtl_heap = (id<MTLHeap>)heap;
+      return [mtl_heap newAccelerationStructureWithSize:size_B offset:offset_B];
+   }
+}
+
+uint64_t
+mtl_acceleration_structure_get_gpu_resource_id(
+   mtl_acceleration_structure *acceleration_structure)
+{
+   @autoreleasepool {
+      id<MTLAccelerationStructure> as =
+         (id<MTLAccelerationStructure>)acceleration_structure;
+      return as.gpuResourceID._impl;
+   }
+}
+
+uint64_t
+mtl_acceleration_structure_get_size(
+   mtl_acceleration_structure *acceleration_structure)
+{
+   @autoreleasepool {
+      id<MTLAccelerationStructure> as =
+         (id<MTLAccelerationStructure>)acceleration_structure;
+      return as.size;
+   }
+}
+
+void
+mtl_build_acceleration_structure(
+   mtl_compute_encoder *encoder,
+   mtl_acceleration_structure *acceleration_structure,
+   mtl_acceleration_structure_descriptor *descriptor,
+   struct mtl_buffer_range scratch)
+{
+   @autoreleasepool {
+      id<MTL4ComputeCommandEncoder> enc = (id<MTL4ComputeCommandEncoder>)encoder;
+      [enc buildAccelerationStructure:(id<MTLAccelerationStructure>)acceleration_structure
+                           descriptor:(MTL4AccelerationStructureDescriptor *)descriptor
+                        scratchBuffer:mtl_to_buffer_range(scratch)];
+   }
+}
+
+void
+mtl_refit_acceleration_structure(mtl_compute_encoder *encoder,
+                                 mtl_acceleration_structure *source,
+                                 mtl_acceleration_structure_descriptor *descriptor,
+                                 mtl_acceleration_structure *destination,
+                                 struct mtl_buffer_range scratch)
+{
+   @autoreleasepool {
+      id<MTL4ComputeCommandEncoder> enc = (id<MTL4ComputeCommandEncoder>)encoder;
+      [enc refitAccelerationStructure:(id<MTLAccelerationStructure>)source
+                           descriptor:(MTL4AccelerationStructureDescriptor *)descriptor
+                          destination:(id<MTLAccelerationStructure>)destination
+                        scratchBuffer:mtl_to_buffer_range(scratch)];
+   }
+}
+
+void
+mtl_copy_acceleration_structure(mtl_compute_encoder *encoder,
+                                mtl_acceleration_structure *source,
+                                mtl_acceleration_structure *destination)
+{
+   @autoreleasepool {
+      id<MTL4ComputeCommandEncoder> enc = (id<MTL4ComputeCommandEncoder>)encoder;
+      [enc copyAccelerationStructure:(id<MTLAccelerationStructure>)source
+             toAccelerationStructure:(id<MTLAccelerationStructure>)destination];
+   }
+}
+
+void
+mtl_copy_and_compact_acceleration_structure(
+   mtl_compute_encoder *encoder, mtl_acceleration_structure *source,
+   mtl_acceleration_structure *destination)
+{
+   @autoreleasepool {
+      id<MTL4ComputeCommandEncoder> enc = (id<MTL4ComputeCommandEncoder>)encoder;
+      [enc copyAndCompactAccelerationStructure:(id<MTLAccelerationStructure>)source
+                       toAccelerationStructure:(id<MTLAccelerationStructure>)destination];
+   }
+}
+
+void
+mtl_write_compacted_acceleration_structure_size(
+   mtl_compute_encoder *encoder,
+   mtl_acceleration_structure *acceleration_structure,
+   struct mtl_buffer_range destination)
+{
+   @autoreleasepool {
+      id<MTL4ComputeCommandEncoder> enc = (id<MTL4ComputeCommandEncoder>)encoder;
+      [enc writeCompactedAccelerationStructureSize:
+              (id<MTLAccelerationStructure>)acceleration_structure
+                                          toBuffer:mtl_to_buffer_range(destination)];
+   }
+}
