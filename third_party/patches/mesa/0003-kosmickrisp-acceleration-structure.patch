+   MTL_ATTRIBUTE_FORMAT_CHAR2_NORMALIZED = 10,
+   MTL_ATTRIBUTE_FORMAT_CHAR3_NORMALIZED = 11,
+   MTL_ATTRIBUTE_FORMAT_CHAR4_NORMALIZED = 12,
