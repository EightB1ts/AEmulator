diff --git a/src/kosmickrisp/libkk/kk_acceleration_structure.cl b/src/kosmickrisp/libkk/kk_acceleration_structure.cl
new file mode 100644
index 0000000..39b5a40
--- /dev/null
+++ b/src/kosmickrisp/libkk/kk_acceleration_structure.cl
@@ -0,0 +1,89 @@
+/*
+ * Copyright 2025 LunarG, Inc.
+ * Copyright 2025 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+#include "compiler/libcl/libcl_vk.h"
+
+#include "kk_acceleration_structure.h"
+
+/* Rewrite an application-provided array of VkAccelerationStructureInstanceKHR
+ * into the MTLIndirectAccelerationStructureInstanceDescriptor layout Metal 4
+ * expects from MTL4InstanceAccelerationStructureDescriptor.
+ *
+ * This has to happen on the GPU timeline: the instance array is allowed to be
+ * written by a preceding dispatch, so reading it on the CPU at record time
+ * would be wrong.
+ *
+ * `src` may either be a tightly packed array of instances (stride
+ * KK_VK_AS_INSTANCE_SIZE_B) or, when the build used arrayOfPointers, an array
+ * of 64-bit device addresses each pointing at one instance.
+ *
+ * `accelerationStructureReference` is already the Metal resource handle,
+ * because that is exactly what kk_GetAccelerationStructureDeviceAddressKHR
+ * returns, so it copies straight across.
+ */
+KERNEL(64)
+libkk_convert_as_instances(global uint32_t *dst, uint64_t src,
+                           uint32_t src_stride_B, uint32_t array_of_pointers,
+                           uint32_t count)
+{
+   uint32_t id = cl_global_id.x;
+   if (id >= count)
+      return;
+
+   uint64_t src_addr;
+   if (array_of_pointers) {
+      global uint64_t *pointers = (global uint64_t *)src;
+      src_addr = pointers[id];
+   } else {
+      src_addr = src + (uint64_t)id * (uint64_t)src_stride_B;
+   }
+
+   global uint32_t *in = (global uint32_t *)src_addr;
+   global uint32_t *out = dst + id * (KK_MTL_AS_INSTANCE_SIZE_B / 4u);
+
+   /* VkTransformMatrixKHR is a row-major float[3][4] and we build the
+    * structure with MTLMatrixLayoutRowMajor, so the 48 bytes copy verbatim. */
+   for (uint32_t i = 0u; i < 12u; ++i)
+      out[i] = in[i];
+
+   uint32_t custom_index_and_mask = in[12];
+   uint32_t sbt_offset_and_flags = in[13];
+   uint32_t reference_lo = in[14];
+   uint32_t reference_hi = in[15];
+
+   uint32_t vk_flags = sbt_offset_and_flags >> 24u;
+   uint32_t options = 0u;
+
+   if (vk_flags & KK_VK_INSTANCE_TRIANGLE_FACING_CULL_DISABLE)
+      options |= KK_MTL_INSTANCE_DISABLE_TRIANGLE_CULLING;
+
+   /* Vulkan's default winding for a front face is counter-clockwise and
+    * TRIANGLE_FLIP_FACING inverts it; Metal's default is clockwise and the
+    * option opts into counter-clockwise. So the bit is inverted. */
+   if (!(vk_flags & KK_VK_INSTANCE_TRIANGLE_FLIP_FACING))
+      options |= KK_MTL_INSTANCE_FRONT_FACING_CCW;
+
+   if (vk_flags & KK_VK_INSTANCE_FORCE_OPAQUE)
+      options |= KK_MTL_INSTANCE_OPAQUE;
+
+   if (vk_flags & KK_VK_INSTANCE_FORCE_NO_OPAQUE)
+      options |= KK_MTL_INSTANCE_NON_OPAQUE;
+
+   out[12] = options;
+   out[13] = custom_index_and_mask >> 24u;       /* mask */
+   out[14] = sbt_offset_and_flags & 0xFFFFFFu;   /* intersection fn table off */
+   out[15] = custom_index_and_mask & 0xFFFFFFu;  /* userID == custom index */
+   out[16] = reference_lo;                       /* accelerationStructureID */
+   out[17] = reference_hi;
+}
+
+/* Write a 64-bit value known at record time to a device address. Used to fill
+ * VK_QUERY_TYPE_ACCELERATION_STRUCTURE_SERIALIZATION_SIZE_KHR and friends,
+ * where the answer does not depend on anything the GPU computes. */
+KERNEL(1)
+libkk_write_u64(global uint64_t *address, uint64_t value)
+{
+   *address = value;
+}
diff --git a/src/kosmickrisp/libkk/kk_acceleration_structure.h b/src/kosmickrisp/libkk/kk_acceleration_structure.h
new file mode 100644
index 0000000..b376b3a
--- /dev/null
+++ b/src/kosmickrisp/libkk/kk_acceleration_structure.h
@@ -0,0 +1,45 @@
+/*
+ * Copyright 2025 LunarG, Inc.
+ * Copyright 2025 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef LIBKK_ACCELERATION_STRUCTURE_H
+#define LIBKK_ACCELERATION_STRUCTURE_H
+
+/* Shared between the driver (kk_acceleration_structure.c) and the
+ * instance-conversion kernel (kk_acceleration_structure.cl).
+ *
+ * A Vulkan VkAccelerationStructureInstanceKHR and a Metal
+ * MTLIndirectAccelerationStructureInstanceDescriptor carry the same
+ * information but in a different order, so a TLAS build has to shuffle the
+ * application's instance array into Metal's layout before Metal can consume it.
+ * We ask Metal for MTLMatrixLayoutRowMajor so the 3x4 transform itself copies
+ * across verbatim.
+ */
+
+/* sizeof(VkAccelerationStructureInstanceKHR) */
+#define KK_VK_AS_INSTANCE_SIZE_B 64u
+
+/* sizeof(MTLIndirectAccelerationStructureInstanceDescriptor):
+ *    packed_float4x3 transformationMatrix;  48
+ *    uint32_t        options;                4
+ *    uint32_t        mask;                   4
+ *    uint32_t        intersectionFunctionTableOffset; 4
+ *    uint32_t        userID;                 4
+ *    MTLResourceID   accelerationStructureID; 8
+ */
+#define KK_MTL_AS_INSTANCE_SIZE_B 72u
+
+/* VkGeometryInstanceFlagBitsKHR */
+#define KK_VK_INSTANCE_TRIANGLE_FACING_CULL_DISABLE 0x1u
+#define KK_VK_INSTANCE_TRIANGLE_FLIP_FACING         0x2u
+#define KK_VK_INSTANCE_FORCE_OPAQUE                 0x4u
+#define KK_VK_INSTANCE_FORCE_NO_OPAQUE              0x8u
+
+/* MTLAccelerationStructureInstanceOptions */
+#define KK_MTL_INSTANCE_DISABLE_TRIANGLE_CULLING 0x1u
+#define KK_MTL_INSTANCE_FRONT_FACING_CCW         0x2u
+#define KK_MTL_INSTANCE_OPAQUE                   0x4u
+#define KK_MTL_INSTANCE_NON_OPAQUE               0x8u
+
+#endif /* LIBKK_ACCELERATION_STRUCTURE_H */
