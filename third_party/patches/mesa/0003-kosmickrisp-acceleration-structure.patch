diff --git a/src/kosmickrisp/vulkan/kk_acceleration_structure.c b/src/kosmickrisp/vulkan/kk_acceleration_structure.c
new file mode 100644
index 0000000..e6c8b4a
--- /dev/null
+++ b/src/kosmickrisp/vulkan/kk_acceleration_structure.c
@@ -0,0 +1,763 @@
+/*
+ * Copyright 2025 LunarG, Inc.
+ * Copyright 2025 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "kk_acceleration_structure.h"
+
+#include "kk_buffer.h"
+#include "kk_cmd_buffer.h"
+#include "kk_device.h"
+#include "kk_entrypoints.h"
+#include "kk_physical_device.h"
+#include "kk_query_pool.h"
+
+#include "kosmickrisp/bridge/mtl_bridge.h"
+
+#include "kosmickrisp/libkk/kk_acceleration_structure.h"
+
+#include "libkk_shaders.h"
+
+#include "util/u_math.h"
+
+/* Metal wants a non-zero buffer address in every descriptor it inspects, but a
+ * size query never dereferences one. Hand it something obviously bogus and
+ * suitably aligned rather than 0. */
+#define KK_AS_SIZE_QUERY_DUMMY_ADDR 0x1000ull
+
+/* Scratch handed to a TLAS build is laid out as
+ *    [0, instance_bytes)                        converted instance descriptors
+ *    [align(instance_bytes, 256), ...)          Metal's own scratch
+ * so that one Vulkan scratch allocation covers both. */
+#define KK_AS_SCRATCH_ALIGNMENT 256u
+
+static uint64_t
+kk_as_instance_scratch_size(uint64_t instance_count)
+{
+   return align64(instance_count * KK_MTL_AS_INSTANCE_SIZE_B,
+                  KK_AS_SCRATCH_ALIGNMENT);
+}
+
+static enum mtl_attribute_format
+kk_as_vertex_format(VkFormat format)
+{
+   switch (format) {
+   case VK_FORMAT_R32G32_SFLOAT:
+      return MTL_ATTRIBUTE_FORMAT_FLOAT2;
+   case VK_FORMAT_R32G32B32_SFLOAT:
+      return MTL_ATTRIBUTE_FORMAT_FLOAT3;
+   case VK_FORMAT_R32G32B32A32_SFLOAT:
+      return MTL_ATTRIBUTE_FORMAT_FLOAT4;
+   case VK_FORMAT_R16G16_SFLOAT:
+      return MTL_ATTRIBUTE_FORMAT_HALF2;
+   case VK_FORMAT_R16G16B16_SFLOAT:
+      return MTL_ATTRIBUTE_FORMAT_HALF3;
+   case VK_FORMAT_R16G16B16A16_SFLOAT:
+      return MTL_ATTRIBUTE_FORMAT_HALF4;
+   case VK_FORMAT_R16G16_SNORM:
+      return MTL_ATTRIBUTE_FORMAT_SHORT2_NORMALIZED;
+   case VK_FORMAT_R16G16B16_SNORM:
+      return MTL_ATTRIBUTE_FORMAT_SHORT3_NORMALIZED;
+   case VK_FORMAT_R16G16B16A16_SNORM:
+      return MTL_ATTRIBUTE_FORMAT_SHORT4_NORMALIZED;
+   case VK_FORMAT_R8G8_SNORM:
+      return MTL_ATTRIBUTE_FORMAT_CHAR2_NORMALIZED;
+   case VK_FORMAT_R8G8B8_SNORM:
+      return MTL_ATTRIBUTE_FORMAT_CHAR3_NORMALIZED;
+   case VK_FORMAT_R8G8B8A8_SNORM:
+      return MTL_ATTRIBUTE_FORMAT_CHAR4_NORMALIZED;
+   default:
+      /* VUID-VkAccelerationStructureGeometryTrianglesDataKHR-vertexFormat-03797
+       * restricts this to formats we advertise in
+       * kk_GetPhysicalDeviceFormatProperties2 with
+       * ACCELERATION_STRUCTURE_VERTEX_BUFFER_BIT. */
+      return MTL_ATTRIBUTE_FORMAT_FLOAT3;
+   }
+}
+
+static uint32_t
+kk_as_vertex_format_size_B(enum mtl_attribute_format format)
+{
+   switch (format) {
+   case MTL_ATTRIBUTE_FORMAT_CHAR2_NORMALIZED:
+      return 2u;
+   case MTL_ATTRIBUTE_FORMAT_CHAR3_NORMALIZED:
+      return 3u;
+   case MTL_ATTRIBUTE_FORMAT_CHAR4_NORMALIZED:
+   case MTL_ATTRIBUTE_FORMAT_SHORT2_NORMALIZED:
+   case MTL_ATTRIBUTE_FORMAT_HALF2:
+      return 4u;
+   case MTL_ATTRIBUTE_FORMAT_SHORT3_NORMALIZED:
+   case MTL_ATTRIBUTE_FORMAT_HALF3:
+      return 6u;
+   case MTL_ATTRIBUTE_FORMAT_SHORT4_NORMALIZED:
+   case MTL_ATTRIBUTE_FORMAT_HALF4:
+   case MTL_ATTRIBUTE_FORMAT_FLOAT2:
+      return 8u;
+   case MTL_ATTRIBUTE_FORMAT_FLOAT3:
+      return 12u;
+   case MTL_ATTRIBUTE_FORMAT_FLOAT4:
+      return 16u;
+   default:
+      return 12u;
+   }
+}
+
+static enum mtl_acceleration_structure_usage
+kk_as_usage(VkBuildAccelerationStructureFlagsKHR flags)
+{
+   enum mtl_acceleration_structure_usage usage =
+      MTL_ACCELERATION_STRUCTURE_USAGE_EXTENDED_LIMITS;
+
+   if (flags & VK_BUILD_ACCELERATION_STRUCTURE_ALLOW_UPDATE_BIT_KHR)
+      usage |= MTL_ACCELERATION_STRUCTURE_USAGE_REFIT;
+
+   if (flags & VK_BUILD_ACCELERATION_STRUCTURE_PREFER_FAST_BUILD_BIT_KHR)
+      usage |= MTL_ACCELERATION_STRUCTURE_USAGE_PREFER_FAST_BUILD;
+
+   if (flags & VK_BUILD_ACCELERATION_STRUCTURE_PREFER_FAST_TRACE_BIT_KHR)
+      usage |= MTL_ACCELERATION_STRUCTURE_USAGE_PREFER_FAST_INTERSECTION;
+
+   if (flags & VK_BUILD_ACCELERATION_STRUCTURE_LOW_MEMORY_BIT_KHR)
+      usage |= MTL_ACCELERATION_STRUCTURE_USAGE_MINIMIZE_MEMORY;
+
+   return usage;
+}
+
+static const VkAccelerationStructureGeometryKHR *
+kk_as_geometry(const VkAccelerationStructureBuildGeometryInfoKHR *info,
+               uint32_t index)
+{
+   if (info->pGeometries != NULL)
+      return &info->pGeometries[index];
+
+   return info->ppGeometries[index];
+}
+
+/* VK_ACCELERATION_STRUCTURE_TYPE_GENERIC_KHR is not legal in a build info, but
+ * do not take the caller's word for it either way: the geometry type is what
+ * actually decides which Metal descriptor class applies. */
+static bool
+kk_as_is_top_level(const VkAccelerationStructureBuildGeometryInfoKHR *info)
+{
+   if (info->type == VK_ACCELERATION_STRUCTURE_TYPE_TOP_LEVEL_KHR)
+      return true;
+
+   if (info->type == VK_ACCELERATION_STRUCTURE_TYPE_BOTTOM_LEVEL_KHR)
+      return false;
+
+   return info->geometryCount > 0u &&
+          kk_as_geometry(info, 0u)->geometryType ==
+             VK_GEOMETRY_TYPE_INSTANCES_KHR;
+}
+
+/* Fill one Metal geometry descriptor input.
+ *
+ * `range` is NULL for vkGetAccelerationStructureBuildSizesKHR, where only the
+ * primitive counts matter and no buffer has been bound yet.
+ */
+static void
+kk_as_fill_geometry(struct mtl_acceleration_structure_geometry *out,
+                    const VkAccelerationStructureGeometryKHR *geometry,
+                    const VkAccelerationStructureBuildRangeInfoKHR *range,
+                    uint32_t primitive_count)
+{
+   const bool sizes_only = range == NULL;
+
+   *out = (struct mtl_acceleration_structure_geometry){
+      .opaque = (geometry->flags & VK_GEOMETRY_OPAQUE_BIT_KHR) != 0,
+      .allow_duplicate_intersection_function_invocation =
+         (geometry->flags &
+          VK_GEOMETRY_NO_DUPLICATE_ANY_HIT_INVOCATION_BIT_KHR) == 0,
+   };
+
+   switch (geometry->geometryType) {
+   case VK_GEOMETRY_TYPE_TRIANGLES_KHR: {
+      const VkAccelerationStructureGeometryTrianglesDataKHR *triangles =
+         &geometry->geometry.triangles;
+
+      const enum mtl_attribute_format vertex_format =
+         kk_as_vertex_format(triangles->vertexFormat);
+      uint64_t vertex_stride = triangles->vertexStride;
+      if (vertex_stride == 0u)
+         vertex_stride = kk_as_vertex_format_size_B(vertex_format);
+
+      const bool indexed = triangles->indexType != VK_INDEX_TYPE_NONE_KHR;
+
+      uint64_t vertex_addr = sizes_only ? KK_AS_SIZE_QUERY_DUMMY_ADDR
+                                        : triangles->vertexData.deviceAddress;
+      if (!sizes_only) {
+         vertex_addr += (uint64_t)range->firstVertex * vertex_stride;
+         if (!indexed)
+            vertex_addr += range->primitiveOffset;
+      }
+
+      out->type = MTL_ACCELERATION_STRUCTURE_GEOMETRY_TYPE_TRIANGLES;
+      out->triangles.vertex.address = vertex_addr;
+      out->triangles.vertex.length_B = MTL_BUFFER_RANGE_WHOLE;
+      out->triangles.vertex_format = vertex_format;
+      out->triangles.vertex_stride_B = vertex_stride;
+      out->triangles.triangle_count = primitive_count;
+
+      if (indexed) {
+         out->triangles.index.address =
+            sizes_only ? KK_AS_SIZE_QUERY_DUMMY_ADDR
+                       : triangles->indexData.deviceAddress +
+                            range->primitiveOffset;
+         out->triangles.index.length_B = MTL_BUFFER_RANGE_WHOLE;
+         out->triangles.index_type = triangles->indexType == VK_INDEX_TYPE_UINT16
+                                        ? MTL_INDEX_TYPE_UINT16
+                                        : MTL_INDEX_TYPE_UINT32;
+      }
+
+      /* VkTransformMatrixKHR is a row-major 3x4, which Metal understands
+       * directly once we tell it the layout. */
+      if (triangles->transformData.deviceAddress != 0u && !sizes_only) {
+         out->triangles.transform.address =
+            triangles->transformData.deviceAddress + range->transformOffset;
+         out->triangles.transform.length_B = sizeof(VkTransformMatrixKHR);
+         out->triangles.transform_layout = MTL_MATRIX_LAYOUT_ROW_MAJOR;
+      }
+      break;
+   }
+
+   case VK_GEOMETRY_TYPE_AABBS_KHR: {
+      const VkAccelerationStructureGeometryAabbsDataKHR *aabbs =
+         &geometry->geometry.aabbs;
+
+      uint64_t stride = aabbs->stride;
+      if (stride == 0u)
+         stride = sizeof(VkAabbPositionsKHR);
+
+      out->type = MTL_ACCELERATION_STRUCTURE_GEOMETRY_TYPE_BOUNDING_BOXES;
+      out->bounding_boxes.bounding_box.address =
+         sizes_only ? KK_AS_SIZE_QUERY_DUMMY_ADDR
+                    : aabbs->data.deviceAddress + range->primitiveOffset;
+      out->bounding_boxes.bounding_box.length_B = MTL_BUFFER_RANGE_WHOLE;
+      out->bounding_boxes.bounding_box_stride_B = stride;
+      out->bounding_boxes.bounding_box_count = primitive_count;
+      break;
+   }
+
+   default:
+      /* Instances are handled by the caller and nothing else exists for a
+       * bottom-level build. Emit an empty triangle geometry rather than
+       * UNREACHABLE so a malformed build info cannot turn into undefined
+       * behaviour in a release driver. */
+      out->type = MTL_ACCELERATION_STRUCTURE_GEOMETRY_TYPE_TRIANGLES;
+      out->triangles.vertex.address = KK_AS_SIZE_QUERY_DUMMY_ADDR;
+      out->triangles.vertex.length_B = MTL_BUFFER_RANGE_WHOLE;
+      out->triangles.vertex_format = MTL_ATTRIBUTE_FORMAT_FLOAT3;
+      out->triangles.vertex_stride_B = 12u;
+      out->triangles.triangle_count = 0u;
+      break;
+   }
+}
+
+/* Build the Metal descriptor for one Vulkan build info.
+ *
+ * For a top-level build, `instance_descriptor_addr` must already point at the
+ * converted MTLIndirectAccelerationStructureInstanceDescriptor array (see
+ * kk_as_convert_instances). Pass 0 when only sizes are wanted.
+ */
+static mtl_acceleration_structure_descriptor *
+kk_as_new_descriptor(const VkAccelerationStructureBuildGeometryInfoKHR *info,
+                     const VkAccelerationStructureBuildRangeInfoKHR *ranges,
+                     const uint32_t *max_primitive_counts,
+                     uint64_t instance_descriptor_addr, bool for_size_query)
+{
+   const enum mtl_acceleration_structure_usage usage = kk_as_usage(info->flags);
+
+   if (kk_as_is_top_level(info)) {
+      uint32_t instance_count = 0u;
+
+      if (info->geometryCount > 0u) {
+         if (ranges)
+            instance_count = ranges[0].primitiveCount;
+         else if (max_primitive_counts)
+            instance_count = max_primitive_counts[0];
+      }
+
+      struct mtl_instance_acceleration_structure_geometry geometry = {
+         .instance_descriptors =
+            {
+               .address = instance_descriptor_addr
+                             ? instance_descriptor_addr
+                             : KK_AS_SIZE_QUERY_DUMMY_ADDR,
+               .length_B = (uint64_t)instance_count * KK_MTL_AS_INSTANCE_SIZE_B,
+            },
+         .instance_descriptor_stride_B = KK_MTL_AS_INSTANCE_SIZE_B,
+         .instance_count = instance_count,
+         .descriptor_type =
+            MTL_ACCELERATION_STRUCTURE_INSTANCE_DESCRIPTOR_TYPE_INDIRECT,
+         .transform_layout = MTL_MATRIX_LAYOUT_ROW_MAJOR,
+      };
+
+      if (for_size_query) {
+         return mtl_new_instance_acceleration_structure_sizing_descriptor(
+            &geometry, usage);
+      }
+
+      return mtl_new_instance_acceleration_structure_descriptor(&geometry,
+                                                                usage);
+   }
+
+   if (info->geometryCount == 0u)
+      return mtl_new_primitive_acceleration_structure_descriptor(NULL, 0u,
+                                                                 usage);
+
+   struct mtl_acceleration_structure_geometry *geometries =
+      calloc(info->geometryCount, sizeof(*geometries));
+   if (geometries == NULL)
+      return NULL;
+
+   for (uint32_t i = 0u; i < info->geometryCount; ++i) {
+      uint32_t count = 0u;
+      if (ranges)
+         count = ranges[i].primitiveCount;
+      else if (max_primitive_counts)
+         count = max_primitive_counts[i];
+      kk_as_fill_geometry(&geometries[i], kk_as_geometry(info, i),
+                          ranges ? &ranges[i] : NULL, count);
+   }
+
+   mtl_acceleration_structure_descriptor *descriptor =
+      mtl_new_primitive_acceleration_structure_descriptor(
+         geometries, info->geometryCount, usage);
+
+   free(geometries);
+
+   return descriptor;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+kk_CreateAccelerationStructureKHR(
+   VkDevice device, const VkAccelerationStructureCreateInfoKHR *pCreateInfo,
+   const VkAllocationCallbacks *pAllocator,
+   VkAccelerationStructureKHR *pAccelerationStructure)
+{
+   VK_FROM_HANDLE(kk_device, dev, device);
+   VK_FROM_HANDLE(kk_buffer, buffer, pCreateInfo->buffer);
+
+   struct kk_acceleration_structure *as = vk_object_zalloc(
+      &dev->vk, pAllocator, sizeof(*as),
+      VK_OBJECT_TYPE_ACCELERATION_STRUCTURE_KHR);
+   if (as == NULL)
+      return vk_error(dev, VK_ERROR_OUT_OF_HOST_MEMORY);
+
+   as->type = pCreateInfo->type;
+   as->buffer = buffer;
+   as->offset_B = pCreateInfo->offset;
+   as->size_B = pCreateInfo->size;
+
+   /* Place the Metal structure in the application's memory when we can, so a
+    * VkBuffer range really does back it. Metal rounds the storage up, so ask
+    * for the size it wants rather than the Vulkan one. */
+   uint64_t mtl_size_B = as->size_B;
+   uint64_t mtl_align_B = 1u;
+   mtl_device_heap_acceleration_structure_size_and_align(
+      dev->mtl_handle, as->size_B, &mtl_size_B, &mtl_align_B);
+
+   if (buffer != NULL && buffer->heap != NULL && mtl_align_B != 0u) {
+      const uint64_t offset_B = buffer->heap_offset_B + as->offset_B;
+
+      if ((offset_B % mtl_align_B) == 0u && mtl_size_B <= as->size_B) {
+         as->mtl_handle = mtl_heap_new_acceleration_structure_with_size(
+            buffer->heap, as->size_B, offset_B);
+      }
+   }
+
+   if (as->mtl_handle == NULL) {
+      as->mtl_handle =
+         mtl_new_acceleration_structure_with_size(dev->mtl_handle, as->size_B);
+      as->standalone = as->mtl_handle != NULL;
+   }
+
+   if (as->mtl_handle == NULL) {
+      vk_object_free(&dev->vk, pAllocator, as);
+      return vk_error(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY);
+   }
+
+   if (as->standalone)
+      kk_device_add_buffer_to_residency_set(dev, as->mtl_handle);
+
+   as->gpu_resource_id =
+      mtl_acceleration_structure_get_gpu_resource_id(as->mtl_handle);
+
+   *pAccelerationStructure = kk_acceleration_structure_to_handle(as);
+
+   return VK_SUCCESS;
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_DestroyAccelerationStructureKHR(VkDevice device,
+                                   VkAccelerationStructureKHR accelerationStructure,
+                                   const VkAllocationCallbacks *pAllocator)
+{
+   VK_FROM_HANDLE(kk_device, dev, device);
+   VK_FROM_HANDLE(kk_acceleration_structure, as, accelerationStructure);
+
+   if (as == NULL)
+      return;
+
+   if (as->mtl_handle != NULL) {
+      if (as->standalone)
+         kk_device_remove_buffer_from_residency_set(dev, as->mtl_handle);
+      mtl_release(as->mtl_handle);
+   }
+
+   vk_object_free(&dev->vk, pAllocator, as);
+}
+
+VKAPI_ATTR VkDeviceAddress VKAPI_CALL
+kk_GetAccelerationStructureDeviceAddressKHR(
+   UNUSED VkDevice device,
+   const VkAccelerationStructureDeviceAddressInfoKHR *pInfo)
+{
+   VK_FROM_HANDLE(kk_acceleration_structure, as, pInfo->accelerationStructure);
+
+   /* Not a buffer address: Metal identifies an acceleration structure by
+    * MTLResourceID, and that is the value a top-level build has to find in the
+    * instance array. Vulkan treats this as opaque. */
+   return as->gpu_resource_id;
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_GetAccelerationStructureBuildSizesKHR(
+   VkDevice device, VkAccelerationStructureBuildTypeKHR buildType,
+   const VkAccelerationStructureBuildGeometryInfoKHR *pBuildInfo,
+   const uint32_t *pMaxPrimitiveCounts,
+   VkAccelerationStructureBuildSizesInfoKHR *pSizeInfo)
+{
+   VK_FROM_HANDLE(kk_device, dev, device);
+
+   pSizeInfo->accelerationStructureSize = 0u;
+   pSizeInfo->updateScratchSize = 0u;
+   pSizeInfo->buildScratchSize = 0u;
+
+   mtl_acceleration_structure_descriptor *descriptor =
+      kk_as_new_descriptor(pBuildInfo, NULL, pMaxPrimitiveCounts, 0u, true);
+   if (descriptor == NULL)
+      return;
+
+   const struct mtl_acceleration_structure_sizes sizes =
+      mtl_device_acceleration_structure_sizes(dev->mtl_handle, descriptor);
+   mtl_release(descriptor);
+
+   uint64_t instance_scratch_B = 0u;
+   if (kk_as_is_top_level(pBuildInfo) && pBuildInfo->geometryCount > 0u &&
+       pMaxPrimitiveCounts != NULL) {
+      instance_scratch_B = kk_as_instance_scratch_size(pMaxPrimitiveCounts[0]);
+   }
+
+   /* Report the size Metal needs once it is placed in a heap, not the raw one,
+    * so that kk_CreateAccelerationStructureKHR can put the structure inside the
+    * VkBuffer range the application then allocates instead of falling back to a
+    * second, standalone allocation. */
+   uint64_t placed_size_B = sizes.acceleration_structure_size_B;
+   uint64_t placed_align_B = 1u;
+   mtl_device_heap_acceleration_structure_size_and_align(
+      dev->mtl_handle, sizes.acceleration_structure_size_B, &placed_size_B,
+      &placed_align_B);
+
+   pSizeInfo->accelerationStructureSize =
+      MAX2(placed_size_B, sizes.acceleration_structure_size_B);
+   pSizeInfo->buildScratchSize =
+      instance_scratch_B +
+      align64(sizes.build_scratch_buffer_size_B, KK_AS_SCRATCH_ALIGNMENT);
+   pSizeInfo->updateScratchSize =
+      instance_scratch_B +
+      align64(sizes.refit_scratch_buffer_size_B, KK_AS_SCRATCH_ALIGNMENT);
+}
+
+/* Rewrite the application's VkAccelerationStructureInstanceKHR array into
+ * Metal's indirect instance layout, at the head of the build scratch. Runs on
+ * the GPU timeline because the instance array may itself be GPU-produced. */
+static void
+kk_as_convert_instances(struct kk_cmd_buffer *cmd,
+                        const VkAccelerationStructureGeometryKHR *geometry,
+                        uint64_t scratch_addr, uint32_t instance_count)
+{
+   const VkAccelerationStructureGeometryInstancesDataKHR *instances =
+      &geometry->geometry.instances;
+
+   const uint32_t stride_B = instances->arrayOfPointers
+                                ? (uint32_t)sizeof(uint64_t)
+                                : KK_VK_AS_INSTANCE_SIZE_B;
+
+   libkk_convert_as_instances(cmd, kk_grid_1d(instance_count),
+                              !cmd->gfx.encoder, scratch_addr,
+                              instances->data.deviceAddress, stride_B,
+                              instances->arrayOfPointers, instance_count);
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdBuildAccelerationStructuresKHR(
+   VkCommandBuffer commandBuffer, uint32_t infoCount,
+   const VkAccelerationStructureBuildGeometryInfoKHR *pInfos,
+   const VkAccelerationStructureBuildRangeInfoKHR *const *ppBuildRangeInfos)
+{
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+
+   for (uint32_t i = 0u; i < infoCount; ++i) {
+      const VkAccelerationStructureBuildGeometryInfoKHR *info = &pInfos[i];
+      const VkAccelerationStructureBuildRangeInfoKHR *ranges =
+         ppBuildRangeInfos[i];
+
+      VK_FROM_HANDLE(kk_acceleration_structure, dst,
+                     info->dstAccelerationStructure);
+      VK_FROM_HANDLE(kk_acceleration_structure, src,
+                     info->srcAccelerationStructure);
+
+      if (dst == NULL || dst->mtl_handle == NULL)
+         continue;
+
+      uint64_t scratch_addr = info->scratchData.deviceAddress;
+      uint64_t instance_scratch_B = 0u;
+
+      if (kk_as_is_top_level(info) && info->geometryCount > 0u &&
+          ranges[0].primitiveCount > 0u) {
+         const uint32_t instance_count = ranges[0].primitiveCount;
+
+         instance_scratch_B = kk_as_instance_scratch_size(instance_count);
+         kk_as_convert_instances(cmd, kk_as_geometry(info, 0u), scratch_addr,
+                                 instance_count);
+      }
+
+      mtl_acceleration_structure_descriptor *descriptor =
+         kk_as_new_descriptor(info, ranges, NULL, scratch_addr, false);
+      if (descriptor == NULL)
+         continue;
+
+      mtl_compute_encoder *encoder = cs_get_compute(cmd, !cmd->gfx.encoder);
+
+      /* The conversion dispatch above writes the very buffer the build is
+       * about to read. */
+      mtl_barrier_after_encoder_stages(encoder, MTL_STAGE_DISPATCH,
+                                       MTL_STAGE_ACCELERATION_STRUCTURE);
+
+      const struct mtl_buffer_range scratch = {
+         .address = scratch_addr + instance_scratch_B,
+         .length_B = MTL_BUFFER_RANGE_WHOLE,
+      };
+
+      const bool update =
+         info->mode == VK_BUILD_ACCELERATION_STRUCTURE_MODE_UPDATE_KHR &&
+         src != NULL && src->mtl_handle != NULL;
+
+      if (update) {
+         mtl_refit_acceleration_structure(encoder, src->mtl_handle, descriptor,
+                                          dst->mtl_handle, scratch);
+      } else {
+         mtl_build_acceleration_structure(encoder, dst->mtl_handle, descriptor,
+                                          scratch);
+      }
+
+      mtl_barrier_after_encoder_stages(encoder,
+                                       MTL_STAGE_ACCELERATION_STRUCTURE,
+                                       MTL_STAGE_ALL);
+
+      mtl_release(descriptor);
+   }
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdCopyAccelerationStructureKHR(
+   VkCommandBuffer commandBuffer, const VkCopyAccelerationStructureInfoKHR *pInfo)
+{
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   VK_FROM_HANDLE(kk_acceleration_structure, src, pInfo->src);
+   VK_FROM_HANDLE(kk_acceleration_structure, dst, pInfo->dst);
+
+   if (src == NULL || dst == NULL || src->mtl_handle == NULL ||
+       dst->mtl_handle == NULL)
+      return;
+
+   mtl_compute_encoder *encoder = cs_get_compute(cmd, !cmd->gfx.encoder);
+
+   mtl_barrier_after_encoder_stages(encoder, MTL_STAGE_ACCELERATION_STRUCTURE,
+                                    MTL_STAGE_ACCELERATION_STRUCTURE);
+
+   if (pInfo->mode == VK_COPY_ACCELERATION_STRUCTURE_MODE_COMPACT_KHR) {
+      mtl_copy_and_compact_acceleration_structure(encoder, src->mtl_handle,
+                                                  dst->mtl_handle);
+   } else {
+      mtl_copy_acceleration_structure(encoder, src->mtl_handle,
+                                      dst->mtl_handle);
+   }
+
+   mtl_barrier_after_encoder_stages(encoder, MTL_STAGE_ACCELERATION_STRUCTURE,
+                                    MTL_STAGE_ALL);
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdWriteAccelerationStructuresPropertiesKHR(
+   VkCommandBuffer commandBuffer, uint32_t accelerationStructureCount,
+   const VkAccelerationStructureKHR *pAccelerationStructures,
+   VkQueryType queryType, VkQueryPool queryPool, uint32_t firstQuery)
+{
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   VK_FROM_HANDLE(kk_query_pool, pool, queryPool);
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+
+   mtl_compute_encoder *encoder = cs_get_compute(cmd, !cmd->gfx.encoder);
+   mtl_barrier_after_encoder_stages(encoder, MTL_STAGE_ACCELERATION_STRUCTURE,
+                                    MTL_STAGE_ACCELERATION_STRUCTURE);
+
+   for (uint32_t i = 0u; i < accelerationStructureCount; ++i) {
+      VK_FROM_HANDLE(kk_acceleration_structure, as, pAccelerationStructures[i]);
+      const uint32_t query = firstQuery + i;
+      const uint64_t dst_addr = kk_query_pool_report_addr(dev, pool, query);
+
+      if (as == NULL || as->mtl_handle == NULL)
+         continue;
+
+      switch (queryType) {
+      case VK_QUERY_TYPE_ACCELERATION_STRUCTURE_COMPACTED_SIZE_KHR: {
+         /* Seed the slot with the uncompacted size first.
+          *
+          * A compacted size equal to the original is always a legal answer —
+          * the destination of a compacting copy only has to be at least the
+          * compacted size — so this is a correct, if pessimistic, result. It
+          * matters because -[MTL4ComputeCommandEncoder
+          * writeCompactedAccelerationStructureSize:toBuffer:] was measured to
+          * leave the destination untouched on macOS 27 / M2 (build, refit,
+          * copy and copy-and-compact on the same encoder all work). Without
+          * the seed an application would read zero and allocate nothing.
+          */
+         libkk_write_u64(cmd, kk_grid_1d(1u), !cmd->gfx.encoder, dst_addr,
+                         as->size_B);
+         mtl_barrier_after_encoder_stages(encoder, MTL_STAGE_DISPATCH,
+                                          MTL_STAGE_ACCELERATION_STRUCTURE);
+
+         const struct mtl_buffer_range destination = {
+            .address = dst_addr,
+            .length_B = sizeof(uint64_t),
+         };
+         mtl_write_compacted_acceleration_structure_size(
+            encoder, as->mtl_handle, destination);
+         break;
+      }
+
+      case VK_QUERY_TYPE_ACCELERATION_STRUCTURE_SIZE_KHR:
+      case VK_QUERY_TYPE_ACCELERATION_STRUCTURE_SERIALIZATION_SIZE_KHR:
+         /* Nothing the GPU has to compute: we know the storage size at record
+          * time. Serialization is not implemented, so this is the size a
+          * serialized blob would need if it were. */
+         libkk_write_u64(cmd, kk_grid_1d(1u), !cmd->gfx.encoder, dst_addr,
+                         as->size_B);
+         break;
+
+      case VK_QUERY_TYPE_ACCELERATION_STRUCTURE_SERIALIZATION_BOTTOM_LEVEL_POINTERS_KHR:
+         libkk_write_u64(cmd, kk_grid_1d(1u), !cmd->gfx.encoder, dst_addr, 0u);
+         break;
+
+      default:
+         break;
+      }
+
+      kk_cmd_write(cmd, (struct libkk_imm_write){
+                           .address = kk_query_pool_available_addr(pool, query),
+                           .value = 1u,
+                        });
+   }
+
+   mtl_barrier_after_encoder_stages(encoder, MTL_STAGE_ACCELERATION_STRUCTURE,
+                                    MTL_STAGE_ALL);
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_GetDeviceAccelerationStructureCompatibilityKHR(
+   UNUSED VkDevice device,
+   UNUSED const VkAccelerationStructureVersionInfoKHR *pVersionInfo,
+   VkAccelerationStructureCompatibilityKHR *pCompatibility)
+{
+   /* Serialization is not implemented, so nothing we could be handed is
+    * replayable. */
+   *pCompatibility =
+      VK_ACCELERATION_STRUCTURE_COMPATIBILITY_INCOMPATIBLE_KHR;
+}
+
+/* ---------------------------------------------------------------------------
+ * Not implemented. accelerationStructureHostCommands is reported false, so the
+ * host-side builders are unreachable through a conformant application; the
+ * serialization commands need a Metal blob format we do not have.
+ * ------------------------------------------------------------------------- */
