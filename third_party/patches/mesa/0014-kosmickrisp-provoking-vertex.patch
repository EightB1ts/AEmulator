+/* ------------------------------------------------------- VK_EXT_provoking_vertex
+ *
+ * Metal's provoking vertex is the FIRST vertex of a primitive, and there is no
+ * state anywhere in Metal to change it — measured, not assumed: nothing named
+ * "provoking" exists in the macOS 26/27 Metal headers, MTLRenderPipelineDescriptor
+ * and MTL4RenderPipelineDescriptor answer respondsToSelector: with no for every
+ * spelling of it, and MSL's [[flat]] resolves to vertex 0 for triangle lists,
+ * strips (indexed or not) and line strips alike.
+ *
+ * So VK_PROVOKING_VERTEX_MODE_LAST_VERTEX_EXT is emulated by moving the vertex
+ * into the slot Metal reads: decompose the draw into independent primitives in
+ * the last-provoking vertex order, then rotate each primitive one step right so
+ * its last vertex becomes its first. Rotation is cyclic, so the winding order —
+ * and therefore facing, culling and front/back stencil — is untouched.
+ *
+ * Every producer of a decomposed primitive list does this the same way:
+ *
+ *   plain draws        libkk_unroll_geometry with flatshade_first = 0, then
+ *                      libkk_rotate_provoking (kk_unroll_geometry below). The
+ *                      unroll is FORCED for this when it would not otherwise
+ *                      run, because a strip handed to Metal as a strip cannot be
+ *                      fixed after the fact.
+ *   geometry shaders   the same kernel for a dynamic output topology, and
+ *                      kk_gs_unroll_static_topology() on the CPU for a static
+ *                      one. Both take the mode.
+ *   tessellation       the tessellator already emits independent primitives, so
+ *                      only the rotation is needed.
+ *
+ * The mode ALSO has to reach libpoly's software input assembly, which asks for
+ * it through nir_intrinsic_load_provoking_last; that goes through the root
+ * table (see kk_nir_lower_descriptors.c and root.draw.provoking_last).
+ */
+
+/* Whether the mode is observable at all. See kk_shader_info::provoking_sensitive
+ * — with no flat fragment input and no layer/viewport write, first and last
+ * select different vertices but nothing downstream can tell, and the
+ * decomposition would be pure cost. */
+static bool
+kk_provoking_observable(const struct kk_cmd_buffer *cmd)
+{
+   for (uint32_t s = 0u; s < ARRAY_SIZE(cmd->state.shaders); ++s) {
+      const struct kk_shader *shader = cmd->state.shaders[s];
+      if (shader != NULL && shader->info.provoking_sensitive)
+         return true;
+   }
+
+   return false;
+}
+
+/* Whether this draw's primitives must be rotated. */
+static bool
+kk_rotate_provoking(const struct kk_cmd_buffer *cmd)
+{
+   const struct vk_dynamic_graphics_state *dyn =
+      &cmd->vk.dynamic_graphics_state;
+
+   return dyn->rs.provoking_vertex == VK_PROVOKING_VERTEX_MODE_LAST_VERTEX_EXT &&
+          kk_provoking_observable(cmd);
+}
+
+/* Rotate every primitive of an already-decomposed indexed indirect draw.
+ *
+ * `first_draw` is the first of `draw_count` VkDrawIndexedIndirectCommands and
+ * `indices` the base the draw will hand Metal; the index count and first index
+ * are read off the descriptor on the GPU because for an unrolled or tessellated
+ * draw that is the only place they exist. Points have nothing to rotate.
+ */
+static void
+kk_rotate_provoking_indices(struct kk_cmd_buffer *cmd, uint64_t indices,
+                            uint64_t first_draw, uint32_t draw_count,
+                            enum mesa_prim decomposed)
+{
+   uint32_t per_prim = mesa_vertices_per_prim(decomposed);
+   if (per_prim < 2u)
+      return;
+
+   /* One workgroup per draw descriptor, matching libkk_unroll_geometry's
+    * KERNEL(1024) shape. */
+   libkk_rotate_provoking(cmd, kk_grid_1d(1024u * draw_count), true, indices,
+                          first_draw,
+                          sizeof(VkDrawIndexedIndirectCommand) /
+                             sizeof(uint32_t),
+                          per_prim);
+}
