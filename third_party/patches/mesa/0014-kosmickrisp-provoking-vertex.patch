+    * vertex where Metal reads it. One descriptor covers the whole tessellated
+    * draw (libkk_prefix_sum_tess writes total/first_index into out_draws), so
+    * one workgroup's worth of rotation covers every patch. */
+   if (kk_rotate_provoking(cmd)) {
+      kk_rotate_provoking_indices(cmd, dev->heap->gpu + sizeof(struct poly_heap),
+                                  gfx->tess.out_draws_addr, 1u, gfx->tess.prim);
