diff --git a/src/kosmickrisp/libkk/kk_draws.cl b/src/kosmickrisp/libkk/kk_draws.cl
--- a/src/kosmickrisp/libkk/kk_draws.cl
+++ b/src/kosmickrisp/libkk/kk_draws.cl
@@ -88,3 +88,44 @@ libkk_unroll_geometry(
                         index_buffer_size_el, in_el_size_B, out_el_size_B,
                         restart_index, flatshade_first, mode, scratch);
 }
+
+/*
+ * VK_PROVOKING_VERTEX_MODE_LAST_VERTEX_EXT on a first-vertex-provoking GPU.
+ *
+ * Metal reads a flat-shaded value off the FIRST vertex of a primitive and has no
+ * state to change that, so last-vertex mode is implemented by moving the vertex:
+ * rotate every primitive of an already-decomposed index buffer one step to the
+ * right, which puts what was the last vertex in slot 0. A cyclic rotation is a
+ * permutation of the same three (or two) vertices in the same cyclic order, so
+ * the winding — and therefore facing, culling and front/back stencil — comes out
+ * identical; only which vertex Metal calls provoking changes.
+ *
+ * The producer must already have emitted the primitives in LAST-provoking vertex
+ * order (poly_unroll_geometry with flatshade_first = 0, or the tessellator,
+ * which emits independent primitives): rotating the first-provoking order gives
+ * a different, wrong answer for strips, where the two orders differ.
+ *
+ * One workgroup per draw descriptor. Both the index count and the first index
+ * are read off the descriptor rather than passed in, because for an unrolled or
+ * tessellated draw the GPU is the only thing that knows them.
+ */
+KERNEL(1024)
+libkk_rotate_provoking(global uint32_t *indices, constant uint32_t *draw,
+                       uint32_t draw_stride_el, uint32_t per_prim)
+{
+   draw += cl_group_id.x * draw_stride_el;
+
+   /* VkDrawIndexedIndirectCommand: [0] indexCount, [2] firstIndex. */
+   uint prims = draw[0] / per_prim;
+   global uint32_t *base = indices + draw[2];
+
+   for (uint p = cl_local_id.x; p < prims; p += cl_local_size.x) {
+      global uint32_t *prim = base + (p * per_prim);
+      uint last = prim[per_prim - 1u];
+
+      for (uint v = per_prim - 1u; v > 0u; --v)
+         prim[v] = prim[v - 1u];
+
+      prim[0] = last;
+   }
+}
