diff --git a/src/kosmickrisp/vulkan/kk_shader.c b/src/kosmickrisp/vulkan/kk_shader.c
--- a/src/kosmickrisp/vulkan/kk_shader.c
+++ b/src/kosmickrisp/vulkan/kk_shader.c
@@ -702,6 +702,27 @@ gather_vs_inputs(nir_builder *b, nir_intrinsic_instr *intr, void *data)
    return false;
 }
 
+/* A fragment shader observes the provoking vertex exactly when it reads a
+ * flat-interpolated input. After kk_lower_nir()'s nir_lower_io that is either a
+ * bare load_input (which msl_iomap.c emits as interpolation::flat) or a
+ * load_interpolated_input whose barycentric says INTERP_MODE_FLAT. */
+static bool
+gather_fs_flat_inputs(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   bool *flat = data;
+
+   if (intr->intrinsic == nir_intrinsic_load_input) {
+      *flat = true;
+   } else if (intr->intrinsic == nir_intrinsic_load_interpolated_input) {
+      nir_intrinsic_instr *bary = nir_src_as_intrinsic(intr->src[0]);
+      if (bary != NULL && nir_intrinsic_has_interp_mode(bary) &&
+          nir_intrinsic_interp_mode(bary) == INTERP_MODE_FLAT)
+         *flat = true;
+   }
+
+   return false;
+}
+
 static void
 gather_shader_info(struct kk_shader *shader, nir_shader *nir,
                    const struct vk_graphics_pipeline_state *state)
@@ -709,6 +730,26 @@ gather_shader_info(struct kk_shader *shader, nir_shader *nir,
    shader->info.stage = nir->info.stage;
    shader->info.uses_per_draw_data = msl_gather_uses_per_draw_data(nir);
    shader->info.num_cull_distances = nir->info.cull_distance_array_size;
+
+   /* See kk_shader_info::provoking_sensitive. Deliberately conservative on both
+    * halves: every flat fragment input counts even when the value happens to be
+    * uniform across the primitive, and a layer/viewport write counts even when
+    * it came from multiview lowering (where every vertex of a primitive carries
+    * the same view, so the provoking vertex cannot matter). Both mistakes cost
+    * a decomposition; the opposite mistake renders the wrong colour. */
+   if (nir->info.stage == MESA_SHADER_FRAGMENT) {
+      bool flat = false;
+      nir_shader_intrinsics_pass(nir, gather_fs_flat_inputs, nir_metadata_all,
+                                 &flat);
+      shader->info.provoking_sensitive = flat;
+   } else {
+      const uint64_t from_provoking_vertex =
+         BITFIELD64_BIT(VARYING_SLOT_LAYER) |
+         BITFIELD64_BIT(VARYING_SLOT_VIEWPORT);
+      shader->info.provoking_sensitive =
+         (nir->info.outputs_written & from_provoking_vertex) != 0u;
+   }
+
    if (nir->info.stage == MESA_SHADER_VERTEX) {
       nir_shader_intrinsics_pass(nir, gather_vs_inputs, nir_metadata_all,
                                  &shader->info.vs.attribs_read);
