+/* VK_DESCRIPTOR_TYPE_ACCELERATION_STRUCTURE_KHR.
+ *
+ * The slot holds the MTLResourceID and nothing else, because the ray query
+ * lowering hands the shader this slot's address and MSL loads the
+ * raytracing::acceleration_structure straight out of it. VK_NULL_HANDLE writes
+ * a zero id, which is what nullDescriptor asks for; Metal treats a zero handle
+ * as an empty structure, so a query against it misses rather than faults.
+ *
+ * Residency is already handled: kk_CreateAccelerationStructureKHR puts a
+ * standalone MTLAccelerationStructure in the device residency set, and a heap
+ * suballocation rides on its heap's membership. Nothing per-descriptor to do.
+ */
+static void
+write_acceleration_structure_desc(struct kk_descriptor_set *set,
+                                  const VkAccelerationStructureKHR handle,
+                                  uint32_t binding, uint32_t elem)
+{
+   struct kk_acceleration_structure_descriptor desc = {};
+   if (handle != VK_NULL_HANDLE) {
+      VK_FROM_HANDLE(kk_acceleration_structure, as, handle);
+      desc.as_gpu_resource_id = as->gpu_resource_id;
+   }
+   write_desc(set, binding, elem, &desc, sizeof(desc));
+}
