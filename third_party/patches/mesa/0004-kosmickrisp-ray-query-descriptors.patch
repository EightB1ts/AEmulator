+/* The ADDRESS of a descriptor slot, rather than its contents.
+ *
+ * Only VK_DESCRIPTOR_TYPE_ACCELERATION_STRUCTURE_KHR needs this. Every other
+ * descriptor is a value the shader loads and uses, but MSL has no way to build
+ * a raytracing::acceleration_structure out of a MTLResourceID held in a
+ * register — the only constructor is a dereference of a device pointer to the
+ * id (see kk_acceleration_structure() in nir_to_msl.c). So the shader carries
+ * the slot address and does the load itself, which also means the descriptor
+ * can be rewritten between dispatches without recompiling.
+ */
+static nir_def *
+load_descriptor_addr(nir_builder *b, uint32_t set, uint32_t binding,
+                     nir_def *index, const struct lower_descriptors_ctx *ctx)
+{
+   const struct kk_descriptor_set_binding_layout *binding_layout =
+      get_binding_layout(set, binding, ctx);
+
+   assert(binding_layout->stride > 0);
+
+   if (ctx->clamp_desc_array_bounds)
+      index =
+         nir_umin(b, index, nir_imm_int(b, binding_layout->array_size - 1));
+
+   nir_def *offset =
+      nir_iadd_imm(b, nir_imul_imm(b, index, binding_layout->stride),
+                   binding_layout->offset);
+
+   return nir_iadd(b, load_descriptor_set_addr(b, set, ctx),
+                   nir_u2u64(b, offset));
+}
+
