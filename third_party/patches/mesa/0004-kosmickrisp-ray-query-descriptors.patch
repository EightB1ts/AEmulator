+/* VK_DESCRIPTOR_TYPE_ACCELERATION_STRUCTURE_KHR.
+ *
+ * Metal names an acceleration structure by MTLResourceID, exactly like a
+ * texture, so the descriptor is the same 8 bytes as a storage image. What
+ * differs is how the shader consumes it: a texture is fetched by the argument
+ * table, while MSL only builds a raytracing::acceleration_structure by
+ * dereferencing a device pointer to the resource id. So the ray query lowering
+ * hands the shader the ADDRESS of this slot rather than its contents, and
+ * nir_to_msl's kk_acceleration_structure() does the load. Keep it 8 bytes: the
+ * MSL side reinterprets the slot as the structure object itself, and a wider
+ * descriptor would put padding where Metal expects the handle.
+ */
+struct kk_acceleration_structure_descriptor {
+   uint64_t as_gpu_resource_id;
+};
+
+static_assert(sizeof(struct kk_acceleration_structure_descriptor) == 8,
+              "kk_acceleration_structure_descriptor has no holes");
+
 /* This has to match nir_address_format_64bit_bounded_global */
