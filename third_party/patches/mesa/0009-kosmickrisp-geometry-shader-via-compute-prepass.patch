+static enum mtl_primitive_type
+mesa_prim_to_mtl_primitive_type(enum mesa_prim prim)
+{
+   switch (prim) {
+   case MESA_PRIM_POINTS:
+      return MTL_PRIMITIVE_TYPE_POINT;
+   case MESA_PRIM_LINES:
+      return MTL_PRIMITIVE_TYPE_LINE;
+   case MESA_PRIM_LINE_STRIP:
+      return MTL_PRIMITIVE_TYPE_LINE_STRIP;
+   case MESA_PRIM_TRIANGLES:
+      return MTL_PRIMITIVE_TYPE_TRIANGLE;
+   case MESA_PRIM_TRIANGLE_STRIP:
+      return MTL_PRIMITIVE_TYPE_TRIANGLE_STRIP;
+   default:
+      UNREACHABLE("Unsupported primitive type");
+   }
+}
+
+/* The input primitive the geometry shader's software input assembly decomposes.
+ * This is NOT what Metal rasterizes — that comes from the shader's output
+ * primitive (see kk_gs_rast_draw). The tessellation arm is written out because
+ * that is where it comes from once GS-after-tessellation lands; today
+ * kk_compile_shaders() refuses that combination, so it never fires. */
+static enum mesa_prim
+kk_gs_in_prim(struct kk_cmd_buffer *cmd, const struct kk_draw_command *data)
+{
+   struct kk_shader *tese = cmd->state.shaders[MESA_SHADER_TESS_EVAL];
+
+   return tese ? cmd->state.gfx.tess.prim : data->prim;
+}
+
+/* Parameters the geometry shader's surviving program reads. The RAST vertex
+ * shader needs the input topology (its software input assembly applies it) and
+ * the per-instance input primitive count, which is how it inverts its
+ * vertex/instance ID back into (input primitive, output vertex).
+ *
+ * Everything to do with transform feedback, the count buffer and the pipeline
+ * statistics counters stays zero: libpoly only dereferences those from the COUNT
+ * and PRE programs, and kk_lower_gs() refuses any shader that would need them.
+ * params.draw is filled in but never read by the GPU: it is the descriptor an
+ * indirect draw would be issued from, and kk_draw() refuses indirect draws with
+ * a geometry shader. The CPU does read params.draw.index_count, which is how a
+ * dynamic topology's output index buffer gets sized. */
+static uint64_t
+kk_upload_geometry_params(struct kk_cmd_buffer *cmd,
+                          const struct kk_draw_command *cmd_data,
+                          const struct kk_draw_data *data)
+{
+   struct kk_shader *vs = cmd->state.shaders[MESA_SHADER_VERTEX];
+   const struct poly_gs_info *gsi = &vs->info.gs;
+   const uint32_t wg_size[3] = {64, 1, 1};
+
+   enum mesa_prim in_prim = kk_gs_in_prim(cmd, cmd_data);
+
+   struct poly_geometry_params params;
+   poly_geometry_params_init(&params, in_prim, wg_size);
+
+   cmd->state.gfx.gs.index_addr = 0u;
+   cmd->state.gfx.gs.index_count = 0u;
+
+   if (!kk_grid_is_indirect(data->grid)) {
+      poly_geometry_params_set_draw(&params, in_prim, gsi->shape,
+                                    gsi->max_indices, data->grid.size.x,
+                                    data->grid.size.y);
+
+      /* A dynamic output topology means the MAIN geometry program writes the
+       * indices at draw time, so it needs somewhere to write them. libpoly's
+       * layout is dense: max_indices 32-bit indices per input primitive, across
+       * every instance, which is exactly poly_gs_rast_vertices() for this shape.
+       *
+       * poly_gs_setup_indirect() would take this out of the device heap, but
+       * that heap is bump-allocated by the GPU and the CPU cannot know where its
+       * top is mid-command-buffer. The command pool is the CPU-side equivalent
+       * and is what the tessellation path allocates its buffers from too. */
+      if (gsi->shape == POLY_GS_SHAPE_DYNAMIC_INDEXED &&
+          params.draw.index_count) {
+         struct kk_ptr indices =
+            kk_pool_alloc(cmd, params.draw.index_count * sizeof(uint32_t), 4u);
+
+         /* On failure leave both the param and the state at zero: kk_launch_gs
+          * reads index_count and skips the draw rather than dispatching MAIN at
+          * a null index buffer. */
+         params.output_index_buffer = indices.gpu;
+         if (indices.gpu) {
+            cmd->state.gfx.gs.index_addr = indices.gpu;
+            cmd->state.gfx.gs.index_count = params.draw.index_count;
+         }
+      }
+   }
+
+   return kk_pool_upload(cmd, &params, sizeof(params), 8).gpu;
+}
+
+/* Upload the geometry shader's static output index buffer, unrolled from strips
+ * separated by a restart index into an independent primitive list. Returns the
+ * number of indices and the address they were uploaded to.
+ *
+ * This is per draw rather than cached on the shader because it is small — the
+ * unrolled list is bounded by 3 * ARRAY_SIZE(gsi->topology) = 192 indices, so
+ * 768 bytes — and because the command pool is the only allocator available
+ * here. If a real workload ever shows this in a profile, the place to cache it
+ * is the kk_shader, uploaded once per command buffer. */
+static uint32_t
+kk_upload_gs_static_indices(struct kk_cmd_buffer *cmd,
+                            const struct poly_gs_info *gsi, uint64_t *addr_out)
+{
+   /* Per draw, so the provoking mode is simply read here — the unrolled list is
+    * mode-specific and a pipeline-compile-time cache would have to key on it. */
+   bool provoking_last = kk_rotate_provoking(cmd);
+
+   uint32_t count = kk_gs_unroll_static_topology(gsi, NULL, provoking_last);
+   if (count == 0u) {
+      *addr_out = 0u;
+      return 0u;
+   }
+
+   struct kk_ptr indices =
+      kk_pool_alloc(cmd, count * sizeof(uint32_t), sizeof(uint32_t));
+   if (unlikely(!indices.gpu)) {
+      *addr_out = 0u;
+      return 0u;
+   }
+
+   kk_gs_unroll_static_topology(gsi, (uint32_t *)indices.cpu, provoking_last);
+   *addr_out = indices.gpu;
+   return count;
+}
+
+/* Give one of the two NON-indexed geometry-shader output shapes an index buffer,
+ * for last-vertex provoking only.
+ *
+ * Both shapes hand Metal the geometry shader's output vertices in emission
+ * order, and Metal reads the flat-shaded value off the first vertex of each
+ * primitive with no state to say otherwise. An index buffer is the only way to
+ * name them in a different order — and naming them is enough, because RAST
+ * derives the output vertex from the vertex ID, which for an indexed draw is the
+ * index VALUE. The draw's instancing is untouched, so poly_gs_rast_instances()
+ * still describes it and the RAST shader's ID inversion is unchanged.
+ *
+ *   STATIC_PER_PRIM      the output is a strip 0..max_indices-1 redrawn per
+ *                        input primitive, so this is the STATIC_INDEXED case
+ *                        over the identity topology: decompose and rotate.
+ *                        Bounded by 3 * max_indices, i.e. 192 indices.
+ *   STATIC_PER_INSTANCE  the output already pattern-matched an independent
+ *                        primitive list, so there is nothing to decompose and
+ *                        this is the rotation alone — but over the whole draw,
+ *                        one index per output vertex (max_indices * input
+ *                        primitives). That is the one place this costs
+ *                        something proportional to the draw, and it is only
+ *                        reached by a flat-shaded last-vertex geometry draw.
+ *
+ * Returns the index count and the address, or 0 if there was nothing to draw or
+ * the pool is exhausted — the caller treats both the way the static-index path
+ * does, by issuing an empty draw rather than a wrong one.
+ */
+static uint32_t
+kk_upload_gs_rotated_indices(struct kk_cmd_buffer *cmd,
+                             const struct poly_gs_info *gsi, uint32_t prims,
+                             uint64_t *addr_out)
+{
+   const enum mesa_prim mode = gsi->mode;
+   const uint32_t per_prim = mesa_vertices_per_prim(mode);
+   const bool strip = gsi->shape == POLY_GS_SHAPE_STATIC_PER_PRIM;
+   uint32_t out_prims;
+
+   *addr_out = 0u;
+   assert(strip || gsi->shape == POLY_GS_SHAPE_STATIC_PER_INSTANCE);
+
+   if (strip)
+      out_prims = u_decomposed_prims_for_vertices(mode, gsi->max_indices);
+   else
+      out_prims = (gsi->max_indices / per_prim) * prims;
+
+   uint32_t count = out_prims * per_prim;
+   if (count == 0u)
+      return 0u;
+
+   struct kk_ptr indices =
+      kk_pool_alloc(cmd, count * sizeof(uint32_t), sizeof(uint32_t));
+   if (unlikely(!indices.gpu))
+      return 0u;
+
+   uint32_t *out = (uint32_t *)indices.cpu;
+   for (uint32_t p = 0u; p < out_prims; ++p) {
+      for (uint32_t v = 0u; v < per_prim; ++v) {
+         uint32_t slot = kk_provoking_slot(v, per_prim, true);
+
+         /* The strip's vertex order is the mode's; the list's is the identity,
+          * which poly_vertex_id_for_topology() would also return, spelled out
+          * here because `mode` is the already-decomposed form there. */
+         out[(p * per_prim) + v] =
+            strip ? poly_vertex_id_for_topology(mode, false /* flatshade first */,
+                                                p, slot, out_prims)
+                  : ((p * per_prim) + slot);
+      }
+   }
+
+   *addr_out = indices.gpu;
+   return count;
+}
+
+/* Rewrite a draw so that Metal rasterizes the geometry shader's output.
+ *
+ * For the two shapes libpoly can express without an index buffer this is purely
+ * a reshaping of the draw — no extra dispatch, no allocation:
+ *
+ *   STATIC_PER_PRIM      the output is a strip whose indices are 0..n-1, so draw
+ *                        max_indices vertices and let hardware instancing walk
+ *                        the input primitives: instances = prims * app instances.
+ *   STATIC_PER_INSTANCE  the output pattern-matched a primitive list, so all the
+ *                        input primitives fit in one instance's vertex range:
+ *                        vertices = max_indices * prims, instances = app
+ *                        instances, and the primitive type is the decomposed
+ *                        (list) form.
+ *   STATIC_INDEXED       the output is a constant index buffer with restarts in
+ *                        it. Metal has none, so draw the unrolled list instead:
+ *                        same instancing as STATIC_PER_PRIM, but the vertex
+ *                        count is the unrolled index count rather than
+ *                        max_indices, and the primitive type is decomposed.
+ *
+ * poly_gs_rast_vertices/instances own the first two; the shader was compiled
+ * against the same shape, so these must agree with it. DYNAMIC_INDEXED does not
+ * come through here at all — its draw is built by kk_launch_gs() out of what the
+ * unroll kernel computes on the GPU.
+ *
+ * baseVertex and baseInstance are deliberately zero: the RAST shader's ID
+ * inversion assumes zero-based IDs, and the app's firstVertex/firstInstance were
+ * already consumed by the vertex prepass through per-draw data. */
+static struct kk_draw_data
+kk_gs_rast_draw(struct kk_cmd_buffer *cmd, struct kk_draw_data draw,
+                enum mesa_prim in_prim)
+{
+   struct kk_shader *vs = cmd->state.shaders[MESA_SHADER_VERTEX];
+   const struct poly_gs_info *gsi = &vs->info.gs;
+
+   assert(gsi->shape != POLY_GS_SHAPE_DYNAMIC_INDEXED && "built by kk_launch_gs");
+
+   /* gsi->mode is what the shader declared, except that libpoly's
+    * match_list_topology() rewrites it to the decomposed (list) form when it
+    * picks STATIC_PER_INSTANCE. Decomposing again here would be wrong for the
+    * strip case, and not decomposing would be wrong for the unrolled one. */
+   uint32_t prims =
+      u_decomposed_prims_for_vertices(in_prim, draw.grid.size.x);
+   uint32_t instances = draw.grid.size.y;
+   uint32_t rast_instances =
+      poly_gs_rast_instances(gsi->shape, gsi->max_indices, prims, instances);
+
+   /* An index buffer names the output vertices in an order Metal will read the
+    * provoking one first from; see kk_upload_gs_rotated_indices(). The
+    * instancing and the RAST ID inversion are the same either way, so this is
+    * only ever a different vertex count, index buffer and primitive type. */
+   uint64_t addr = 0u;
+   uint32_t count = 0u;
+
+   if (gsi->shape == POLY_GS_SHAPE_STATIC_INDEXED) {
+      count = kk_upload_gs_static_indices(cmd, gsi, &addr);
+   } else if (kk_rotate_provoking(cmd) &&
+              mesa_vertices_per_prim(gsi->mode) > 1u) {
+      count = kk_upload_gs_rotated_indices(cmd, gsi, prims, &addr);
+   } else {
+      return (struct kk_draw_data){
+         .grid = kk_grid_3d(poly_gs_rast_vertices(gsi->shape, gsi->max_indices,
+                                                  prims, instances),
+                            rast_instances, 0u),
+         .primitive_type = mesa_prim_to_mtl_primitive_type(gsi->mode),
+      };
+   }
+
+   return (struct kk_draw_data){
+      .grid = kk_grid_3d(count, rast_instances, 0u),
+      .index = {.gpu = {addr, count * sizeof(uint32_t)},
+                .el_size_B = sizeof(uint32_t)},
+      .primitive_type =
+         mesa_prim_to_mtl_primitive_type(u_decomposed_prim(gsi->mode)),
+   };
+}
