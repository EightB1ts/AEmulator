+/* Run everything a geometry shader needs before the render encoder, and return
+ * the draw that rasterizes its output.
+ *
+ * For a static output topology that is just the vertex prepass: libpoly strips
+ * every side effect out of the MAIN geometry program and only makes it write
+ * indices for a dynamic output topology, so MAIN is provably empty there and the
+ * app's geometry-shader body runs (once per output vertex) inside the RAST
+ * vertex shader instead.
+ *
+ * A dynamic output topology costs two more dispatches:
+ *
+ *   MAIN    one thread per (input primitive, instance). Emits the vertex indices
+ *           this primitive produced into cmd->state.gfx.gs.index_addr, as strips
+ *           separated by the restart index 0xFFFFFFFF and padded out to
+ *           max_indices with more restart indices.
+ *   UNROLL  libkk_unroll_geometry, the same kernel that unrolls an application
+ *           index buffer with primitive restart in it. It rewrites those strips
+ *           as independent primitives in the device heap and writes the indexed
+ *           indirect draw descriptor for them, because METAL HAS NO PRIMITIVE
+ *           RESTART. The index values are copied through untouched, so RAST's
+ *           (vertex ID -> input primitive, output vertex) inversion is unchanged
+ *           by the unroll; only their order and their count change.
+ *
+ * The cost of that is real and worth stating: the unrolled buffer is up to
+ * verts_per_prim/1 times the size of the restart-separated one (3x for the
+ * triangle strips almost every geometry shader emits), it is allocated out of
+ * the 128 MiB device heap which is only reclaimed when the command buffer
+ * completes, and it serialises two extra compute dispatches ahead of the draw.
+ */
+static struct kk_draw_data
+kk_launch_gs(struct kk_cmd_buffer *cmd, struct kk_draw_data draw,
+             enum mesa_prim in_prim)
+{
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+   struct kk_shader *vs = cmd->state.shaders[MESA_SHADER_VERTEX];
+   const struct poly_gs_info *gsi = &vs->info.gs;
+   struct kk_graphics_state *gfx = &cmd->state.gfx;
+
+   mtl_compute_encoder *enc = cs_get_compute(cmd, true);
+   mtl_barrier_after_encoder_stages(enc, MTL_STAGE_DISPATCH, MTL_STAGE_DISPATCH);
+   mtl_compute_set_pipeline_state(enc, vs->pipeline.gfx.pre_render[0]);
+   kk_dispatch_compute(enc, kk_grid_2d(draw.grid.size.x, draw.grid.size.y),
+                       (struct mtl_size){64, 1, 1});
+
+   if (gsi->shape != POLY_GS_SHAPE_DYNAMIC_INDEXED)
+      return kk_gs_rast_draw(cmd, draw, in_prim);
+
+   bool provoking_last = kk_rotate_provoking(cmd);
+
+   /* Nothing to rasterize, and libkk_unroll_geometry would allocate a zero-sized
+    * index buffer for it. Return an empty direct draw, which kk_dispatch_draw
+    * skips. */
+   if (gfx->gs.index_count == 0u)
+      return (struct kk_draw_data){.grid = kk_grid_1d(0u)};
+
+   /* kk_lower_gs() compiles MAIN for exactly this shape and kk_gs_data_serialize
+    * carries it through the pipeline cache, so a null here is a driver bug — but
+    * it is one Metal would answer with a crash inside the encoder, so name it. */
+   mtl_compute_pipeline_state *main = vs->pipeline.gfx.gs[KK_GS_VARIANT_MAIN];
+   if (unlikely(main == NULL)) {
+      mesa_loge("kosmickrisp: a geometry shader with a dynamic output topology "
+                "reached the draw without its MAIN program");
+      vk_command_buffer_set_error(&cmd->vk, VK_ERROR_UNKNOWN);
+      return (struct kk_draw_data){.grid = kk_grid_1d(0u)};
+   }
+
+   uint32_t prims = u_decomposed_prims_for_vertices(in_prim, draw.grid.size.x);
+
+   mtl_barrier_after_encoder_stages(enc, MTL_STAGE_DISPATCH, MTL_STAGE_DISPATCH);
+   mtl_compute_set_pipeline_state(enc, main);
+   kk_dispatch_compute(enc, kk_grid_2d(prims, draw.grid.size.y),
+                       (struct mtl_size){64, 1, 1});
+
+   /* libkk_unroll_geometry consumes an indirect draw descriptor, so hand it the
+    * one this draw would have had: every index MAIN wrote, one instance (the app
+    * instances are already unrolled into the index values), no offsets. */
+   uint32_t in_draw[5] = {gfx->gs.index_count, 1u, 0u, 0u, 0u};
+   struct kk_ptr in = kk_pool_upload(cmd, in_draw, sizeof(in_draw), 4u);
+   struct kk_ptr out =
+      kk_pool_alloc(cmd, sizeof(VkDrawIndexedIndirectCommand), 4u);
+   if (unlikely(!in.gpu || !out.gpu))
+      return (struct kk_draw_data){.grid = kk_grid_1d(0u)};
+
+   struct libkk_unroll_geometry_args unroll = {
+      .index_buffer = gfx->gs.index_addr,
+      .heap = kk_heap(cmd),
+      .in_draw = in.gpu,
+      .out_draw = out.gpu,
+      .in_draw_stride_el = ARRAY_SIZE(in_draw),
+      /* poly_pad_index_gs()/_poly_write_strip() write -1 for both the strip
+       * separator and the tail padding. */
+      .restart_index = UINT32_MAX,
+      .index_buffer_size_el = gfx->gs.index_count,
