+/* Unroll libpoly's static index buffer into independent primitives.
+ *
+ * POLY_GS_SHAPE_STATIC_INDEXED means the geometry shader's output indices are a
+ * compile-time constant, but they are a constant in the strips-separated-by-a-
+ * restart-index encoding: 0, 1, 2, 3, 0xFF, 4, 5, 6, 7. Metal has no primitive
+ * restart, so rewrite that into the equivalent primitive list — 0,1,2, 1,3,2,
+ * 4,5,6, 5,7,6 for that example — which any API can draw.
+ *
+ * Writes `out` (which must hold the returned count, so call with NULL first) and
+ * returns the number of unrolled indices.
+ *
+ * WHICH vertex ends up first matters, because Metal reads the flat-shaded value
+ * off the first vertex of a primitive and has no state to change that. Two
+ * things follow from provoking_last, and BOTH are needed — one without the other
+ * makes a flat-shaded strip pick a different vertex here than the rasterizer
+ * does, silently:
+ *
+ *   1. the strip is decomposed in that mode's vertex order. libpoly's
+ *      poly_vertex_id_for_topology() already does this; it is the same
+ *      flatshade_first argument the GPU unroll kernel takes. For a triangle
+ *      strip: first gives (0,1,2), (1,3,2); last gives (0,1,2), (2,1,3).
+ *   2. each primitive is then rotated one step to the right, moving the vertex
+ *      Vulkan calls provoking — the LAST one in that order — into slot 0, where
+ *      Metal looks. (0,1,2), (2,1,3) becomes (2,0,1), (3,2,1). A cyclic
+ *      rotation does not change the winding, so facing and culling are
+ *      unaffected; libkk_rotate_provoking does the same thing on the GPU for the
+ *      dynamic-topology shape.
+ *
+ * Rotating is expressed as a shift of the vertex index handed to libpoly rather
+ * than a second pass over `out`, so the two shapes cannot drift apart.
+ */
+uint32_t
+kk_gs_unroll_static_topology(const struct poly_gs_info *gsi, uint32_t *out,
+                             bool provoking_last)
+{
+   const enum mesa_prim mode = gsi->mode;
+   const uint32_t per_prim = mesa_vertices_per_prim(mode);
+   /* poly writes the restart index as -1 into a uint8_t array. */
+   const uint8_t restart_index = (uint8_t)~0u;
+   const bool flatshade_first = !provoking_last;
+   uint32_t written = 0u;
+
+   assert(gsi->shape == POLY_GS_SHAPE_STATIC_INDEXED);
+
+   for (uint32_t needle = 0u; needle < gsi->max_indices;) {
+      uint32_t end = needle;
+      while (end < gsi->max_indices && gsi->topology[end] != restart_index)
+         ++end;
+
+      uint32_t prims = u_decomposed_prims_for_vertices(mode, end - needle);
+      for (uint32_t i = 0u; i < prims; ++i) {
+         for (uint32_t v = 0u; v < per_prim; ++v) {
+            uint32_t slot = kk_provoking_slot(v, per_prim, provoking_last);
+            uint32_t id =
+               poly_vertex_id_for_topology(mode, flatshade_first, i, slot,
+                                           prims);
+            assert(needle + id < end);
+            if (out)
+               out[written] = gsi->topology[needle + id];
+            written++;
+         }
+      }
+
+      needle = end + 1u;
+   }
+
+   return written;
+}
