+/* One requirement per aspect. kk refuses sparse on multi-planar and on
+ * separate-plane depth/stencil formats, so the count is always 0 or 1. */
+static void
+kk_get_image_sparse_memory_requirements(
+   struct kk_device *dev, struct kk_image *image,
+   uint32_t *pSparseMemoryRequirementCount,
+   VkSparseImageMemoryRequirements2 *pSparseMemoryRequirements)
+{
+   struct kk_sparse_image_geom g;
+
+   if (!image->sparse || !kk_sparse_image_geom(dev, image, 0, &g)) {
+      *pSparseMemoryRequirementCount = 0u;
+      return;
+   }
+
+   VK_OUTARRAY_MAKE_TYPED(VkSparseImageMemoryRequirements2, out,
+                          pSparseMemoryRequirements,
+                          pSparseMemoryRequirementCount);
+
+   vk_outarray_append_typed(VkSparseImageMemoryRequirements2, &out, req)
+   {
+      VkSparseImageFormatFlags flags = 0;
+
+      /* Metal's tile is the Vulkan standard block shape only for single-sample
+       * 2D; see kk_sparse_image_geom. Anything else has to say so, or an
+       * application that assumes the standard table will bind garbage. */
+      if (!g.standard_block_shape)
+         flags |= VK_SPARSE_IMAGE_FORMAT_NONSTANDARD_BLOCK_SIZE_BIT;
+
+      /* Each array slice's tail maps separately (Metal takes a slice index on
+       * the tail level), so this is emphatically not a single mip tail. */
+
+      req->memoryRequirements = (VkSparseImageMemoryRequirements){
+         .formatProperties =
+            {
+               .aspectMask = image->vk.aspects,
+               .imageGranularity = {g.tile_px[0], g.tile_px[1], g.tile_px[2]},
+               .flags = flags,
+            },
+         .imageMipTailFirstLod = g.mip_tail_first_lod,
+         .imageMipTailSize = g.mip_tail_size_B,
+         .imageMipTailOffset = g.mip_tail_offset_B,
+         .imageMipTailStride = g.mip_tail_stride_B,
+      };
+   }
+}
