diff --git a/src/kosmickrisp/bridge/mtl_sparse.h b/src/kosmickrisp/bridge/mtl_sparse.h
new file mode 100644
index 0000000..d00cf16
--- /dev/null
+++ b/src/kosmickrisp/bridge/mtl_sparse.h
@@ -0,0 +1,123 @@
+/*
+ * Copyright 2025 LunarG, Inc.
+ * Copyright 2025 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef MTL_SPARSE_H
+#define MTL_SPARSE_H 1
+
+#include "mtl_types.h"
+
+#include <inttypes.h>
+#include <stdbool.h>
+
+/* TODO_KOSMICKRISP We should move this struct to the bridge side. */
+struct kk_image_layout;
+
+/* PLACEMENT SPARSE.
+ *
+ * Metal has two unrelated sparse mechanisms and only the newer one can express
+ * Vulkan's sparse binding:
+ *
+ *   - MTLHeapTypeSparse, a tile POOL. -[MTLResourceStateCommandEncoder
+ *     updateTextureMapping:...] maps a texture region from it, but Metal picks
+ *     which tiles, so VkSparseMemoryBind::memoryOffset cannot be honoured.
+ *
+ *   - Placement sparse (macOS 26). The resource is created from the *device*
+ *     with a placementSparsePageSize, and its pages are then pointed at
+ *     explicit tile offsets of an MTLHeapTypePlacement heap. That is exactly
+ *     Vulkan's model: a virtual resource plus (memory, memoryOffset) per block.
+ *
+ * Metal 4 also moved these calls off the resource-state encoder and onto
+ * MTL4CommandQueue itself, the same way it moved acceleration-structure builds
+ * onto MTL4ComputeCommandEncoder. A queue-timeline operation is precisely the
+ * shape of vkQueueBindSparse, so kk_queue_submit can issue them directly.
+ *
+ * Measured on an Apple M2 / macOS 27.0 by
+ * crates/aemulator-hvf/kosmickrisp/mtl4-sparse-matrix.m: supportsPlacementSparse
+ * is YES, buffers report MTLBufferSparseTier1 and textures
+ * MTLTextureSparseTier1, explicit heap tile offsets are honoured, ONE resource
+ * can be backed from SEVERAL heaps at once, two resource tiles may alias one
+ * heap tile, unmapping restores reads-return-zero, and unbacked reads return
+ * zero across a submit boundary. Unlike Metal 4 ray tracing on the same GPU,
+ * this hardware really does what the API advertises.
+ */
+enum mtl_sparse_page_size {
+   MTL_SPARSE_PAGE_SIZE_16 = 101,
+   MTL_SPARSE_PAGE_SIZE_64 = 102,
+   MTL_SPARSE_PAGE_SIZE_256 = 103,
+};
+
+/* 64 KiB is not an arbitrary pick. It is the ONE page size whose 2D tile shape
+ * equals the Vulkan "standard sparse image block shape" for every
+ * bits-per-pixel class at once — 256x256 / 256x128 / 128x128 / 128x64 / 64x64
+ * for 8/16/32/64/128 bpp — which is what lets kk report
+ * sparseResidencyStandard2DBlockShape truthfully. It also makes the sparse
+ * block 65536 B, Vulkan's standard block size. At 16 KiB and 256 KiB every
+ * shape differs. Measured by mtl4-sparse-matrix.m. */
+#define MTL_SPARSE_PAGE_SIZE_DEFAULT MTL_SPARSE_PAGE_SIZE_64
+
+/* Whether this device implements placement sparse at all. */
+bool mtl_device_supports_placement_sparse(mtl_device *device);
+
+/* Bytes backing one tile at the given page size. */
+uint64_t mtl_sparse_page_size_B(mtl_device *device,
+                                enum mtl_sparse_page_size page);
+
+/* Tile footprint in PIXELS for a layout's texture type/format/sample count. */
+struct mtl_size mtl_sparse_tile_size_px(mtl_device *device,
+                                        const struct kk_image_layout *layout,
+                                        enum mtl_sparse_page_size page);
+
+/* Placement sparse resources come from the DEVICE, not from a heap: they have
+ * an address range from birth and acquire physical pages later. Both must be
+ * MTLStorageModePrivate — Metal asserts `Invalid Storage Mode 0 for Placement
+ * Sparse Buffer' on Shared, which is why these do not take resource options
+ * the way the non-sparse constructors do. A Shared *heap* may still back them,
+ * so host-visible VkDeviceMemory is not lost. */
+mtl_buffer *mtl_new_placement_sparse_buffer(mtl_device *device, uint64_t size_B,
+                                            enum mtl_sparse_page_size page);
+mtl_texture *
+mtl_new_placement_sparse_texture(mtl_device *device,
+                                 const struct kk_image_layout *layout,
+                                 enum mtl_sparse_page_size page);
+
+/* Mip tail. Levels below first_mipmap_in_tail are individually tiled; every
+ * level from it onwards is packed into one tail that maps as a unit, which is
+ * Vulkan's imageMipTailFirstLod / imageMipTailSize. */
+uint32_t mtl_texture_first_mipmap_in_tail(mtl_texture *texture);
+uint64_t mtl_texture_tail_size_B(mtl_texture *texture);
+
+/* Is the texture actually sparse (a nil-safe MTLTexture.isSparse)? */
+bool mtl_texture_is_sparse(mtl_texture *texture);
+
+/* A run of buffer tiles. All counts and offsets are in TILES, not bytes. */
+struct mtl_sparse_buffer_region {
+   uint64_t resource_tile;
+   uint64_t tile_count;
+   uint64_t heap_tile;
+};
+
+/* A tile-space box within one mip level of one array slice. */
+struct mtl_sparse_texture_region {
+   uint32_t origin_tl[3];
+   uint32_t size_tl[3];
+   uint32_t level;
+   uint32_t slice;
+   uint64_t heap_tile;
+};
+
+/* Queue-timeline mapping updates. `heap` is per-call, so the caller batches
+ * regions that share a heap and a direction; pass heap == NULL to unmap.
+ * Callers must also barrier against MTL_STAGE_RESOURCE_STATE before the GPU
+ * touches the remapped resource. */
+void mtl_queue_update_buffer_mappings(
+   mtl_command_queue *queue, mtl_buffer *buffer, mtl_heap *heap, bool unmap,
+   const struct mtl_sparse_buffer_region *regions, uint32_t count);
+
+void mtl_queue_update_texture_mappings(
+   mtl_command_queue *queue, mtl_texture *texture, mtl_heap *heap, bool unmap,
+   const struct mtl_sparse_texture_region *regions, uint32_t count);
+
+#endif /* MTL_SPARSE_H */
diff --git a/src/kosmickrisp/bridge/mtl_sparse.m b/src/kosmickrisp/bridge/mtl_sparse.m
new file mode 100644
index 0000000..eae2202
--- /dev/null
+++ b/src/kosmickrisp/bridge/mtl_sparse.m
@@ -0,0 +1,194 @@
+/*
+ * Copyright 2025 LunarG, Inc.
+ * Copyright 2025 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "mtl_sparse.h"
+
+/* TODO_KOSMICKRISP Remove */
+#include "kk_private.h"
+#include "kk_image_layout.h"
+
+#include <Metal/MTL4CommandQueue.h>
+#include <Metal/MTLBuffer.h>
+#include <Metal/MTLDevice.h>
+#include <Metal/MTLHeap.h>
+#include <Metal/MTLTexture.h>
+
+bool
+mtl_device_supports_placement_sparse(mtl_device *device)
+{
+   @autoreleasepool {
+      id<MTLDevice> dev = (id<MTLDevice>)device;
+      /* supportsPlacementSparse arrived later than the placement-sparse
+       * constructors themselves, so a build can have the API and not the query.
+       * Absent the query, the constructors are the authority and kk falls back
+       * to probing one. */
+      if (![dev respondsToSelector:@selector(supportsPlacementSparse)])
+         return [dev respondsToSelector:@selector
+                     (newBufferWithLength:options:placementSparsePageSize:)];
+      return dev.supportsPlacementSparse;
+   }
+}
+
+uint64_t
+mtl_sparse_page_size_B(mtl_device *device, enum mtl_sparse_page_size page)
+{
+   @autoreleasepool {
+      id<MTLDevice> dev = (id<MTLDevice>)device;
+      return [dev sparseTileSizeInBytesForSparsePageSize:(MTLSparsePageSize)page];
+   }
+}
+
+struct mtl_size
+mtl_sparse_tile_size_px(mtl_device *device,
+                        const struct kk_image_layout *layout,
+                        enum mtl_sparse_page_size page)
+{
+   @autoreleasepool {
+      id<MTLDevice> dev = (id<MTLDevice>)device;
+      MTLSize s = [dev sparseTileSizeWithTextureType:(MTLTextureType)layout->type
+                                        pixelFormat:layout->format.mtl
+                                        sampleCount:layout->sample_count_sa
+                                     sparsePageSize:(MTLSparsePageSize)page];
+      return (struct mtl_size){s.width, s.height, s.depth};
+   }
+}
+
+mtl_buffer *
+mtl_new_placement_sparse_buffer(mtl_device *device, uint64_t size_B,
+                                enum mtl_sparse_page_size page)
+{
+   @autoreleasepool {
+      id<MTLDevice> dev = (id<MTLDevice>)device;
+      /* Private, not KK_MTL_RESOURCE_OPTIONS: Metal hard-asserts on a Shared
+       * placement sparse buffer. See mtl_sparse.h. */
+      return (mtl_buffer *)[dev newBufferWithLength:size_B
+                                           options:MTLResourceStorageModePrivate
+                           placementSparsePageSize:(MTLSparsePageSize)page];
+   }
+}
+
+mtl_texture *
+mtl_new_placement_sparse_texture(mtl_device *device,
+                                 const struct kk_image_layout *layout,
+                                 enum mtl_sparse_page_size page)
+{
+   @autoreleasepool {
+      id<MTLDevice> dev = (id<MTLDevice>)device;
+      MTLTextureDescriptor *d = [[MTLTextureDescriptor new] autorelease];
+      d.textureType = (MTLTextureType)layout->type;
+      d.pixelFormat = layout->format.mtl;
+      d.width = layout->width_px;
+      d.height = layout->height_px;
+      d.depth = layout->depth_px;
+      d.mipmapLevelCount = layout->levels;
+      d.sampleCount = layout->sample_count_sa;
+      d.arrayLength = layout->layers;
+      d.allowGPUOptimizedContents = layout->optimized_layout;
+      d.usage = (MTLTextureUsage)layout->usage;
+      d.storageMode = MTLStorageModePrivate;
+      d.placementSparsePageSize = (MTLSparsePageSize)page;
+      return (mtl_texture *)[dev newTextureWithDescriptor:d];
+   }
+}
+
+uint32_t
+mtl_texture_first_mipmap_in_tail(mtl_texture *texture)
+{
+   @autoreleasepool {
+      id<MTLTexture> t = (id<MTLTexture>)texture;
+      if (![t respondsToSelector:@selector(firstMipmapInTail)])
+         return 0u;
+      return (uint32_t)t.firstMipmapInTail;
+   }
+}
+
+uint64_t
+mtl_texture_tail_size_B(mtl_texture *texture)
+{
+   @autoreleasepool {
+      id<MTLTexture> t = (id<MTLTexture>)texture;
+      if (![t respondsToSelector:@selector(tailSizeInBytes)])
+         return 0u;
+      return t.tailSizeInBytes;
+   }
+}
+
+bool
+mtl_texture_is_sparse(mtl_texture *texture)
+{
+   @autoreleasepool {
+      id<MTLTexture> t = (id<MTLTexture>)texture;
+      if (t == nil || ![t respondsToSelector:@selector(isSparse)])
+         return false;
+      return t.isSparse;
+   }
+}
+
+/* Metal takes the operation array by value, so a stack batch is enough; the
+ * caller already groups by heap and direction. KK_SPARSE_BATCH bounds one
+ * -[updateBufferMappings:] call, and anything larger is split across calls,
+ * which is equivalent because operations within a single update are unordered
+ * with respect to each other anyway. */
+#define KK_SPARSE_BATCH 64
+
+void
+mtl_queue_update_buffer_mappings(mtl_command_queue *queue, mtl_buffer *buffer,
+                                 mtl_heap *heap, bool unmap,
+                                 const struct mtl_sparse_buffer_region *regions,
+                                 uint32_t count)
+{
+   @autoreleasepool {
+      id<MTL4CommandQueue> q = (id<MTL4CommandQueue>)queue;
+      id<MTLBuffer> buf = (id<MTLBuffer>)buffer;
+      id<MTLHeap> hp = unmap ? nil : (id<MTLHeap>)heap;
+      MTL4UpdateSparseBufferMappingOperation ops[KK_SPARSE_BATCH];
+
+      for (uint32_t base = 0; base < count; base += KK_SPARSE_BATCH) {
+         uint32_t n = MIN2(count - base, KK_SPARSE_BATCH);
+         for (uint32_t i = 0; i < n; ++i) {
+            const struct mtl_sparse_buffer_region *r = &regions[base + i];
+            ops[i] = (MTL4UpdateSparseBufferMappingOperation){
+               .mode = unmap ? MTLSparseTextureMappingModeUnmap
+                             : MTLSparseTextureMappingModeMap,
+               .bufferRange = NSMakeRange(r->resource_tile, r->tile_count),
+               .heapOffset = r->heap_tile,
+            };
+         }
+         [q updateBufferMappings:buf heap:hp operations:ops count:n];
+      }
+   }
+}
+
+void
+mtl_queue_update_texture_mappings(
+   mtl_command_queue *queue, mtl_texture *texture, mtl_heap *heap, bool unmap,
+   const struct mtl_sparse_texture_region *regions, uint32_t count)
+{
+   @autoreleasepool {
+      id<MTL4CommandQueue> q = (id<MTL4CommandQueue>)queue;
+      id<MTLTexture> tex = (id<MTLTexture>)texture;
+      id<MTLHeap> hp = unmap ? nil : (id<MTLHeap>)heap;
+      MTL4UpdateSparseTextureMappingOperation ops[KK_SPARSE_BATCH];
+
+      for (uint32_t base = 0; base < count; base += KK_SPARSE_BATCH) {
+         uint32_t n = MIN2(count - base, KK_SPARSE_BATCH);
+         for (uint32_t i = 0; i < n; ++i) {
+            const struct mtl_sparse_texture_region *r = &regions[base + i];
+            ops[i] = (MTL4UpdateSparseTextureMappingOperation){
+               .mode = unmap ? MTLSparseTextureMappingModeUnmap
+                             : MTLSparseTextureMappingModeMap,
+               .textureRegion = MTLRegionMake3D(r->origin_tl[0], r->origin_tl[1],
+                                                r->origin_tl[2], r->size_tl[0],
+                                                r->size_tl[1], r->size_tl[2]),
+               .textureLevel = r->level,
+               .textureSlice = r->slice,
+               .heapOffset = r->heap_tile,
+            };
+         }
+         [q updateTextureMappings:tex heap:hp operations:ops count:n];
+      }
+   }
+}
