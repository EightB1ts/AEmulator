+
+#ifndef KK_SPARSE_H
+#define KK_SPARSE_H 1
+
+#include "kk_private.h"
+
+#include "kk_image_layout.h" /* KK_MAX_MIP_LEVELS */
+
+#include "kosmickrisp/bridge/mtl_sparse.h"
+
+#include "vulkan/vulkan_core.h"
+
+#include <stdbool.h>
+
+struct kk_device;
+struct kk_image;
+struct kk_physical_device;
+struct kk_queue;
+struct vk_queue_submit;
+
+/* Device-wide sparse constants. Resolved at physical-device init because the
+ * sparse feature bools must be answerable before any VkDevice exists. */
+struct kk_sparse_caps {
+   bool supported;
+   enum mtl_sparse_page_size page_size;
+   /* Bytes per sparse block. Vulkan calls this the sparse block size and the
+    * standard value is 65536; zero when !supported. */
+   uint64_t block_size_B;
+};
+
+void kk_sparse_caps_init(struct kk_physical_device *pdev);
+
+/* Everything needed to turn Vulkan sparse binds for one image plane into Metal
+ * tile regions.
+ *
+ * OPAQUE TILE ORDER. VkSparseImageOpaqueMemoryBindInfo addresses the image as
+ * a flat byte range whose interpretation is, by definition, the driver's.
+ * Metal has no such flat space — updateTextureMappings: takes a tile box plus a
+ * level and a slice — so this is where the two are reconciled. The order is
+ * level-major, then array slice, then tiles in x, y, z:
+ *
+ *    [ level 0: slice 0 tiles, slice 1 tiles, ... ]
+ *    [ level 1: ... ] ... up to mip_tail_first_lod
+ *    [ mip tail: slice 0 tail, slice 1 tail, ... ]
+ *
+ * which puts the tail last and contiguous, so imageMipTailOffset is the tiled
+ * total and imageMipTailStride is one tail. */
+struct kk_sparse_image_geom {
+   uint64_t block_size_B;
+
+   /* Tile footprint in TEXELS. Constant across the tiled levels; that constancy
+    * is why small levels end up in the tail instead. */
+   uint32_t tile_px[3];
+
+   uint32_t levels;
+   uint32_t layers;
+
+   uint32_t mip_tail_first_lod;
+   uint64_t mip_tail_size_B;   /* one layer's tail */
+   uint64_t mip_tail_stride_B; /* between layers' tails */
+   uint64_t mip_tail_offset_B;
+
+   /* Per tiled level, tile counts for ONE layer. */
+   uint32_t tiles[KK_MAX_MIP_LEVELS][3];
+   /* Prefix sums over (level, all layers), so level_first_tile[levels_tiled]
+    * is the whole tiled tile count. */
+   uint64_t level_first_tile[KK_MAX_MIP_LEVELS + 1];
+   uint64_t tiled_tiles;
+
+   uint64_t total_size_B;
+
+   /* Whether tile_px is the Vulkan standard sparse image block shape, which
+    * decides VK_SPARSE_IMAGE_FORMAT_NONSTANDARD_BLOCK_SIZE_BIT. */
+   bool standard_block_shape;
+};
+
+bool kk_sparse_image_geom(struct kk_device *dev, const struct kk_image *image,
+                          uint8_t plane, struct kk_sparse_image_geom *geom);
+
+/* Granularity for a format/type/sample-count combination, with no VkImage and
+ * no VkDevice — what vkGetPhysicalDeviceSparseImageFormatProperties2 needs.
+ * False when sparse is unavailable for that combination. */
+bool kk_sparse_format_granularity(struct kk_physical_device *pdev,
+                                  enum pipe_format format, VkImageType type,
+                                  uint32_t samples, VkExtent3D *granularity_out,
+                                  VkSparseImageFormatFlags *flags_out);
+
+/* True for a resource whose memory arrives through vkQueueBindSparse. */
+static inline bool
+kk_create_flags_are_sparse(VkImageCreateFlags flags)
+{
+   return (flags & (VK_IMAGE_CREATE_SPARSE_BINDING_BIT |
+                    VK_IMAGE_CREATE_SPARSE_RESIDENCY_BIT)) != 0;
+}
+
+/* Consumes submit->buffer_binds / image_opaque_binds / image_binds. */
+VkResult kk_queue_bind_sparse(struct kk_queue *queue,
+                              struct vk_queue_submit *submit);
+
+#endif /* KK_SPARSE_H */
