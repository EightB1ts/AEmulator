diff --git a/src/kosmickrisp/vulkan/kk_buffer.c b/src/kosmickrisp/vulkan/kk_buffer.c
index a3508ad..6ceff17 100644
--- a/src/kosmickrisp/vulkan/kk_buffer.c
+++ b/src/kosmickrisp/vulkan/kk_buffer.c
@@ -10,6 +10,7 @@
 #include "kk_device.h"
 #include "kk_entrypoints.h"
 #include "kk_physical_device.h"
+#include "kk_sparse.h"
 
 #include "kosmickrisp/bridge/mtl_bridge.h"
 
@@ -18,6 +19,13 @@ kk_get_buffer_alignment(const struct kk_physical_device *pdev, uint64_t size,
                         VkBufferUsageFlags2KHR usage_flags,
                         VkBufferCreateFlags create_flags)
 {
+   /* A sparse buffer is bound one whole sparse block at a time, so both its
+    * size and every VkSparseMemoryBind::memoryOffset must be block-aligned.
+    * Reporting the block size here is what makes that true of the memory the
+    * application allocates for it. */
+   if (create_flags & VK_BUFFER_CREATE_SPARSE_BINDING_BIT)
+      return pdev->sparse.block_size_B;
+
    uint64_t alignment;
    mtl_heap_buffer_size_and_align_with_length(pdev->mtl_dev_handle, &size,
                                               &alignment);
@@ -46,6 +54,23 @@ kk_CreateBuffer(VkDevice device, const VkBufferCreateInfo *pCreateInfo,
    if (!buffer)
       return vk_error(dev, VK_ERROR_OUT_OF_HOST_MEMORY);
 
+   /* A sparse buffer's Metal object exists from creation, not from binding: it
+    * owns an address range immediately and acquires physical pages later,
+    * through vkQueueBindSparse. That is the opposite of the non-sparse path
+    * below, where kk_bind_buffer_memory places the MTLBuffer inside the heap. */
+   if (kk_buffer_is_sparse(buffer)) {
+      buffer->mtl_handle = mtl_new_placement_sparse_buffer(
+         dev->mtl_handle, align64(buffer->vk.size, pdev->sparse.block_size_B),
+         pdev->sparse.page_size);
+      if (buffer->mtl_handle == NULL) {
+         vk_buffer_destroy(&dev->vk, pAllocator, &buffer->vk);
+         return vk_error(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY);
+      }
+
+      buffer->vk.device_address = mtl_buffer_get_gpu_address(buffer->mtl_handle);
+      kk_device_add_buffer_to_residency_set(dev, buffer->mtl_handle);
+   }
+
    *pBuffer = kk_buffer_to_handle(buffer);
 
    return VK_SUCCESS;
@@ -61,6 +86,9 @@ kk_DestroyBuffer(VkDevice device, VkBuffer _buffer,
    if (!buffer)
       return;
 
+   if (kk_buffer_is_sparse(buffer) && buffer->mtl_handle)
+      kk_device_remove_buffer_from_residency_set(dev, buffer->mtl_handle);
+
    if (buffer->mtl_handle)
       mtl_release(buffer->mtl_handle);
 
@@ -117,9 +145,11 @@ kk_GetPhysicalDeviceExternalBufferProperties(
     */
    assert(pExternalBufferInfo->handleType != 0);
 
-   /* All of the current flags are for sparse which we don't support yet.
-    * Even when we do support it, doing sparse on external memory sounds
-    * sketchy.  Also, just disallowing flags is the safe option.
+   /* Sparse binding is implemented now, but combining it with imported or
+    * exported memory is not: an external MTLHeap is not created with a
+    * maxCompatiblePlacementSparsePageSize, so it cannot be a sparse mapping
+    * target. Refusing the flags keeps that a clean "no" rather than a runtime
+    * failure inside vkQueueBindSparse.
     */
    if (pExternalBufferInfo->flags)
       goto unsupported;
@@ -151,6 +181,11 @@ unsupported:
 static VkResult
 kk_bind_buffer_memory(struct kk_device *dev, const VkBindBufferMemoryInfo *info)
 {
+   /* A sparse buffer already owns its Metal object and takes memory only through
+    * vkQueueBindSparse; vkBindBufferMemory on one is invalid usage. */
+   if (kk_buffer_is_sparse(kk_buffer_from_handle(info->buffer)))
+      return VK_SUCCESS;
+
    // Do the actual memory binding
    VK_FROM_HANDLE(kk_device_memory, mem, info->memory);
    VK_FROM_HANDLE(kk_buffer, buffer, info->buffer);
