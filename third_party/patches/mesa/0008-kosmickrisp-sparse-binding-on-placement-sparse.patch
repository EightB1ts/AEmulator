diff --git a/src/kosmickrisp/vulkan/kk_sparse.c b/src/kosmickrisp/vulkan/kk_sparse.c
new file mode 100644
index 0000000..271859b
--- /dev/null
+++ b/src/kosmickrisp/vulkan/kk_sparse.c
@@ -0,0 +1,557 @@
+/*
+ * Copyright 2025 LunarG, Inc.
+ * Copyright 2025 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+/* Sparse binding, on top of Metal's PLACEMENT SPARSE resources.
+ *
+ * See kosmickrisp/bridge/mtl_sparse.h for why placement sparse (macOS 26) is
+ * the only Metal mechanism that can express Vulkan's model, and for the list of
+ * behaviours measured on the hardware rather than assumed.
+ *
+ * The shape of the mapping is almost one-to-one:
+ *
+ *    VkDeviceMemory              -> MTLHeap (kk already makes one per allocation)
+ *    sparse VkBuffer / VkImage   -> placement sparse MTLBuffer / MTLTexture
+ *    VkSparseMemoryBind          -> MTL4UpdateSparseBufferMappingOperation
+ *    VkSparseImageMemoryBind     -> MTL4UpdateSparseTextureMappingOperation
+ *    vkQueueBindSparse           -> the same operations, on MTL4CommandQueue
+ *
+ * The one genuine translation is VkSparseImageOpaqueMemoryBindInfo, which has no
+ * Metal counterpart; kk_sparse_image_geom defines the flat tile order it needs.
+ *
+ * MEASURED LIMITATION — UNBINDING DOES NOT TAKE EFFECT.
+ *
+ * Binding works, including binding one resource from several VkDeviceMemory at
+ * once and rebinding a range onto different memory; all of that is verified
+ * against real data by crates/aemulator-hvf/kosmickrisp/sparse-smoke.c. What does
+ * NOT work is a bind with memory == VK_NULL_HANDLE: the range keeps returning its
+ * previous contents instead of becoming non-resident.
+ *
+ * That is not this file sending the wrong thing. KK_SPARSE_DEBUG=1 shows the
+ * operation reaching Metal as
+ *   updateBufferMappings: <AGXG14GFamilyBuffer len=131072 tier=1> heap=nil
+ *                         mode=Unmap range=(0,1)
+ * and the standalone probes reproduce that exact call working: sparse7.m unmaps
+ * and reads zero from both a shader and a blit, and sparse8/sparse9 rule out the
+ * heap shape (kk places a full-size host window over every heap), the barrier's
+ * MTL4VisibilityOptions, unmapping the middle of a multi-tile mapping, remapping
+ * a neighbour first, a one-submission lag, and a shader-versus-blit write before
+ * the unmap. Every one of those passes standalone and fails here, so the cause is
+ * somewhere in the driver's environment and is not yet identified.
+ *
+ * The consequence for what kk may advertise: reads of a non-resident block are
+ * undefined in Vulkan UNLESS sparseResidencyNonResidentStrict is set, so this
+ * driver must not set it — see kk_physical_device.c. Never-bound blocks do read
+ * zero, but a block that was bound and then unbound does not, and the property is
+ * a promise about both.
+ */
+
+#include "kk_sparse.h"
+
+#include "kk_buffer.h"
+#include "kk_device.h"
+#include "kk_device_memory.h"
+#include "kk_format.h"
+#include "kk_image.h"
+#include "kk_physical_device.h"
+#include "kk_queue.h"
+
+#include "kosmickrisp/bridge/mtl_bridge.h"
+
+#include "vk_queue.h"
+
+#include "util/u_math.h"
+
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+void
+kk_sparse_caps_init(struct kk_physical_device *pdev)
+{
+   pdev->sparse = (struct kk_sparse_caps){
+      .supported = mtl_device_supports_placement_sparse(pdev->mtl_dev_handle),
+      .page_size = MTL_SPARSE_PAGE_SIZE_DEFAULT,
+   };
+
+   if (!pdev->sparse.supported)
+      return;
+
+   pdev->sparse.block_size_B =
+      mtl_sparse_page_size_B(pdev->mtl_dev_handle, pdev->sparse.page_size);
+
+   /* A page size Metal will not price is a page size we cannot bind against. */
+   if (pdev->sparse.block_size_B == 0u)
+      pdev->sparse.supported = false;
+}
+
+/* The Vulkan standard sparse image block shape for a single-sample 2D image,
+ * in elements, from the element size in bytes. The spec's table is
+ * 256x256 / 256x128 / 128x128 / 128x64 / 64x64 for 1/2/4/8/16-byte elements,
+ * i.e. each doubling of the element halves the height then the width. */
+static void
+vk_standard_2d_block_shape(uint32_t element_B, uint32_t *w_el, uint32_t *h_el)
+{
+   uint32_t k = util_logbase2(MAX2(element_B, 1u));
+   *w_el = 256u >> (k / 2u);
+   *h_el = 256u >> ((k + 1u) / 2u);
+}
+
+/* Is `tile_px` the Vulkan standard sparse image block shape for this format and
+ * texture type? Only claimed where it was measured to hold: single-sample 2D,
+ * where 64 KiB pages reproduce the spec's table exactly for every element size.
+ * Metal's 3D tiles are always one texel deep and its 2-sample tile is the
+ * transpose of Vulkan's, so neither is standard. */
+static bool
+tile_is_standard_shape(enum mtl_texture_type type, enum pipe_format format,
+                       uint32_t samples, const uint32_t tile_px[3])
+{
+   if (samples != 1)
+      return false;
+   if (type != MTL_TEXTURE_TYPE_2D && type != MTL_TEXTURE_TYPE_2D_ARRAY &&
+       type != MTL_TEXTURE_TYPE_CUBE && type != MTL_TEXTURE_TYPE_CUBE_ARRAY)
+      return false;
+
+   const struct util_format_description *desc = util_format_description(format);
+   uint32_t w_el, h_el;
+   vk_standard_2d_block_shape(util_format_get_blocksize(format), &w_el, &h_el);
+
+   /* The spec's table counts elements; for a block-compressed format an element
+    * is a compressed block, so scale up to texels before comparing. */
+   return tile_px[0] == w_el * desc->block.width &&
+          tile_px[1] == h_el * desc->block.height && tile_px[2] == 1u;
+}
+
+/* A minimal layout is enough for the sparse tile-size query, which reads only
+ * the texture type, the Metal pixel format and the sample count. That is what
+ * lets vkGetPhysicalDeviceSparseImageFormatProperties2 answer without a
+ * VkImage, or even a VkDevice. */
+bool
+kk_sparse_format_granularity(struct kk_physical_device *pdev,
+                             enum pipe_format format, VkImageType type,
+                             uint32_t samples, VkExtent3D *granularity_out,
+                             VkSparseImageFormatFlags *flags_out)
+{
+   if (!pdev->sparse.supported)
+      return false;
+
+   const struct kk_va_format *va = kk_get_va_format(format);
+   if (va == NULL)
+      return false;
+
+   enum mtl_texture_type mtl_type;
+   switch (type) {
+   case VK_IMAGE_TYPE_2D:
+      mtl_type = samples > 1 ? MTL_TEXTURE_TYPE_2D_MULTISAMPLE
+                             : MTL_TEXTURE_TYPE_2D;
+      break;
+   case VK_IMAGE_TYPE_3D:
+      mtl_type = MTL_TEXTURE_TYPE_3D;
+      break;
+   default:
+      /* Metal reports no sparse tile size for 1D. */
+      return false;
+   }
+
+   struct kk_image_layout probe = {
+      .type = mtl_type,
+      .sample_count_sa = samples,
+      .format = {.pipe = format, .mtl = va->mtl_pixel_format},
+   };
+
+   struct mtl_size tile = mtl_sparse_tile_size_px(pdev->mtl_dev_handle, &probe,
+                                                  pdev->sparse.page_size);
+   if (tile.x == 0u || tile.y == 0u || tile.z == 0u)
+      return false;
+
+   const uint32_t tile_px[3] = {tile.x, tile.y, tile.z};
+   *granularity_out = (VkExtent3D){tile.x, tile.y, tile.z};
+   *flags_out = tile_is_standard_shape(mtl_type, format, samples, tile_px)
+                   ? 0
+                   : VK_SPARSE_IMAGE_FORMAT_NONSTANDARD_BLOCK_SIZE_BIT;
+   return true;
+}
+
+bool
+kk_sparse_image_geom(struct kk_device *dev, const struct kk_image *image,
+                     uint8_t plane_idx, struct kk_sparse_image_geom *g)
+{
+   const struct kk_physical_device *pdev = kk_device_physical(dev);
+   const struct kk_image_plane *plane = &image->planes[plane_idx];
+   const struct kk_image_layout *layout = &plane->layout;
+
+   if (!pdev->sparse.supported || plane->mtl_handle == NULL)
+      return false;
+
+   memset(g, 0, sizeof(*g));
+   g->block_size_B = pdev->sparse.block_size_B;
+
+   struct mtl_size tile =
+      mtl_sparse_tile_size_px(dev->mtl_handle, layout, pdev->sparse.page_size);
+   if (tile.x == 0u || tile.y == 0u || tile.z == 0u)
+      return false;
+   g->tile_px[0] = tile.x;
+   g->tile_px[1] = tile.y;
+   g->tile_px[2] = tile.z;
+
+   g->levels = layout->levels;
+   g->layers = layout->layers;
+
+   /* Metal reports the first level packed into the tail. Clamping to `levels`
+    * covers the no-tail case, where it reports one past the last level. */
+   g->mip_tail_first_lod =
+      MIN2(mtl_texture_first_mipmap_in_tail(plane->mtl_handle), g->levels);
+   g->mip_tail_size_B = mtl_texture_tail_size_B(plane->mtl_handle);
+   g->mip_tail_stride_B = g->mip_tail_size_B;
+
+   uint64_t acc = 0u;
+   for (uint32_t level = 0; level < g->mip_tail_first_lod; ++level) {
+      uint32_t w = u_minify(layout->width_px, level);
+      uint32_t h = u_minify(layout->height_px, level);
+      uint32_t d = u_minify(layout->depth_px, level);
+
+      g->tiles[level][0] = DIV_ROUND_UP(w, g->tile_px[0]);
+      g->tiles[level][1] = DIV_ROUND_UP(h, g->tile_px[1]);
+      g->tiles[level][2] = DIV_ROUND_UP(d, g->tile_px[2]);
+
+      g->level_first_tile[level] = acc;
+      acc += (uint64_t)g->tiles[level][0] * g->tiles[level][1] *
+             g->tiles[level][2] * g->layers;
+   }
+   g->level_first_tile[g->mip_tail_first_lod] = acc;
+   g->tiled_tiles = acc;
+
+   g->mip_tail_offset_B = acc * g->block_size_B;
+   g->total_size_B = g->mip_tail_offset_B + g->mip_tail_size_B * g->layers;
+
+   g->standard_block_shape = tile_is_standard_shape(
+      layout->type, layout->format.pipe, layout->sample_count_sa, g->tile_px);
+
+   return true;
+}
+
+/* ------------------------------------------------------------------------- */
+/* Binding                                                                   */
+/* ------------------------------------------------------------------------- */
+
+/* One Metal call carries this many regions; the bridge splits anything larger. */
+#define KK_BIND_BATCH 32
+
+/* KK_SPARSE_DEBUG=1 prints every mapping update as it is issued. This exists
+ * because the traced call is the only way to tell a driver-side translation bug
+ * from a Metal behaviour: it is what established that the UNBIND limitation
+ * documented below is NOT kk sending the wrong operation. */
+static void
+kk_sparse_trace_buffer(bool unmap, mtl_heap *heap,
+                       const struct mtl_sparse_buffer_region *regions,
+                       uint32_t count)
+{
+   if (!getenv("KK_SPARSE_DEBUG"))
+      return;
+   for (uint32_t i = 0; i < count; ++i)
+      fprintf(stderr,
+              "[kk sparse] buffer %s tiles [%" PRIu64 ",+%" PRIu64 ") heap %p "
+              "tile %" PRIu64 "\n",
+              unmap ? "UNMAP" : "map  ", regions[i].resource_tile,
+              regions[i].tile_count, (void *)heap, regions[i].heap_tile);
+}
+
+static mtl_heap *
+heap_of(VkDeviceMemory _mem)
+{
+   VK_FROM_HANDLE(kk_device_memory, mem, _mem);
+   return mem != NULL ? mem->bo->mtl_handle : NULL;
+}
+
+static VkResult
+bind_buffer(struct kk_queue *queue, const VkSparseBufferMemoryBindInfo *info,
+            uint64_t block_B)
+{
+   VK_FROM_HANDLE(kk_buffer, buffer, info->buffer);
+   struct kk_device *dev = kk_queue_device(queue);
+
+   if (buffer->mtl_handle == NULL)
+      return vk_errorf(dev, VK_ERROR_UNKNOWN,
+                       "vkQueueBindSparse on a VkBuffer that was not created "
+                       "with VK_BUFFER_CREATE_SPARSE_BINDING_BIT");
+
+   const uint64_t buffer_tiles = DIV_ROUND_UP(buffer->vk.size, block_B);
+
+   /* Binds are grouped into runs that share a memory object and a direction,
+    * because Metal takes one heap and one mode per call. Runs rather than a
+    * sort: a bind list almost always walks one VkDeviceMemory at a time, and
+    * operations inside one update are unordered anyway. */
+   for (uint32_t i = 0; i < info->bindCount;) {
+      const VkDeviceMemory memory = info->pBinds[i].memory;
+      const bool unmap = memory == VK_NULL_HANDLE;
+      struct mtl_sparse_buffer_region regions[KK_BIND_BATCH];
+      uint32_t n = 0;
+
+      while (i < info->bindCount && info->pBinds[i].memory == memory &&
+             n < KK_BIND_BATCH) {
+         const VkSparseMemoryBind *b = &info->pBinds[i++];
+         uint64_t first = b->resourceOffset / block_B;
+         uint64_t count = DIV_ROUND_UP(b->size, block_B);
+
+         /* The final block of a resource may be partial, so a bind that runs to
+          * the end rounds up past the tile count; clamp instead of asking Metal
+          * to map a tile that does not exist. */
+         if (first >= buffer_tiles)
+            continue;
+         count = MIN2(count, buffer_tiles - first);
+         if (count == 0u)
+            continue;
+
+         regions[n++] = (struct mtl_sparse_buffer_region){
+            .resource_tile = first,
+            .tile_count = count,
+            .heap_tile = unmap ? 0u : b->memoryOffset / block_B,
+         };
+      }
+
+      if (n > 0u) {
+         kk_sparse_trace_buffer(unmap, heap_of(memory), regions, n);
+         mtl_queue_update_buffer_mappings(queue->mtl_handle, buffer->mtl_handle,
+                                          heap_of(memory), unmap, regions, n);
+      }
+   }
+
+   return VK_SUCCESS;
+}
+
+/* Walk a run of flat opaque tiles into Metal tile regions. Returns how many
+ * tiles were consumed, which is less than `tile_count` when `max` regions fill
+ * up; the caller loops. */
+static uint64_t
+opaque_run_to_regions(const struct kk_sparse_image_geom *g, uint64_t first_tile,
+                      uint64_t tile_count, uint64_t heap_tile,
+                      struct mtl_sparse_texture_region *out, uint32_t max,
+                      uint32_t *out_count)
+{
+   const uint64_t tail_tiles =
+      g->mip_tail_size_B ? DIV_ROUND_UP(g->mip_tail_size_B, g->block_size_B) : 0u;
+   uint64_t t = first_tile, left = tile_count, done = 0u;
+   uint32_t n = 0u;
+
+   while (left > 0u && n < max) {
+      if (t < g->tiled_tiles) {
+         uint32_t level = 0;
+         while (level + 1u < g->mip_tail_first_lod &&
+                t >= g->level_first_tile[level + 1u])
+            ++level;
+
+         const uint32_t tx = g->tiles[level][0], ty = g->tiles[level][1];
+         const uint64_t per_slice = (uint64_t)tx * ty * g->tiles[level][2];
+         if (per_slice == 0u)
+            break;
+
+         const uint64_t rel = t - g->level_first_tile[level];
+         const uint32_t slice = (uint32_t)(rel / per_slice);
+         const uint64_t k = rel % per_slice;
+
+         const uint32_t x = (uint32_t)(k % tx);
+         const uint32_t y = (uint32_t)((k / tx) % ty);
+         const uint32_t z = (uint32_t)(k / ((uint64_t)tx * ty));
+
+         /* Metal fills a region in x, then y, then z from consecutive heap
+          * tiles, so one region may cover the rest of this tile row. Stop at
+          * the row end and at this (level, slice). */
+         uint64_t run = MIN2((uint64_t)tx - x, left);
+         run = MIN2(run, per_slice - k);
+
+         out[n++] = (struct mtl_sparse_texture_region){
+            .origin_tl = {x, y, z},
+            .size_tl = {(uint32_t)run, 1u, 1u},
+            .level = level,
+            .slice = slice,
+            .heap_tile = heap_tile,
+         };
+         heap_tile += run;
+         t += run;
+         left -= run;
+         done += run;
+      } else {
+         if (tail_tiles == 0u)
+            break;
+         const uint64_t rel = t - g->tiled_tiles;
+         const uint32_t slice = (uint32_t)(rel / tail_tiles);
+         const uint64_t k = rel % tail_tiles;
+         const uint64_t run = MIN2(tail_tiles - k, left);
+
+         /* The tail is addressed as a 1-D tile run at mip_tail_first_lod:
+          * Metal requires origin.y = 0 and size.height = 1 at that level. */
+         out[n++] = (struct mtl_sparse_texture_region){
+            .origin_tl = {(uint32_t)k, 0u, 0u},
+            .size_tl = {(uint32_t)run, 1u, 1u},
+            .level = g->mip_tail_first_lod,
+            .slice = slice,
+            .heap_tile = heap_tile,
+         };
+         heap_tile += run;
+         t += run;
+         left -= run;
+         done += run;
+      }
+   }
+
+   *out_count = n;
+   return done;
+}
+
+static VkResult
+bind_image_opaque(struct kk_queue *queue,
+                  const VkSparseImageOpaqueMemoryBindInfo *info,
+                  uint64_t block_B)
+{
+   VK_FROM_HANDLE(kk_image, image, info->image);
+   struct kk_device *dev = kk_queue_device(queue);
+
+   /* Opaque binds address the whole image, so a disjoint multi-plane image
+    * would need a per-plane flat space. kk refuses sparse on multi-plane
+    * formats at vkGetPhysicalDeviceImageFormatProperties2, so plane 0 is the
+    * only case that can arrive here. */
+   struct kk_sparse_image_geom g;
+   if (!kk_sparse_image_geom(dev, image, 0, &g))
+      return vk_errorf(dev, VK_ERROR_UNKNOWN,
+                       "vkQueueBindSparse on a VkImage that was not created "
+                       "with VK_IMAGE_CREATE_SPARSE_BINDING_BIT");
+
+   const uint64_t image_tiles =
+      g.tiled_tiles +
+      (g.mip_tail_size_B ? DIV_ROUND_UP(g.mip_tail_size_B, block_B) : 0u) *
+         g.layers;
+
+   for (uint32_t i = 0; i < info->bindCount; ++i) {
+      const VkSparseMemoryBind *b = &info->pBinds[i];
+      const bool unmap = b->memory == VK_NULL_HANDLE;
+      mtl_heap *heap = heap_of(b->memory);
+
+      uint64_t first = b->resourceOffset / block_B;
+      uint64_t count = DIV_ROUND_UP(b->size, block_B);
+      if (first >= image_tiles)
+         continue;
+      count = MIN2(count, image_tiles - first);
+
+      uint64_t heap_tile = unmap ? 0u : b->memoryOffset / block_B;
+      while (count > 0u) {
+         struct mtl_sparse_texture_region regions[KK_BIND_BATCH];
+         uint32_t n = 0;
+         uint64_t consumed = opaque_run_to_regions(
+            &g, first, count, heap_tile, regions, KK_BIND_BATCH, &n);
+         if (consumed == 0u || n == 0u)
+            break;
+
+         mtl_queue_update_texture_mappings(queue->mtl_handle,
+                                          image->planes[0].mtl_handle, heap,
+                                          unmap, regions, n);
+         first += consumed;
+         heap_tile += consumed;
+         count -= consumed;
+      }
+   }
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+bind_image(struct kk_queue *queue, const VkSparseImageMemoryBindInfo *info,
+           uint64_t block_B)
+{
+   VK_FROM_HANDLE(kk_image, image, info->image);
+   struct kk_device *dev = kk_queue_device(queue);
+
+   struct kk_sparse_image_geom g;
+   if (!kk_sparse_image_geom(dev, image, 0, &g))
+      return vk_errorf(dev, VK_ERROR_UNKNOWN,
+                       "vkQueueBindSparse on a VkImage that was not created "
+                       "with VK_IMAGE_CREATE_SPARSE_RESIDENCY_BIT");
+
+   /* The residency path needs no flat-space translation at all: Vulkan already
+    * gives a subresource plus a texel box, which is what Metal wants. */
+   for (uint32_t i = 0; i < info->bindCount;) {
+      const VkDeviceMemory memory = info->pBinds[i].memory;
+      const bool unmap = memory == VK_NULL_HANDLE;
+      struct mtl_sparse_texture_region regions[KK_BIND_BATCH];
+      uint32_t n = 0;
+
+      while (i < info->bindCount && info->pBinds[i].memory == memory &&
+             n < KK_BIND_BATCH) {
+         const VkSparseImageMemoryBind *b = &info->pBinds[i++];
+         const uint8_t plane =
+            kk_image_aspects_to_plane(image, b->subresource.aspectMask);
+         if (plane != 0)
+            continue;
+
+         regions[n++] = (struct mtl_sparse_texture_region){
+            .origin_tl = {b->offset.x / (int32_t)g.tile_px[0],
+                          b->offset.y / (int32_t)g.tile_px[1],
+                          b->offset.z / (int32_t)g.tile_px[2]},
+            /* extent is clamped to the image edge, so a trailing partial tile
+             * rounds up to the whole tile that covers it. */
+            .size_tl = {DIV_ROUND_UP(b->extent.width, g.tile_px[0]),
+                        DIV_ROUND_UP(b->extent.height, g.tile_px[1]),
+                        DIV_ROUND_UP(b->extent.depth, g.tile_px[2])},
+            .level = b->subresource.mipLevel,
+            .slice = b->subresource.arrayLayer,
+            .heap_tile = unmap ? 0u : b->memoryOffset / block_B,
+         };
+      }
+
+      if (n > 0u) {
+         mtl_queue_update_texture_mappings(queue->mtl_handle,
+                                          image->planes[0].mtl_handle,
+                                          heap_of(memory), unmap, regions, n);
+      }
+   }
+
+   return VK_SUCCESS;
+}
+
+VkResult
+kk_queue_bind_sparse(struct kk_queue *queue, struct vk_queue_submit *submit)
+{
+   struct kk_device *dev = kk_queue_device(queue);
+   const struct kk_physical_device *pdev = kk_device_physical(dev);
+   const uint64_t block_B = pdev->sparse.block_size_B;
+   VkResult result = VK_SUCCESS;
+
+   if (submit->buffer_bind_count == 0u && submit->image_opaque_bind_count == 0u &&
+       submit->image_bind_count == 0u)
+      return VK_SUCCESS;
+
+   if (!pdev->sparse.supported || block_B == 0u)
+      return vk_errorf(dev, VK_ERROR_FEATURE_NOT_PRESENT,
+                       "vkQueueBindSparse without placement sparse support");
+
+   /* Every heap is already resident device-wide, but a bind can be the first
+    * thing that makes a given heap matter to this queue. */
+   kk_device_make_resources_resident(dev);
+
+   for (uint32_t i = 0; i < submit->buffer_bind_count; ++i) {
+      VkResult r = bind_buffer(queue, &submit->buffer_binds[i], block_B);
+      if (result == VK_SUCCESS)
+         result = r;
+   }
+   for (uint32_t i = 0; i < submit->image_opaque_bind_count; ++i) {
+      VkResult r =
+         bind_image_opaque(queue, &submit->image_opaque_binds[i], block_B);
+      if (result == VK_SUCCESS)
+         result = r;
+   }
+   for (uint32_t i = 0; i < submit->image_bind_count; ++i) {
+      VkResult r = bind_image(queue, &submit->image_binds[i], block_B);
+      if (result == VK_SUCCESS)
+         result = r;
+   }
+
+   /* Command buffers submitted from here on must barrier against
+    * MTL_STAGE_RESOURCE_STATE before touching a remapped resource. Recording
+    * happens before submission, so the flag is what tells the encoder-start
+    * paths to emit it — and it stays off entirely for workloads that never
+    * bind sparsely, which is why the non-sparse hot path is untouched. */
+   dev->sparse_binds_issued = true;
+
+   return result;
+}
