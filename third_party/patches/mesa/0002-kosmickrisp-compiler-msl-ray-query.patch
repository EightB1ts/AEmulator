diff --git a/src/kosmickrisp/compiler/nir_to_msl.c b/src/kosmickrisp/compiler/nir_to_msl.c
index e6f88f1..aebf7a5 100644
--- a/src/kosmickrisp/compiler/nir_to_msl.c
+++ b/src/kosmickrisp/compiler/nir_to_msl.c
@@ -1076,6 +1076,348 @@ global_access_qualifier(struct nir_to_msl_ctx *ctx,
    return access & ACCESS_COHERENT ? "coherent device" : "device";
 }
 
+/*
+ * VK_KHR_ray_query -> metal::raytracing::intersection_query
+ * =========================================================
+ *
+ * Metal exposes ray queries as an inline object with a small method surface,
+ * so the NIR rq_* intrinsics map one-to-one onto method calls. The mapping
+ * below follows SPIRV-Cross PR #2649 (SPIR-V -> MSL), which is CTS validated.
+ *
+ * Two things Metal does not give us and we have to shadow ourselves:
+ *
+ *  - The original ray flags. Vulkan's OpRayQueryGetRayFlagsKHR can read them
+ *    back; Metal folds them into an intersection_params object that is not
+ *    queryable. We keep a companion `uint` per ray query, written at reset().
+ *
+ *  - The instance SBT record offset and the triangle vertex positions. Both
+ *    need per-instance / per-primitive side data that the acceleration
+ *    structure builder has to author; see the TODOs below.
+ */
+
+/* Emit a reference to the ray query object named by a deref chain, with an
+ * optional suffix appended to the base name (used for the shadow flags). */
+static void
+ray_query_ref(struct nir_to_msl_ctx *ctx, nir_def *def, const char *suffix)
+{
+   nir_deref_instr *deref = nir_instr_as_deref(nir_def_instr(def));
+
+   switch (deref->deref_type) {
+   case nir_deref_type_var: {
+      struct hash_entry *entry =
+         _mesa_hash_table_search(ctx->ray_query_ids, deref->var);
+      assert(entry && "ray query variable was never declared");
+      P(ctx, "rq%u%s", (unsigned)((uintptr_t)entry->data - 1u), suffix);
+      break;
+   }
+   case nir_deref_type_array:
+      ray_query_ref(ctx, deref->parent.ssa, suffix);
+      P(ctx, "[");
+      src_to_msl(ctx, &deref->arr.index);
+      P(ctx, "]");
+      break;
+   default:
+      UNREACHABLE("Unsupported ray query deref");
+   }
+}
+
+static void
+rq_initialize_to_msl(struct nir_to_msl_ctx *ctx, nir_intrinsic_instr *instr)
+{
+   /* Shadow the ray flags: Metal cannot read them back out of the query. */
+   P_INDENT(ctx);
+   ray_query_ref(ctx, instr->src[0].ssa, "_flags");
+   P(ctx, " = ");
+   src_to_msl(ctx, &instr->src[2]);
+   P(ctx, ";\n");
+
+   P_INDENT(ctx);
+   ray_query_ref(ctx, instr->src[0].ssa, "");
+   /* MSL argument order is (ray, structure, mask, params) and the ray is
+    * (origin, direction, min_distance, max_distance), so tmin/direction swap
+    * relative to NIR. */
+   P(ctx, ".reset(raytracing::ray(");
+   src_to_msl(ctx, &instr->src[4]);
+   P(ctx, ", ");
+   src_to_msl(ctx, &instr->src[6]);
+   P(ctx, ", ");
+   src_to_msl(ctx, &instr->src[5]);
+   P(ctx, ", ");
+   src_to_msl(ctx, &instr->src[7]);
+   P(ctx, "), kk_acceleration_structure(");
+   src_to_msl(ctx, &instr->src[1]);
+   P(ctx, "), (");
+   src_to_msl(ctx, &instr->src[3]);
+   /* Vulkan's cull mask is the low 8 bits; Metal asserts on wider values. */
+   P(ctx, ") & 255u, kk_ray_intersection_params(");
+   src_to_msl(ctx, &instr->src[2]);
+   P(ctx, "));\n");
+}
+
+/* "<query><method>", for the handful of accessors that do not care which hit
+ * is being asked about. */
+static void
+rq_method(struct nir_to_msl_ctx *ctx, nir_def *q, const char *method)
+{
+   ray_query_ref(ctx, q, "");
+   P(ctx, "%s", method);
+}
+
+/* "<query>.<verb>_{candidate,committed}_<noun>()". Metal spells the candidate
+ * and the committed hit as two disjoint method families rather than taking a
+ * flag, exactly as SPIRV-Cross's MSL_RAY_QUERY_OP_INNER2 does. */
+static void
+rq_hit_method(struct nir_to_msl_ctx *ctx, nir_def *q, const char *verb,
+              bool committed, const char *noun)
+{
+   ray_query_ref(ctx, q, "");
+   P(ctx, ".%s_%s_%s()", verb, committed ? "committed" : "candidate", noun);
+}
+
+static void
+rq_load_to_msl(struct nir_to_msl_ctx *ctx, nir_intrinsic_instr *instr)
+{
+   const bool committed = nir_intrinsic_committed(instr);
+   nir_def *q = instr->src[0].ssa;
+
+   switch (nir_intrinsic_ray_query_value(instr)) {
+   case nir_ray_query_value_intersection_type:
+      /* Metal: none = 0, triangle = 1, bounding_box = 2.
+       * Vulkan committed: none = 0, triangle = 1, generated = 2. Identical.
+       * Vulkan candidate: triangle = 0, aabb = 1. Metal value minus one. */
+      P(ctx, "uint(");
+      rq_hit_method(ctx, q, "get", committed, "intersection_type");
+      P(ctx, ")");
+      if (!committed)
+         P(ctx, " - 1u");
+      break;
+   case nir_ray_query_value_intersection_t:
+      /* The one accessor whose two halves are not spelled symmetrically. */
+      rq_method(ctx, q, committed ? ".get_committed_distance()"
+                                  : ".get_candidate_triangle_distance()");
+      break;
+   case nir_ray_query_value_intersection_instance_custom_index:
+      rq_hit_method(ctx, q, "get", committed, "user_instance_id");
+      break;
+   case nir_ray_query_value_intersection_instance_id:
+      rq_hit_method(ctx, q, "get", committed, "instance_id");
+      break;
+   case nir_ray_query_value_intersection_geometry_index:
+      rq_hit_method(ctx, q, "get", committed, "geometry_id");
+      break;
+   case nir_ray_query_value_intersection_primitive_index:
+      rq_hit_method(ctx, q, "get", committed, "primitive_id");
+      break;
+   case nir_ray_query_value_intersection_barycentrics:
+      rq_hit_method(ctx, q, "get", committed, "triangle_barycentric_coord");
+      break;
+   case nir_ray_query_value_intersection_front_face:
+      rq_hit_method(ctx, q, "is", committed, "triangle_front_facing");
+      break;
+   case nir_ray_query_value_intersection_object_ray_origin:
+      rq_hit_method(ctx, q, "get", committed, "ray_origin");
+      break;
+   case nir_ray_query_value_intersection_object_ray_direction:
+      rq_hit_method(ctx, q, "get", committed, "ray_direction");
+      break;
+   case nir_ray_query_value_intersection_object_to_world:
+      /* Both sides agree on 4 columns of 3 rows (NIR mat4x3 / MSL float4x3),
+       * so the NIR column index is the MSL column index. */
+      rq_hit_method(ctx, q, "get", committed, "object_to_world_transform");
+      P(ctx, "[%u]", nir_intrinsic_column(instr));
+      break;
+   case nir_ray_query_value_intersection_world_to_object:
+      rq_hit_method(ctx, q, "get", committed, "world_to_object_transform");
+      P(ctx, "[%u]", nir_intrinsic_column(instr));
+      break;
+   case nir_ray_query_value_intersection_candidate_aabb_opaque:
+      /* Metal answers the opposite question. */
+      P(ctx, "!");
+      rq_method(ctx, q, ".is_candidate_non_opaque_bounding_box()");
+      break;
+   case nir_ray_query_value_tmin:
+      rq_method(ctx, q, ".get_ray_min_distance()");
+      break;
+   case nir_ray_query_value_world_ray_origin:
+      rq_method(ctx, q, ".get_world_space_ray_origin()");
+      break;
+   case nir_ray_query_value_world_ray_direction:
+      rq_method(ctx, q, ".get_world_space_ray_direction()");
+      break;
+   case nir_ray_query_value_flags:
+      /* Not queryable in Metal, read back the shadow copy. */
+      ray_query_ref(ctx, q, "_flags");
+      break;
+   case nir_ray_query_value_intersection_instance_sbt_index:
+      /* TODO_KOSMICKRISP Requires a per-instance side table authored by the
+       * acceleration structure builder (MoltenVK PR #2771 / SPIRV-Cross PR
+       * #2649 both keep one). Not wired up yet. */
+      P(ctx, "0u /* TODO instance SBT offset */");
+      break;
+   case nir_ray_query_value_intersection_triangle_vertex_positions:
+      /* TODO_KOSMICKRISP VK_KHR_ray_tracing_position_fetch needs per-primitive
+       * data stored in the acceleration structure; MSL cannot recover the
+       * original triangle positions. Not advertised, so unreachable in
+       * practice. */
+      P(ctx, "float3(0.0) /* TODO position fetch */");
+      break;
+   default:
+      UNREACHABLE("Unknown ray query value");
+   }
+
+   P(ctx, ";\n");
+}
+
+static void
+ray_query_to_msl(struct nir_to_msl_ctx *ctx, nir_intrinsic_instr *instr)
+{
+   switch (instr->intrinsic) {
+   case nir_intrinsic_rq_initialize:
+      rq_initialize_to_msl(ctx, instr);
+      break;
+   case nir_intrinsic_rq_proceed:
+      /* Dest assignment ("tN = ") has already been emitted. */
+      ray_query_ref(ctx, instr->src[0].ssa, "");
+      P(ctx, ".next();\n");
+      break;
+   case nir_intrinsic_rq_terminate:
+      P_INDENT(ctx);
+      ray_query_ref(ctx, instr->src[0].ssa, "");
+      P(ctx, ".abort();\n");
+      break;
+   case nir_intrinsic_rq_confirm_intersection:
+      P_INDENT(ctx);
+      ray_query_ref(ctx, instr->src[0].ssa, "");
+      P(ctx, ".commit_triangle_intersection();\n");
+      break;
+   case nir_intrinsic_rq_generate_intersection:
+      P_INDENT(ctx);
+      ray_query_ref(ctx, instr->src[0].ssa, "");
+      P(ctx, ".commit_bounding_box_intersection(");
+      src_to_msl(ctx, &instr->src[1]);
+      P(ctx, ");\n");
+      break;
+   case nir_intrinsic_rq_load:
+      rq_load_to_msl(ctx, instr);
+      break;
+   default:
+      UNREACHABLE("Unknown ray query intrinsic");
+   }
+}
+
+/* Declare one ray query variable (plus its shadow flags) and record its id.
+ * Emission order follows NIR's variable order, so the generated MSL stays
+ * byte-for-byte reproducible. */
+static void
+declare_ray_query_var(struct nir_to_msl_ctx *ctx, nir_variable *var,
+                      unsigned *id)
+{
+   if (!var->data.ray_query)
+      return;
+   /* A variable can only be declared once, no matter which list we found it
+    * in. */
+   if (_mesa_hash_table_search(ctx->ray_query_ids, var))
+      return;
+
+   unsigned n = (*id)++;
+   _mesa_hash_table_insert(ctx->ray_query_ids, var,
+                           (void *)(uintptr_t)(n + 1u));
+
+   /* Ray queries are opaque in NIR; the only composite SPIR-V can build out of
+    * them is a (possibly nested) array. */
+   char dims[64] = {0};
+   unsigned pos = 0;
+   for (const struct glsl_type *type = var->type; glsl_type_is_array(type);
+        type = glsl_get_array_element(type)) {
+      int written =
+         snprintf(dims + pos, sizeof(dims) - pos, "[%u]", glsl_get_length(type));
+      if (written < 0 || (unsigned)written >= sizeof(dims) - pos) {
+         assert(!"ray query array nesting too deep");
+         break;
+      }
+      pos += written;
+   }
+
+   P_IND(ctx, MSL_RAY_QUERY_TYPE " rq%u%s;\n", n, dims);
+   /* Metal folds the ray flags into intersection_params and never gives them
+    * back, so shadow them for OpRayQueryGetRayFlagsKHR. */
+   P_IND(ctx, "uint rq%u_flags%s = {};\n", n, dims);
+}
+
+/* Assign an id to every ray query variable and declare the MSL objects. Must
+ * run before the function body is emitted. */
+static void
+emit_ray_query_vars(struct nir_to_msl_ctx *ctx, nir_function_impl *impl)
+{
+   if (!ctx->uses_ray_query)
+      return;
+
+   unsigned id = 0;
+   nir_foreach_variable_with_modes(var, ctx->shader,
+                                   nir_var_shader_temp | nir_var_function_temp)
+      declare_ray_query_var(ctx, var, &id);
+   nir_foreach_function_temp_variable(var, impl)
+      declare_ray_query_var(ctx, var, &id);
+}
+
+/* The <metal_raytracing> include, emitted alongside the other includes. */
+static void
+emit_ray_query_include(struct nir_to_msl_ctx *ctx)
+{
+   if (ctx->uses_ray_query)
+      P(ctx, "#include <metal_raytracing>\n");
+}
+
+/* File-scope helpers the ray query lowering leans on. Emitted after
+ * "using namespace metal;" so the raytracing:: prefix resolves. */
+static void
+emit_ray_query_prelude(struct nir_to_msl_ctx *ctx)
+{
+   if (!ctx->uses_ray_query)
+      return;
+
+   P(ctx, "\n");
+   /* Vulkan hands the acceleration structure to the shader as a 64-bit
+    * handle. Metal acceleration structures live in the resource-id space, so
+    * the driver publishes the MTLResourceID and we reinterpret it here, the
+    * same way the rest of KosmicKrisp resolves bindless resources. */
+   P(ctx,
+     "static inline " MSL_ACCELERATION_STRUCTURE_TYPE "\n"
+     "kk_acceleration_structure(ulong handle)\n"
+     "{\n"
+     "    return *(const device " MSL_ACCELERATION_STRUCTURE_TYPE " *)handle;\n"
+     "}\n"
+     "\n");
+   /* VkRayFlagBits -> raytracing::intersection_params. Mirrors
+    * spvMakeIntersectionParams() from SPIRV-Cross PR #2649. */
+   P(ctx,
+     "static inline raytracing::intersection_params\n"
+     "kk_ray_intersection_params(uint flags)\n"
+     "{\n"
+     "    raytracing::intersection_params ip;\n"
+     "    if (flags & 0x1u)\n"
