+/* The single Metal intersection query flavour we emit. Metal requires the tag
+ * list to be spelled out at every use site (it is part of the type), so keep
+ * the string in one place.
+ *
+ * - raytracing::instancing   : Vulkan TLAS/BLAS is always a two level
+ *                              structure, so instancing is always on.
+ * - raytracing::triangle_data: required for
+ *                              get_*_triangle_barycentric_coord() and
+ *                              is_*_triangle_front_facing(), both of which
+ *                              ray_query shaders can ask for at any time.
+ */
+#define MSL_RAY_QUERY_TAGS "raytracing::instancing, raytracing::triangle_data"
+#define MSL_RAY_QUERY_TYPE "raytracing::intersection_query<" MSL_RAY_QUERY_TAGS ">"
+#define MSL_ACCELERATION_STRUCTURE_TYPE                                        \
+   "raytracing::acceleration_structure<raytracing::instancing>"
+
+/* True for a deref that names (part of) a ray query object. Ray query derefs
+ * survive into the backend: unlike every other deref they are not memory
+ * accesses, they name an opaque MSL object that we declare up front. */
+static inline bool
+msl_deref_is_ray_query(const nir_deref_instr *deref)
+{
+   const nir_variable *var = nir_deref_instr_get_variable(deref);
+   return var != NULL && var->data.ray_query;
+}
